extends layout

block content
  .container.py-5
    .row.justify-content-center
      .col-md-8.col-lg-7
        .card.border-0.shadow-sm.rounded-4
          .card-body.p-4.p-md-5
            h1.h3.fw-bold.mb-2 Registrar secretaria
            p.text-body-secondary.mb-4 TurnoFlex asigna automáticamente un identificador institucional de acceso y envía una invitación al correo particular.
            form(action='/accesos/secretarias' method='POST')
              .mb-3
                label.form-label(for='nombre') Nombre y apellido
                input#nombre.form-control(type='text' name='nombre' maxlength='120' placeholder='Ej.: Laura Gómez' required)
              .mb-3
                label.form-label(for='email') Correo particular para recibir la invitación
                input#email.form-control(type='email' name='email' maxlength='254' placeholder='laura@gmail.com' required)
              .alert.alert-info El usuario institucional no es un buzón de correo. Se utiliza únicamente para ingresar a TurnoFlex.
              button.btn.btn-primary(type='submit') Crear cuenta y enviar invitación
              a.btn.btn-outline-secondary.ms-2(href='/') Cancelar