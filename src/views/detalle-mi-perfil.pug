extends layout

block content

  //- ============================================================
  //- DATOS
  //- ============================================================

  - const paciente = (typeof cliente !== 'undefined' && cliente) ? cliente : {}
  - const cobertura = paciente.obraSocial ? paciente.obraSocial : {}
  - const familiares = Array.isArray(paciente.grupoFamiliar) ? paciente.grupoFamiliar : []
  - const nombrePaciente = paciente.nombre || 'Paciente'
  - const iniciales = nombrePaciente.split(' ').filter(function(parte) { return parte; }).slice(0, 2).map(function(parte) { return parte.charAt(0).toUpperCase(); }).join('') || 'PA'
  - const formatearFecha = function(valor) { if (!valor) return 'N/D'; const fecha = new Date(valor); return isNaN(fecha.getTime()) ? 'N/D' : fecha.toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric' }); }


  //- ============================================================
  //- ESTILOS
  //- ============================================================

  //- ============================================================
  //- CONTENIDO
  //- ============================================================

  .my-profile.tfu-page


    if mensajeExito

      .profile-success
        | ✓ #{mensajeExito}


    //- ==========================================================
    //- HERO
    //- ==========================================================

    .profile-hero.tfu-hero

      .profile-hero-content

        .row.align-items-center.g-4


          .col-lg-8

            .d-flex.align-items-center.gap-3

              .profile-avatar
                = iniciales

              div

                .profile-eyebrow
                  | ◆ Mi Perfil TurnoFlex

                h1.profile-name
                  = nombrePaciente

                p.profile-subtitle
                  | DNI #{paciente.dni || 'N/D'} · #{paciente.email || 'Sin correo'}


          .col-lg-4

            .d-flex.flex-column.align-items-lg-end.gap-3

              .profile-status

                span.profile-status-dot

                span
                  | Perfil activo


              a.profile-hero-btn(
                href="/turnos/nuevo"
              )
                | ＋ Solicitar turno


    //- ==========================================================
    //- DATOS PERSONALES
    //- ==========================================================

    .profile-section

      .profile-label
        | Información personal

      h3.profile-title
        | Mis datos

      p.profile-text
        | Consultá tus datos identificatorios y actualizá tu información de contacto.


    .profile-panel.tfu-card


      .profile-readonly-note.mb-4
        | 🔒 El nombre, DNI y correo electrónico son datos identificatorios.
        | Para modificarlos, comunicate con recepción.


      form(
        action="/clientes/mi-perfil/editar"
        method="POST"
      )
        if typeof csrfToken !== "undefined" && csrfToken
          input(type="hidden" name="_csrf" value=csrfToken)

        .row.g-4


          .col-md-6

            label.form-label.profile-form-label
              | Nombre completo

            input.form-control.profile-field(
              type="text"
              value=nombrePaciente
              readonly
            )


          .col-md-6

            label.form-label.profile-form-label
              | DNI

            input.form-control.profile-field(
              type="text"
              value=paciente.dni || ''
              readonly
            )


          .col-md-6

            label.form-label.profile-form-label
              | Correo electrónico

            input.form-control.profile-field(
              type="email"
              value=paciente.email || ''
              readonly
            )


          .col-md-6

            label.form-label.profile-form-label
              | Teléfono de contacto

            input.form-control.profile-field(
              type="text"
              name="telefono"
              value=paciente.telefono || ''
              required
              placeholder="Ej: 1155443322"
            )


          .col-12.mt-4

            .profile-label
              | Cobertura médica

            h5.profile-title.mb-1
              | Obra social o prepaga

            p.profile-text
              | Si sos paciente particular, podés dejar estos campos vacíos.


          .col-md-4

            label.form-label.profile-form-label
              | Obra social / Prepaga

            input.form-control.profile-field(
              type="text"
              name="obraSocial"
              value=cobertura.empresa || ''
              placeholder="Ej: OSDE"
            )


          .col-md-4

            label.form-label.profile-form-label
              | Número de afiliado

            input.form-control.profile-field(
              type="text"
              name="numeroAfiliado"
              value=cobertura.numeroAfiliado || ''
              placeholder="Número de afiliado"
            )


          .col-md-4

            label.form-label.profile-form-label
              | Plan

            input.form-control.profile-field(
              type="text"
              name="plan"
              value=cobertura.plan || ''
              placeholder="Ej: 210"
            )


          .col-12

            .d-flex.justify-content-end.gap-2.flex-wrap.mt-2

              a.btn.btn-outline-secondary.rounded-3.px-4(
                href="/"
              )
                | Volver

              button.profile-save-btn(
                type="submit"
              )
                | Guardar cambios


    //- ==========================================================
    //- GRUPO FAMILIAR
    //- ==========================================================

    .profile-section

      .d-flex.justify-content-between.align-items-end.flex-wrap.gap-2

        div

          .profile-label
            | Familia

          h3.profile-title
            | Mi grupo familiar

          p.profile-text
            | Registrá familiares asociados a tu perfil.

        span.badge.bg-secondary.rounded-pill.px-3.py-2
          | #{familiares.length} registrado(s)


    .family-panel


      if familiares.length > 0

        .row.g-3

          each familiar in familiares

            .col-md-6.col-xl-4

              .family-card.tfu-card

                .family-icon
                  | 👤

                h6.family-name

                  if familiar && familiar.nombre
                    = familiar.nombre
                  else
                    | Familiar


                p.family-text

                  if familiar && familiar.dni
                    | DNI: #{familiar.dni}
                  else
                    | DNI: N/D


                p.family-text

                  if familiar && familiar.parentesco
                    | Parentesco: #{familiar.parentesco}
                  else
                    | Parentesco: N/D


      else

        .text-center.py-4

          .fs-2.mb-2
            | 👨‍👩‍👧‍👦

          h6.fw-bold.mb-1
            | Todavía no tenés familiares asociados

          p.text-muted.small.mb-0
            | Podés agregar uno utilizando el formulario de abajo.


      //- ========================================================
      //- AGREGAR FAMILIAR
      //- ========================================================

      form.family-form(
        action="/clientes/mi-perfil/familiar"
        method="POST"
      )
        if typeof csrfToken !== "undefined" && csrfToken
          input(type="hidden" name="_csrf" value=csrfToken)

        .d-flex.align-items-center.gap-2.mb-3

          span.fs-5
            | ＋

          div

            h6.fw-bold.mb-0
              | Agregar familiar

            small.text-muted
              | Completá los datos para asociarlo a tu perfil.


        .row.g-3


          .col-md-5

            label.form-label.profile-form-label
              | Nombre completo

            input.form-control.profile-field(
              type="text"
              name="nombreFamiliar"
              placeholder="Nombre y apellido"
              required
            )


          .col-md-3

            label.form-label.profile-form-label
              | DNI

            input.form-control.profile-field(
              type="text"
              name="dniFamiliar"
              placeholder="Documento"
              required
            )


          .col-md-4

            label.form-label.profile-form-label
              | Parentesco

            select.form-select.profile-field(
              name="parentesco"
              required
            )

              option(
                value=""
                disabled
                selected
              )
                | Seleccionar...

              option(value="Hijo/a")
                | Hijo/a

              option(value="Pareja")
                | Pareja

              option(value="Padre/Madre")
                | Padre/Madre

              option(value="Otro")
                | Otro


          .col-12

            .d-flex.justify-content-end

              button.btn.btn-success.family-add-btn.px-4(
                type="submit"
              )
                | ＋ Asociar familiar


    //- ==========================================================
    //- PIE
    //- ==========================================================

    .profile-footer

      div

        strong.d-block(
          style="color:var(--mp-text);"
        )
          | Perfil de paciente

        span
          | Información protegida dentro de TurnoFlex


      div.text-md-end

        if paciente.updatedAt
          | Última actualización: #{formatearFecha(paciente.updatedAt)}
        else if paciente.createdAt
          | Registrado: #{formatearFecha(paciente.createdAt)}
        else
          | Información de registro no disponible