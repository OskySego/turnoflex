//- ============================================================
//- VISTA DE ACTIVACIÓN DE ACCESO INSTITUCIONAL - TURNOFLEX
//- ============================================================
//- Plantilla Pug que renderiza el formulario para que el personal o profesional
//- active su cuenta institucional definiendo una contraseña segura[cite: 25].

extends layout

block content
  //- Contenedor principal con centrado responsive[cite: 25]
  .container.py-5
    .row.justify-content-center
      .col-md-8.col-lg-6
        
        //- ====================================================
        //- TARJETA CONTENEDORA DEL FORMULARIO DE ACTIVACIÓN
        //- ====================================================
        .card.border-0.shadow-sm.rounded-4
          .card-body.p-4.p-md-5
            
            //- Título y descripción principal[cite: 25]
            h1.h3.fw-bold.mb-3 Activar acceso a TurnoFlex[cite: 25]
            p.text-body-secondary Configurá tu contraseña para ingresar a la plataforma.[cite: 25]

            //- Alerta informativa con el identificador institucional asignado[cite: 25]
            if alias
              .alert.alert-info
                strong Identificador institucional:[cite: 25]
                p.mb-0= alias[cite: 25]

            //- Alerta condicional para errores de validación o vencimiento de token[cite: 25]
            if error
              .alert.alert-danger(role='alert')= error[cite: 25]

            //- ====================================================
            //- FORMULARIO DE ESTABLECIMIENTO DE CONTRASEÑA
            //- ====================================================
            form(action='/accesos/activar/' + token method='POST')
              
              //- Campo: Nueva contraseña (mínimo 12 caracteres)[cite: 25]
              .mb-3
                label.form-label(for='password') Nueva contraseña[cite: 25]
                input#password.form-control(type='password' name='password' minlength='12' maxlength='128' autocomplete='new-password' required)[cite: 25]
                .form-text Al menos 12 caracteres.[cite: 25]

              //- Campo: Confirmación de contraseña[cite: 25]
              .mb-4
                label.form-label(for='confirmacion') Repetir contraseña[cite: 25]
                input#confirmacion.form-control(type='password' name='confirmacion' minlength='12' maxlength='128' autocomplete='new-password' required)[cite: 25]

              //- Botón de envío para activar la cuenta[cite: 25]
              button.btn.btn-primary.w-100(type='submit') Activar cuenta e ingresar[cite: 25]