extends layout

block content
  //- Funciones de ayuda y Traductor de Días a prueba de fallos
  - const iniciales = (nombre) => nombre ? nombre.split(' ').filter(Boolean).slice(0, 2).map(n => n[0].toUpperCase()).join('') : 'DR'
  - const mapaDias = { '0': 'Domingo', '1': 'Lunes', '2': 'Martes', '3': 'Miércoles', '4': 'Jueves', '5': 'Viernes', '6': 'Sábado' }
  - 
    const formatDias = (dias) => {
      if (!dias || dias.length === 0) return 'No especificado';
      const arr = Array.isArray(dias) ? dias : dias.toString().split(',');
      return arr.map(d => {
        const val = String(d).trim();
        return mapaDias[val] || val;
      }).join(', ');
    }

  if error
    .alert.alert-danger.shadow-sm.rounded-3(role="alert")
      h4.alert-heading.fw-bold ¡Ocurrió un error!
      p.mb-2= error
      hr
      a.btn.btn-outline-danger.btn-sm(href="/profesionales") Volver al listado
  else if !profesional
    .alert.alert-warning.shadow-sm.rounded-3(role="alert")
      h4.alert-heading.fw-bold Profesional no encontrado
      p.mb-2 No se pudo obtener la información del profesional solicitado.
      hr
      a.btn.btn-outline-warning.btn-sm(href="/profesionales") Volver al listado
  else
    .row.justify-content-center
      .col-lg-9
        .card.border-0.rounded-4.shadow-sm.overflow-hidden
          
          //- Cabecera Principal
          .p-4.text-white(style="background-color: #0D1B3E;")
            .d-flex.justify-content-between.align-items-center.flex-wrap.gap-3
              .d-flex.align-items-center.gap-3
                .rounded-circle.d-flex.align-items-center.justify-content-center.fw-bold.fs-4(
                  style="width:60px; height:60px; background:#10B981; color:white;"
                )= iniciales(profesional.nombre)
                div
                  h3.mb-1.fw-bold= profesional.nombre
                  p.mb-1.text-white-50= profesional.especialidad || 'Especialidad N/D'
                  if profesional.subespecialidades
                    span.badge.bg-info.text-dark Sub: #{profesional.subespecialidades}
              
              div.text-end
                span.badge.bg-success.fs-6.px-3.py-2
                  if profesional.tipoCobertura === 'particular'
                    | Solo Particular
                  else if profesional.tipoCobertura === 'obra_social'
                    | Solo Obra Social
                  else
                    | Particular & Obra Social

          //- Cuerpo
          .card-body.p-4.bg-white
            
            //- Contacto y Sede
            h6.text-uppercase.text-muted.small.fw-bold.mb-3 Contacto y Sede
            .row.g-3.mb-4.bg-light.p-3.rounded-3
              .col-md-4
                strong.d-block.small.text-muted Teléfono:
                span= profesional.telefono || 'N/D'
              .col-md-4
                strong.d-block.small.text-muted Correo Electrónico:
                span= profesional.email || 'N/D'
              .col-md-4
                strong.d-block.small.text-muted Consultorio / Sede:
                span= profesional.sede || 'Sede Central'

            //- 1. Información Regulatoria y Agenda Regular
            h6.text-uppercase.text-muted.small.fw-bold.mb-3 Información Regulatoria y Agenda Regular
            .row.g-3.mb-4.bg-light.p-3.rounded-3.border-start.border-primary.border-4
              .col-md-4
                strong.d-block.small.text-muted Matrícula:
                span.fw-bold= profesional.matricula || 'N/D'
              .col-md-4
                strong.d-block.small.text-muted Modalidad:
                span.text-capitalize= profesional.modalidad || 'Presencial'
              .col-md-4
                strong.d-block.small.text-muted Duración de Consulta:
                span= `${profesional.duracionTurnoMinutos || 30} minutos`
              
              .col-md-12.mt-3
                strong.d-block.small.text-muted Días y Horarios de Atención Regular:
                span.text-primary.fw-bold= formatDias(profesional.diasAtencion)
                span.ms-2= `(De ${profesional.horaInicio || '08:00'} a ${profesional.horaFin || '16:00'} hs)`

            //- 2. Agenda de Sobreturnos (Solo se muestra si están habilitados)
            if profesional.permiteSobreturnos
              h6.text-uppercase.text-muted.small.fw-bold.mb-3 Agenda de Sobreturnos
              .row.g-3.mb-4.bg-light.p-3.rounded-3.border-start.border-warning.border-4
                .col-md-6
                  strong.d-block.small.text-muted Días habilitados para Sobreturnos:
                  span.text-warning.fw-bold= formatDias(profesional.diasSobreturnos)
                .col-md-6
                  strong.d-block.small.text-muted Horario de Sobreturnos:
                  span= `De ${profesional.horaInicioSobreturnos || '12:00'} a ${profesional.horaFinSobreturnos || '13:00'} hs `
                  span.badge.bg-secondary.ms-2 Máx: #{profesional.cantidadMaximaSobreturnos || 4}

            //- 3. Agenda de Telemedicina (Solo se muestra si está habilitada)
            if profesional.ofreceTelemedicina
              h6.text-uppercase.text-muted.small.fw-bold.mb-3 Agenda de Telemedicina
              .row.g-3.mb-4.bg-light.p-3.rounded-3.border-start.border-info.border-4
                .col-md-6
                  strong.d-block.small.text-muted Días habilitados para Telemedicina:
                  span.text-info.fw-bold= formatDias(profesional.diasTelemedicina)
                .col-md-6
                  strong.d-block.small.text-muted Horario de Videoconsulta:
                  span= `De ${profesional.horaInicioTelemedicina || '16:00'} a ${profesional.horaFinTelemedicina || '18:00'} hs`

            //- Botón de retorno
            .d-flex.justify-content-end.mt-4
              a.btn.btn-outline-secondary.px-4.rounded-3(href="/profesionales") Volver al listado