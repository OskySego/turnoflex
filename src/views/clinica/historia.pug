//- ============================================================
//- VISTA DE HISTORIA CLÍNICA DEL PACIENTE - TURNOFLEX
//- ============================================================
//- Plantilla Pug que renderiza el expediente clínico completo del paciente,
//- mostrando evoluciones médicas, rectificaciones, estudios adjuntos y controles de revisión[cite: 28].

extends ../layout

block content
  //- Helper local para formatear marcas de tiempo a la zona horaria de Argentina[cite: 28]
  - const formatoFecha = valor => valor ? new Date(valor).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' }) : 'Sin fecha'
  
  .container.py-4
    //- ========================================================
    //- CABECERA DE LA HISTORIA CLÍNICA Y DATOS DEL PACIENTE
    //- ========================================================
    .d-flex.justify-content-between.flex-wrap.align-items-center.gap-3.mb-4
      div
        p.text-primary.fw-bold.text-uppercase.small.mb-1 TurnoFlex · Área clínica[cite: 28]
        h1.h3.mb-1 Historia clínica[cite: 28]
        p.text-body-secondary.mb-0 #{paciente.nombre} · DNI #{paciente.dni || 'No informado'}[cite: 28]
      a.btn.btn-outline-secondary(href=esMedico ? '/medico/agenda' : '/') Volver[cite: 28]

    //- Alerta institucional sobre el entorno de desarrollo y la firma digital pendiente[cite: 28]
    .alert.alert-warning(role='status')
      strong Entorno de desarrollo.[cite: 28]
      |  Las evoluciones de esta etapa están pendientes de firma digital y no son válidas como historia clínica electrónica en producción.[cite: 28]

    //- ========================================================
    //- SECCIÓN 1: EVOLUCIONES Y REGISTROS MÉDICOS
    //- ========================================================
    section.mb-4(aria-labelledby='tituloNotas')
      h2.h5#tituloNotas Evoluciones y registros médicos[cite: 28]
      if !notas.length
        .card
          .card-body.text-body-secondary Aún no hay evoluciones registradas.[cite: 28]
      else
        each nota in notas
          article.card.mb-3
            .card-body
              .d-flex.justify-content-between.flex-wrap.gap-2.mb-3
                div
                  strong= nota.tipo === 'rectificacion' ? 'Rectificación clínica' : 'Evolución clínica'[cite: 28]
                  p.text-body-secondary.small.mb-0= formatoFecha(nota.registradoEn)[cite: 28]
                span.badge.text-bg-warning Pendiente de firma digital[cite: 28]

              if nota.tipo === 'rectificacion'
                p.small.text-body-secondary Referencia al registro: #{nota.rectificaNotaId}[cite: 28]
                p
                  strong Motivo de rectificación:[cite: 28]
                  |  #{nota.motivoRectificacion}[cite: 28]

              p
                strong Motivo de consulta:[cite: 28]
                |  #{nota.motivoConsulta}[cite: 28]

              if nota.anamnesis
                p
                  strong Anamnesis:[cite: 28]
                  |  #{nota.anamnesis}[cite: 28]

              if nota.examenFisico
                p
                  strong Examen físico:[cite: 28]
                  |  #{nota.examenFisico}[cite: 28]

              if nota.diagnostico
                p
                  strong Diagnóstico:[cite: 28]
                  |  #{nota.diagnostico}[cite: 28]

              if nota.indicaciones
                p.mb-2
                  strong Indicaciones:[cite: 28]
                  |  #{nota.indicaciones}[cite: 28]

              p.text-body-secondary.small.mb-2 Autor profesional (ID): #{nota.profesionalId}[cite: 28]

              //- Mostrar rectificación solo al profesional y usuario autor.[cite: 28]
              //- El servidor realiza nuevamente la misma validación de seguridad.[cite: 28]
              if esMedico && String(nota.profesionalId) === String(profesionalActualId) && String(nota.usuarioAutorId) === String(usuarioClinicoId)
                a.btn.btn-sm.btn-outline-primary(href=`/clinica/pacientes/${paciente._id}/evoluciones/${nota._id}/rectificar`) Rectificar con nuevo asiento[cite: 28]

    //- ========================================================
    //- SECCIÓN 2: ESTUDIOS ADJUNTOS
    //- ========================================================
    section(aria-labelledby='tituloEstudios')
      h2.h5#tituloEstudios Estudios adjuntos[cite: 28]
      if !estudios.length
        .card
          .card-body.text-body-secondary Todavía no hay estudios cargados.[cite: 28]
      else
        each estudio in estudios
          article.card.mb-3
            .card-body
              .d-flex.justify-content-between.align-items-start.gap-2.flex-wrap
                div
                  h3.h6.mb-1= estudio.tipoEstudio[cite: 28]
                  p.text-body-secondary.small.mb-1 Estudio: #{formatoFecha(estudio.fechaEstudio)} · Incorporado: #{formatoFecha(estudio.registradoEn)}[cite: 28]
                  p.small.mb-1= estudio.revision.estado === 'revisado' ? 'Revisado por profesional' : 'Pendiente de revisión médica'[cite: 28]
                  
                  if estudio.revision.estado === 'revisado' && estudio.revision.observacion
                    p.mb-1
                      strong Observación médica:[cite: 28]
                      |  #{estudio.revision.observacion}[cite: 28]

                a.btn.btn-sm.btn-outline-primary(href=`/clinica/pacientes/${paciente._id}/estudios/${estudio._id}/archivo`) Descargar estudio[cite: 28]

              //- Formulario para que el médico revise y valide estudios pendientes[cite: 28]
              if esMedico && estudio.revision.estado === 'pendiente'
                form.mt-3(method='POST' action=`/clinica/pacientes/${paciente._id}/estudios/${estudio._id}/revisar`)
                  if typeof csrfToken !== 'undefined' && csrfToken
                    input(type='hidden' name='_csrf' value=csrfToken)[cite: 28]
                  input(type='hidden' name='_tfClinicaCsrf' value=tfClinicaCsrf)[cite: 28]
                  label.form-label(for=`observacion-${estudio._id}`) Observación médica de revisión (opcional)[cite: 28]
                  textarea.form-control.mb-2(id=`observacion-${estudio._id}` name='observacion' maxlength='3000' rows='2')[cite: 28]
                  button.btn.btn-primary.btn-sm(type='submit') Marcar revisado[cite: 28]