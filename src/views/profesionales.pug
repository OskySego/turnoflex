extends layout

block content
  .tf-page--profesionales

    //- ============================================================
    //- CABECERA
    //- ============================================================

    .tf-prof-header.tfu-hero

      .d-flex.justify-content-between.align-items-center.flex-wrap.gap-3

        div

          small.text-uppercase.fw-bold(
            style="color:#c4b5fd;"
          )
            | Equipo Médico

          h2.mb-1.fw-bold
            | Profesionales

          p.mb-0
            | Especialidades, agendas y modalidades de atención


        .d-flex.flex-wrap.align-items-center.gap-2

          span.badge.rounded-pill.px-3.py-2(
            style="background:rgba(255,255,255,.12);"
          )
            | #{profesionales ? profesionales.length : 0} profesionales

          a.btn.btn-light.rounded-3(
            href="/"
          )
            | Inicio

          if user && (user.rol === 'admin' || user.rol === 'personal')

            a.btn.text-white.rounded-3(
              href="/profesionales/nuevo"
              style="background:#8B5CF6;"
            )
              | + Nuevo profesional


    //- ============================================================
    //- BUSCADOR Y FILTROS
    //- ============================================================

    if profesionales && profesionales.length > 0

      .card.border-0.shadow-sm.rounded-4.mb-4.tfu-card

        .card-body.p-3.p-md-4

          .row.g-3.align-items-center

            .col-lg-6

              .tf-search-box

                span.tf-search-icon
                  | ⌕

                input.form-control(
                  id="buscarProfesional"
                  type="search"
                  placeholder="Buscar por nombre, especialidad, matrícula o sede..."
                  autocomplete="off"
                )


            .col-lg-6

              .d-flex.flex-wrap.gap-2.justify-content-lg-end

                button.btn.btn-primary.tf-filter-btn(
                  type="button"
                  data-modalidad="todos"
                )
                  | Todos

                button.btn.btn-outline-primary.tf-filter-btn(
                  type="button"
                  data-modalidad="presencial"
                )
                  | Presencial

                button.btn.btn-outline-info.tf-filter-btn(
                  type="button"
                  data-modalidad="telemedicina"
                )
                  | Telemedicina

                button.btn.btn-outline-secondary.tf-filter-btn(
                  type="button"
                  data-modalidad="ambas"
                )
                  | Ambas


    //- ============================================================
    //- SIN PROFESIONALES
    //- ============================================================

    if !profesionales || profesionales.length === 0

      .card.border-0.shadow-sm.rounded-4.tfu-card

        .card-body.text-center.p-5

          .display-6.mb-3
            | ✚

          h5.fw-bold
            | No hay profesionales registrados

          p.text-muted.mb-4
            | Los profesionales incorporados aparecerán en este panel.

          if user && (user.rol === 'admin' || user.rol === 'personal')

            a.btn.btn-primary.rounded-3.px-4(
              href="/profesionales/nuevo"
            )
              | Registrar profesional


    //- ============================================================
    //- GRILLA
    //- ============================================================

    else

      #profesionalesGrid.row.g-4

        each prof in profesionales

          - const profId = prof._id || prof.id
          - const nombre = prof.nombre || 'Profesional'
          - const partesNombre = nombre.split(' ').filter(Boolean)
          - const inicial1 = partesNombre.length > 0 ? partesNombre[0].charAt(0) : 'P'
          - const inicial2 = partesNombre.length > 1 ? partesNombre[1].charAt(0) : ''
          - const iniciales = (inicial1 + inicial2).toUpperCase()
          - const dias = prof.diasAtencion && Array.isArray(prof.diasAtencion) ? prof.diasAtencion : []
          - const modalidad = prof.modalidad || 'presencial'
          - const cobertura = prof.tipoCobertura || 'ambas'
          - const codigo = profId ? 'PRO-' + profId.toString().slice(-5).toUpperCase() : 'PRO-00000'

          .col-xl-4.col-lg-6.profesional-wrapper(
            data-modalidad=modalidad
            data-search=`${nombre} ${prof.especialidad || ''} ${prof.subespecialidades || ''} ${prof.matricula || ''} ${prof.sede || ''} ${prof.email || ''}`.toLowerCase()
          )

            .card.tf-prof-card.border-0.rounded-4.shadow-sm.h-100.tfu-card

              .card-body.p-4.d-flex.flex-column


                //- ==================================================
                //- IDENTIDAD
                //- ==================================================

                .d-flex.align-items-center.gap-3.mb-4

                  .tf-prof-avatar
                    = iniciales

                  div.flex-grow-1

                    span.tf-prof-code
                      = codigo

                    h5.fw-bold.mb-1
                      = nombre

                    p.text-muted.small.mb-0
                      = prof.especialidad || 'Especialidad no especificada'


                //- ==================================================
                //- MATRÍCULA Y SEDE
                //- ==================================================

                .row.g-2.mb-3

                  .col-6

                    .tf-info-box.h-100

                      span.tf-label
                        | Matrícula

                      strong.small
                        = prof.matricula || 'N/D'


                  .col-6

                    .tf-info-box.h-100

                      span.tf-label
                        | Sede

                      strong.small
                        = prof.sede || 'Sede Central'


                //- ==================================================
                //- AGENDA REGULAR
                //- ==================================================

                .tf-days-box.mb-3

                  span.tf-label
                    | Agenda regular

                  if dias.length > 0

                    strong.small.d-block.mb-1
                      = dias.join(' · ')

                  else

                    strong.small.d-block.mb-1
                      | Días no definidos

                  small.text-muted
                    | #{prof.horaInicio || '08:00'} a #{prof.horaFin || '18:00'} hs

                  small.text-muted.d-block
                    | Turnos de #{prof.duracionTurnoMinutos || 30} minutos


                //- ==================================================
                //- COBERTURA
                //- ==================================================

                .mb-3

                  span.tf-label.mb-2
                    | Tipo de atención

                  if cobertura === 'particular'

                    span.badge.bg-info.text-dark
                      | Particular

                  else if cobertura === 'obra_social'

                    span.badge.bg-primary
                      | Obra social / Prepaga

                  else

                    span.badge.bg-primary
                      | Particular + Obra social


                //- ==================================================
                //- MODALIDADES
                //- ==================================================

                .d-flex.flex-wrap.gap-2.mb-3

                  if modalidad === 'presencial'

                    span.tf-feature.tf-feature-purple
                      | ● Presencial

                  else if modalidad === 'telemedicina'

                    span.tf-feature.tf-feature-blue
                      | ◉ Telemedicina

                  else

                    span.tf-feature.tf-feature-purple
                      | ● Presencial

                    span.tf-feature.tf-feature-blue
                      | ◉ Telemedicina


                  if prof.permiteSobreturnos

                    span.tf-feature.tf-feature-orange
                      | + Sobreturnos


                  if prof.ofreceTelemedicina && modalidad !== 'telemedicina' && modalidad !== 'ambas'

                    span.tf-feature.tf-feature-blue
                      | ◉ Telemedicina


                //- ==================================================
                //- CONTACTO
                //- ==================================================

                .mb-3

                  span.tf-label
                    | Contacto

                  small.text-muted.d-block
                    = prof.telefono || 'Teléfono no registrado'

                  small.text-muted.d-block
                    = prof.email || 'Email no registrado'


                //- ==================================================
                //- BOTÓN
                //- ==================================================

                .mt-auto.pt-2

                  a.btn.btn-outline-primary.w-100.rounded-3.fw-bold(
                    href=`/profesionales/${profId}`
                  )
                    | Ver ficha y agenda


      //- ==========================================================
      //- SIN RESULTADOS
      //- ==========================================================

      #sinResultadosProfesionales.tf-empty-search

        .display-6.mb-2
          | ⌕

        h5.fw-bold
          | No encontramos profesionales

        p.text-muted.mb-0
          | Probá con otro nombre, especialidad, matrícula o sede.


    //- ============================================================
    //- BÚSQUEDA Y FILTROS
    //- ============================================================

    script.
      document.addEventListener('DOMContentLoaded', function () {

        const buscador =
          document.getElementById('buscarProfesional');

        const tarjetas =
          Array.from(
            document.querySelectorAll('.profesional-wrapper')
          );

        const botones =
          document.querySelectorAll('[data-modalidad]');

        const sinResultados =
          document.getElementById('sinResultadosProfesionales');

        let modalidadActiva =
          'todos';


        function aplicarFiltros() {

          const texto =
            buscador
              ? buscador.value.toLowerCase().trim()
              : '';

          let visibles =
            0;


          tarjetas.forEach(function (tarjeta) {

            const contenido =
              tarjeta.dataset.search || '';

            const modalidad =
              tarjeta.dataset.modalidad || 'presencial';


            const coincideTexto =
              !texto ||
              contenido.includes(texto);


            const coincideModalidad =
              modalidadActiva === 'todos' ||
              modalidad === modalidadActiva ||
              (
                modalidadActiva === 'presencial' &&
                modalidad === 'ambas'
              ) ||
              (
                modalidadActiva === 'telemedicina' &&
                modalidad === 'ambas'
              );


            if (
              coincideTexto &&
              coincideModalidad
            ) {

              tarjeta.style.display = '';

              visibles++;

            } else {

              tarjeta.style.display = 'none';

            }

          });


          if (sinResultados) {

            sinResultados.style.display =
              visibles === 0
                ? 'block'
                : 'none';

          }

        }


        if (buscador) {

          buscador.addEventListener(
            'input',
            aplicarFiltros
          );

        }


        botones.forEach(function (boton) {

          boton.addEventListener(
            'click',
            function () {

              modalidadActiva =
                boton.dataset.modalidad;


              botones.forEach(function (btn) {

                if (btn.dataset.modalidad === 'telemedicina') {

                  btn.className =
                    'btn btn-outline-info tf-filter-btn';

                } else if (btn.dataset.modalidad === 'ambas') {

                  btn.className =
                    'btn btn-outline-secondary tf-filter-btn';

                } else {

                  btn.className =
                    'btn btn-outline-primary tf-filter-btn';

                }

              });


              boton.className =
                'btn btn-primary tf-filter-btn';


              aplicarFiltros();

            }
          );

        });

      });