//- ============================================================
//- VISTA DE PRUEBA DE RECORDATORIOS POR WHATSAPP - TURNOFLEX
//- ============================================================
//- Plantilla Pug exclusiva para administradores.
//- Acá permito enviar un mensaje de prueba a un número propio o
//- autorizado para verificar la integración de WhatsApp sin tocar
//- ni modificar turnos reales del sistema.

extends layout

block content

  //- ============================================================
  //- 1. CONTENEDOR PRINCIPAL Y CABECERA
  //- ============================================================

  .container.py-4(style="max-width: 660px")
    a.btn.btn-outline-secondary.mb-3(href="/") Volver al panel

    h1.mb-3 Prueba de WhatsApp

    p.text-body-secondary
      | Exclusivo para administradores.
      |  Envía un recordatorio ficticio a un número
      |  propio o autorizado, sin modificar turnos.


    //- ==========================================================
    //- 2. ALERTAS DE RESULTADO (ERROR O CONFIRMACIÓN)
    //- ==========================================================

    //- Muestro el detalle del error si falló el envío de prueba
    if error
      .alert.alert-danger(role="alert")= error

    //- Muestro la confirmación cuando el mensaje salió correctamente
    if exito
      .alert.alert-success(role="status")= exito


    //- ==========================================================
    //- 3. FORMULARIO DE ENVÍO DE RECORDATORIO DE PRUEBA
    //- ==========================================================

    .card.shadow-sm
      .card-body.p-4
        form(action="/admin/prueba-whatsapp" method="POST")
          //- Incluyo el token CSRF para validar la petición en el servidor
          input(type="hidden" name="_csrf" value=csrfToken)

          //- Campo numérico con formato internacional argentino (549 + 10 dígitos)
          .mb-3
            label.form-label(for="telefono") Número de prueba

            input#telefono.form-control(
              type="tel"
              name="telefono"
              placeholder="549XXXXXXXXXX"
              inputmode="numeric"
              autocomplete="off"
              pattern="549[0-9]{10}"
              maxlength="13"
              required
            )

            .form-text
              | Usá un número propio o autorizado.
              |  No ingreses el de un paciente.

          //- Vista previa de los datos ficticios que va a recibir el teléfono
          .alert.alert-info
            strong Contenido de la prueba
            p.mb-0
              | Paciente: Paciente de Prueba.
              |  Profesional: Profesional de Prueba.
              |  Fecha: mañana. Hora: 10:00.

          button.btn.btn-primary(type="submit")
            | Enviar recordatorio de prueba