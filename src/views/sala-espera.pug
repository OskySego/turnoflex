//- ============================================================
//- VISTA DE SALA DE ESPERA EN VIVO - TURNOFLEX
//- ============================================================
//- Pantalla pública independiente para proyectar en sala de espera.
//- Acá muestro el reloj en tiempo real de Buenos Aires, el llamado activo
//- a consultorio con efecto visual, la cola de próximos turnos pendientes
//- y el historial reciente sincronizado por Socket.IO y API REST.

doctype html
html(lang="es")

  //- ============================================================
  //- 1. HEAD: METADATOS, BOOTSTRAP Y ESTILOS DE PANTALLA
  //- ============================================================

  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title Sala de Espera en Vivo - TurnoFlex

    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="/css/turnoflex.css")

    style.
      body {
        margin: 0;
        background: #2b3748;
        color: #f1f5f9;
        font-family: system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        padding: 2rem 1rem;
      }

      /* ==========================================================
         CONTENEDORES PRINCIPALES Y RELOJ
         ========================================================== */

      .sala-panel, .sala-hero-inner, .sala-clock-card {
        background: #37465d;
        border: 1px solid #4a5c78;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 8px 24px rgba(0, 0, 0, .2);
      }

      .sala-hero-inner {
        margin-bottom: 1.5rem;
      }

      .sala-kicker {
        color: #38bdf8;
        font-weight: 700;
        font-size: .85rem;
      }

      .sala-clock-card {
        text-align: right;
      }

      .sala-clock {
        color: #38bdf8;
        font-size: 2.5rem;
        font-weight: 800;
      }

      .sala-clock-date {
        color: #cbd5e1;
        font-size: .9rem;
      }

      /* ==========================================================
         PANEL DE LLAMADO ACTIVO Y COLA DE ESPERA
         ========================================================== */

      .sala-badge {
        background: #475569;
        color: white;
        border-radius: 2rem;
        padding: .4rem .9rem;
        font-size: .85rem;
        font-weight: 700;
      }

      .sala-badge.activo {
        background: #059669;
      }

      .sala-current-name {
        color: #38bdf8;
        font-size: 2.2rem;
        font-weight: 800;
        margin-top: 1rem;
      }

      .sala-current-spec {
        color: #cbd5e1;
        font-size: 1.1rem;
      }

      .sala-item-fila {
        border-bottom: 1px solid #4a5c78;
        padding: 12px 0;
      }

      .sala-destello {
        animation: destacar .7s ease 3;
      }

      @keyframes destacar {
        0%, 100% { opacity: 1; }
        50% { opacity: .35; }
      }


  //- ============================================================
  //- 2. CUERPO PRINCIPAL DE LA SALA DE ESPERA
  //- ============================================================

  body
    .container-fluid.px-4

      //- --------------------------------------------------------
      //- CABECERA (HERO) Y RELOJ LOCAL DE BUENOS AIRES
      //- --------------------------------------------------------
      section.sala-hero-inner
        .row.align-items-center.g-4
          .col-lg-8
            .sala-kicker ◈ TURNOFLEX · SALA DE ESPERA EN VIVO
            h1.fw-bold.text-white.mb-2 Consultorios en Atención
            p.text-light.opacity-75.mb-0 Pantalla dinámica de llamados médicos en tiempo real.

          .col-lg-4
            .sala-clock-card
              .text-light.opacity-75 Hora actual de Buenos Aires
              .sala-clock#salaClock --:--
              .sala-clock-date#salaDate Cargando fecha...

      //- --------------------------------------------------------
      //- PANELES DE LLAMADO EN CURSO Y FILA DE PRÓXIMOS TURNOS
      //- --------------------------------------------------------
      .row.g-4

        //- Tarjeta principal: paciente convocado actualmente a consultorio
        .col-lg-7
          .sala-panel.h-100
            .d-flex.justify-content-between.align-items-center.mb-3
              span.sala-badge#estadoLlamado Aguardando llamado

            h3.text-white.mb-3 Llamado a consultorio

            .sala-current-box.p-3
              .sala-current-name#pacienteActual Aguardando próximo llamado...
              .sala-current-spec#profesionalActual Los pacientes serán convocados por su profesional.

        //- Tarjeta lateral: turnos pendientes en sala de espera
        .col-lg-5
          .sala-panel.h-100
            .d-flex.justify-content-between.align-items-center.mb-3
              h4.text-white.mb-0 📋 Próximos en espera
              span.badge.bg-secondary#contadorEspera 0 en fila

            .sala-list.mt-3#listaEspera
              .text-light.opacity-75 Consultando turnos pendientes...


    //- ============================================================
    //- 3. HISTORIAL DE LLAMADOS Y SCRIPTS DE TIEMPO REAL
    //- ============================================================

    //- Incluyo el parcial con el historial de últimos llamados realizados
    include includes/salaEsperaHistorial.pug

    //- Cliente de Socket.IO para recibir eventos instantáneos desde el servidor
    script(src="/socket.io/socket.io.js")

    script.
      document.addEventListener('DOMContentLoaded', function () {
        'use strict';

        // Capturo las referencias del DOM y defino variables de control de estado
        const zona = 'America/Argentina/Buenos_Aires';
        const reloj = document.getElementById('salaClock');
        const fecha = document.getElementById('salaDate');
        const paciente = document.getElementById('pacienteActual');
        const profesional = document.getElementById('profesionalActual');
        const estado = document.getElementById('estadoLlamado');
        const lista = document.getElementById('listaEspera');
        const contador = document.getElementById('contadorEspera');
        let ultimoTurnoLlamado = null;
        let versionRecuperacion = 0;

        // ========================================================
        // RELOJ Y FECHA LOCAL DE BUENOS AIRES
        // ========================================================

        function actualizarReloj() {
          const ahora = new Date();

          if (reloj) {
            reloj.textContent = ahora.toLocaleTimeString('es-AR', {
              timeZone: zona,
              hour: '2-digit',
              minute: '2-digit',
              hour12: false
            });
          }

          if (fecha) {
            fecha.textContent = ahora.toLocaleDateString('es-AR', {
              timeZone: zona,
              weekday: 'long',
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            });
          }
        }

        // ========================================================
        // CONSULTA Y RENDERIZADO DE TURNOS PENDIENTES EN ESPERA
        // ========================================================

        async function cargarSala() {
          try {
            const respuesta = await fetch('/api/sala-espera/activos', {
              headers: { Accept: 'application/json' },
              cache: 'no-store'
            });

            if (!respuesta.ok) {
              throw new Error('No fue posible consultar la sala.');
            }

            const turnos = await respuesta.json();

            if (!Array.isArray(turnos)) {
              throw new Error('Formato de turnos inválido.');
            }

            // Filtro los turnos pendientes y excluyo el que está siendo llamado en este momento
            const enEspera = turnos.filter(function (t) {
              const valor = String(t.estado || '').toLowerCase().trim();
              const pendiente = valor === 'reservado' || valor === 'en espera';
              return pendiente && String(t._id) !== ultimoTurnoLlamado;
            });

            lista.replaceChildren();

            // Renderizo cada turno en fila mostrando horario y código corto sin exponer datos sensibles
            enEspera.forEach(function (t) {
              const fila = document.createElement('div');
              fila.className = 'sala-item-fila';

              const codigo = String(t._id || '').slice(-6).toUpperCase();
              fila.textContent = String(t.hora || '--:--') + ' hs — Turno #' + codigo;

              lista.appendChild(fila);
            });

            if (!enEspera.length) {
              const vacio = document.createElement('div');
              vacio.className = 'text-light opacity-75';
              vacio.textContent = 'No hay turnos pendientes.';
              lista.appendChild(vacio);
            }

            contador.textContent = enEspera.length + ' en fila';

          } catch (error) {
            console.error('Error en sala de espera:', error);

            if (lista) {
              lista.textContent = 'No se pudo actualizar la lista de espera.';
            }
          }
        }

        // ========================================================
        // PRESENTACIÓN VISUAL DEL LLAMADO DEL PROFESIONAL
        // ========================================================

        function mostrarLlamado(datos) {
          if (!datos || !datos.paciente) return;
          versionRecuperacion++;

          const sedeOConsultorio = String(datos.consultorio || '').trim();

          // Extraigo solo el número o nombre de consultorio (ej. "Sede Central - Consultorio 6" -> "Consultorio 6")
          const coincidencia = sedeOConsultorio.match(/consultorio\s*[-#:]?\s*[\w]+/i);
          const consultorio = coincidencia
            ? coincidencia[0].replace(/^consultorio/i, 'Consultorio')
            : sedeOConsultorio || 'Consultorio no asignado';

          paciente.textContent = String(datos.paciente);
          profesional.textContent =
            'Diríjase al ' + consultorio +
            (datos.profesional ? ' — ' + String(datos.profesional) : '');

          estado.textContent = '📢 Llamando ahora';
          estado.classList.add('activo');

          // Reinicio la animación de destello forzando un reflow del nodo
          paciente.classList.remove('sala-destello');
          void paciente.offsetWidth;
          paciente.classList.add('sala-destello');

          ultimoTurnoLlamado = String(datos.turnoId || '');
          cargarSala();
        }

        // ========================================================
        // SINCRONIZACIÓN Y RECUPERACIÓN DEL ÚLTIMO LLAMADO
        // ========================================================

        // Vuelvo el panel principal al estado inicial cuando no hay llamados activos
        function limpiarLlamado() {
          ultimoTurnoLlamado = null;
          paciente.textContent = 'Aguardando próximo llamado...';
          profesional.textContent = 'Los pacientes serán convocados por su profesional.';
          estado.textContent = 'Aguardando llamado';
          estado.classList.remove('activo');
        }

        // Consulto en el backend el último llamado vigente al cargar o reconectar
        async function recuperarUltimoLlamado() {
          const version = ++versionRecuperacion;

          try {
            const respuesta = await fetch('/api/sala-espera/ultimo-llamado', {
              headers: {
                Accept: 'application/json'
              },
              cache: 'no-store'
            });

            if (!respuesta.ok) {
              throw new Error('No se pudo recuperar el último llamado.');
            }

            const datos = await respuesta.json();

            // Descarto respuestas viejas si ya entró un llamado nuevo en vivo mientras esperaba el fetch
            if (version !== versionRecuperacion) {
              return;
            }

            if (datos.llamado) {
              mostrarLlamado(datos.llamado);
            } else {
              limpiarLlamado();
            }

          } catch (error) {
            console.error('Error recuperando el llamado:', error);
          }
        }

        // ========================================================
        // INICIALIZACIÓN Y SUSCRIPCIÓN A EVENTOS EN TIEMPO REAL
        // ========================================================

        actualizarReloj();
        setInterval(actualizarReloj, 1000);

        cargarSala();
        recuperarUltimoLlamado();
        setInterval(cargarSala, 30000);

        // Conecto Socket.IO para refrescar la sala y disparar llamados al instante
        if (typeof io === 'function') {
          const socket = io();

          socket.on('connect', () => {
            cargarSala();
            recuperarUltimoLlamado();
          });

          socket.on('actualizacion_agenda', () => {
            cargarSala();
            recuperarUltimoLlamado();
          });

          socket.on('llamado_paciente', mostrarLlamado);

        } else {
          console.error('Socket.IO no está disponible en la sala de espera.');
        }
      });