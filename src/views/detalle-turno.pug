extends layout

block content
  if error
    .alert.alert-danger.shadow-sm.rounded-3(role="alert")
      h4.alert-heading.fw-bold ¡Ocurrió un error!
      p.mb-2= error
      hr
      a.btn.btn-outline-danger.btn-sm(href="/turnos") Volver al listado
  else
    - const turnoId = turno ? (turno._id || turno.id) : null
    - const clienteObj = (turno && turno.cliente_id && typeof turno.cliente_id === 'object') ? turno.cliente_id : (turno ? turno.cliente : null)
    - const profesionalObj = (turno && turno.profesional_id && typeof turno.profesional_id === 'object') ? turno.profesional_id : (turno ? turno.profesional : null)
    - const esFinalizado = turno && (turno.estado === 'atendido' || turno.estado === 'cancelado')

    .row.justify-content-center
      .col-lg-9
        .card.border-0.rounded-4.shadow-sm.overflow-hidden
          
          //- Cabecera Principal
          .p-4.text-white(style="background-color: #0D1B3E;")
            .d-flex.justify-content-between.align-items-center.flex-wrap.gap-3
              div
                span.badge.bg-primary.mb-2.fs-6 Turno N° #{turnoId ? turnoId.toString().slice(-6).toUpperCase() : 'N/A'}
                h3.mb-0.fw-bold Gestión del Turno Médico
              div
                if turno && turno.estado === 'atendido'
                  span.badge.bg-success.fs-6.px-3.py-2 ATENDIDO
                else if turno && turno.estado === 'cancelado'
                  span.badge.bg-danger.fs-6.px-3.py-2 CANCELADO
                else
                  span.badge.bg-warning.text-dark.fs-6.px-3.py-2 PENDIENTE DE ATENCIÓN

          //- Cuerpo
          .card-body.p-4.bg-white

            //- Datos del Paciente y Cita
            h6.text-uppercase.text-muted.small.fw-bold.mb-3 Datos de la Cita y Paciente
            .row.g-3.mb-4
              .col-md-6
                .p-3.rounded-3.bg-light.h-100
                  strong.d-block.small.text-muted.text-uppercase.mb-2 Paciente / Cliente
                  h5.fw-bold.mb-1= clienteObj ? clienteObj.nombre : 'Sin asignar'
                  p.text-muted.small.mb-1 DNI: #{clienteObj && clienteObj.dni ? clienteObj.dni : 'N/D'}
                  p.text-muted.small.mb-0 Cobertura: #{clienteObj && clienteObj.obraSocial && clienteObj.obraSocial.empresa ? clienteObj.obraSocial.empresa : 'Particular'}

              .col-md-6
                .p-3.rounded-3.bg-light.h-100
                  strong.d-block.small.text-muted.text-uppercase.mb-2 Horario y Modalidad
                  h5.fw-bold.mb-1= turno && turno.fecha ? turno.fecha : 'Fecha no definida'
                  p.text-muted.small.mb-1 Horario: #{turno && turno.hora ? turno.hora + ' hs' : 'N/D'}
                  p.text-muted.small.mb-0 Modalidad: #{turno && turno.modalidad ? turno.modalidad : 'Presencial'}

            //- Profesional Asignado
            h6.text-uppercase.text-muted.small.fw-bold.mb-3 Profesional Asignado
            .row.g-3.mb-4.bg-light.p-3.rounded-3.mx-0
              .col-md-12
                h5.fw-bold.mb-1= profesionalObj ? profesionalObj.nombre : 'Sin asignar'
                p.text-muted.small.mb-0 Especialidad: #{profesionalObj ? profesionalObj.especialidad : 'General'}

            //- Botones de acción
            if turnoId
              .d-flex.flex-wrap.align-items-center.gap-3.pt-2(class=esFinalizado ? 'justify-content-end' : 'justify-content-between')
                if !esFinalizado
                  .d-flex.flex-wrap.gap-2
                    form(action=`/turnos/${turnoId}/atendido` method="POST" style="display:inline;")
                      button.btn.btn-success.px-3.py-2.rounded-3(type="submit") Marcar como Atendido
                    
                    form(action=`/turnos/${turnoId}/cancelar` method="POST" style="display:inline;")
                      button.btn.btn-danger.px-3.py-2.rounded-3(type="submit") Cancelar Turno

                a.btn.btn-outline-secondary.px-4.py-2.rounded-3(href="/turnos") Volver al listado
            else
              .d-flex.justify-content-end
                a.btn.btn-outline-secondary.px-4.py-2.rounded-3(href="/turnos") Volver al listado