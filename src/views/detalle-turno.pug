extends layout

block content
  .row.justify-content-center
    .col-md-8
      if mensajeExito
        .alert.alert-success.alert-dismissible.fade.show.shadow-sm(role="alert")
          strong ¡Éxito! 
          span= mensajeExito

      if error
        .alert.alert-danger.alert-dismissible.fade.show.shadow-sm(role="alert")
          strong Error: 
          span= error

      if turno
        .card.shadow-sm
          .card-header.bg-white.py-3.d-flex.justify-content-between.align-items-center
            h2.h4.mb-0 Detalle del Turno ##{turno.id}
            
            if turno.estado === 'cancelado'
              span.badge.bg-danger.fs-6 CANCELADO
            else if turno.estado === 'atendido'
              span.badge.bg-success.fs-6 ATENDIDO
            else
              span.badge.bg-warning.text-dark.fs-6 RESERVADO

          .card-body
            .row.mb-3
              .col-md-6
                h5.h6.text-muted.text-uppercase Datos del Turno
                p.mb-1
                  strong Fecha: 
                  span= turno.fecha
                p.mb-1
                  strong Hora: 
                  span= `${turno.hora} hs`

              .col-md-6
                if turno.usuario
                  h5.h6.text-muted.text-uppercase Paciente / Cliente
                  p.mb-1
                    strong Nombre: 
                    span= turno.usuario.nombre
                  p.mb-1
                    strong Email: 
                    span= turno.usuario.email

            hr

            if turno.profesional
              .row.mb-3
                .col-12
                  h5.h6.text-muted.text-uppercase Profesional
                  p.mb-1
                    strong Nombre: 
                    span= turno.profesional.nombre
                  p.mb-0
                    strong Especialidad: 
                    span= turno.profesional.especialidad

            hr

            h5.h6.text-muted.text-uppercase.mb-3 Acciones Disponibles
            .d-flex.gap-2.flex-wrap
              if turno.estado !== 'atendido'
                form(action=`/turnos/${turno.id}/estado` method="POST")
                  input(type="hidden" name="nuevoEstado" value="atendido")
                  button.btn.btn-success(type="submit") Marcar como Atendido

              if turno.estado !== 'cancelado'
                form(action=`/turnos/${turno.id}/estado` method="POST")
                  input(type="hidden" name="nuevoEstado" value="cancelado")
                  button.btn.btn-danger(type="submit") Cancelar Turno

              if turno.estado !== 'reservado'
                form(action=`/turnos/${turno.id}/estado` method="POST")
                  input(type="hidden" name="nuevoEstado" value="reservado")
                  button.btn.btn-secondary(type="submit") Reabrir Reserva

              a.btn.btn-outline-dark.ms-auto(href="/turnos") Volver al listado general

      else
        .alert.alert-warning.shadow-sm No se encontró la información del turno consultado.