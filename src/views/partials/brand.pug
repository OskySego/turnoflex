//- ============================================================
//- MARCA INSTITUCIONAL / LOGOTIPO COMPARTIDO - TURNOFLEX
//- ============================================================
//- Marca institucional reutilizada por páginas públicas y el layout interno[cite: 22].
//- Nota: La variable tfBrandHref debe definirse previamente en el archivo que incluye este componente[cite: 22].

a.tf-shared-brand(href=tfBrandHref aria-label='TurnoFlex - Ir al inicio')
  //- Isotipo gráfico principal de la marca
  span.tf-shared-brand__mark(aria-hidden='true') T
  
  //- Contenedor de la tipografía y subtítulo institucional
  span.tf-shared-brand__copy
    strong.tf-shared-brand__name TurnoFlex
    small.tf-shared-brand__subtitle GESTIÓN MÉDICA INTELIGENTE