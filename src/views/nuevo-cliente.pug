//- ============================================================
//- VISTA DE ALTA DE NUEVO PACIENTE - TURNOFLEX
//- ============================================================
//- Plantilla para registrar un paciente nuevo en el sistema.
//- Organizo la carga en tres pasos (identificación, contacto/domicilio
//- y cobertura médica) con validación y despliegue dinámico de obra social.

extends layout

block content

  
  //- ============================================================
  //- 2. ESTRUCTURA PRINCIPAL DE LA PÁGINA
  //- ============================================================

  .new-patient-page.tfu-page

    //- Cabecera visual de presentación
    .new-patient-hero.tfu-hero
      .new-patient-hero-content
        .row.align-items-center.g-4
          .col-lg-8
            .d-flex.align-items-center.gap-3
              .new-patient-icon
                | 👤
              div
                .new-patient-eyebrow
                  | ◆ TurnoFlex · Gestión de pacientes
                h1.new-patient-title
                  | Registrar nuevo paciente
                p.new-patient-description
                  | Incorporá un nuevo paciente al sistema y centralizá
                  | sus datos personales, contacto, domicilio y cobertura médica.
          .col-lg-4
            .d-flex.justify-content-lg-end
              .new-patient-status
                span.new-patient-status-dot
                span
                  | Nuevo registro

    //- Guía visual de los 3 pasos del alta
    .patient-steps
      .patient-step
        .patient-step-number
          | 01
        div
          .patient-step-title
            | Identificación
          .patient-step-text
            | Datos personales

      .patient-step
        .patient-step-number
          | 02
        div
          .patient-step-title
            | Contacto
          .patient-step-text
            | Comunicación y domicilio

      .patient-step
        .patient-step-number
          | 03
        div
          .patient-step-title
            | Cobertura
          .patient-step-text
            | Particular u obra social


    //- ==========================================================
    //- 3. FORMULARIO DE ALTA DE PACIENTE
    //- ==========================================================

    form.new-patient-form.tfu-card(action="/clientes" method="POST" id="formNuevoPaciente")
      //- Incluyo el token CSRF si el servidor lo envió
      if typeof csrfToken !== "undefined" && csrfToken
        input(type="hidden" name="_csrf" value=csrfToken)

      //- --------------------------------------------------------
      //- PASO 1: DATOS PERSONALES E IDENTIFICATORIOS
      //- --------------------------------------------------------
      .form-section
        .form-section-header
          .form-section-icon
            | 🪪
          div
            .form-section-label
              | Paso 1
            h4.form-section-title
              | Datos personales e identificatorios

        .row.g-4
          .col-md-6
            label.patient-form-label(for="nombre")
              | Nombre y apellido
              span.required-mark
                |  *
            input.form-control.patient-control(type="text" id="nombre" name="nombre" placeholder="Tal como figura en el DNI" autocomplete="name" required)
            .field-help
              | Ingresá el nombre completo del paciente.

          .col-md-6
            label.patient-form-label(for="dni")
              | DNI / Cédula / Pasaporte
              span.required-mark
                |  *
            input.form-control.patient-control(type="text" id="dni" name="dni" placeholder="Número de documento" autocomplete="off" required)
            .field-help
              | Documento utilizado para identificar al paciente.

          .col-md-6
            label.patient-form-label(for="fechaNacimiento")
              | Fecha de nacimiento
            input.form-control.patient-control(type="date" id="fechaNacimiento" name="fechaNacimiento")

          .col-md-6
            label.patient-form-label(for="genero")
              | Género
            select.form-select.patient-control(id="genero" name="genero")
              option(value="")
                | Seleccionar...
              option(value="Masculino")
                | Masculino
              option(value="Femenino")
                | Femenino
              option(value="Otro")
                | Otro

      //- --------------------------------------------------------
      //- PASO 2: CONTACTO Y DOMICILIO
      //- --------------------------------------------------------
      .form-section
        .form-section-header
          .form-section-icon
            | 📱
          div
            .form-section-label
              | Paso 2
            h4.form-section-title
              | Contacto y domicilio

        .row.g-4
          .col-md-6
            label.patient-form-label(for="telefono")
              | Teléfono / WhatsApp
              span.required-mark
                |  *
            input.form-control.patient-control(type="text" id="telefono" name="telefono" placeholder="Ej: 1155443322" autocomplete="tel" required)
            .field-help
              | Número principal para comunicaciones y recordatorios.

          .col-md-6
            label.patient-form-label(for="email")
              | Correo electrónico
              span.required-mark
                |  *
            input.form-control.patient-control(type="email" id="email" name="email" placeholder="paciente@correo.com" autocomplete="email" required)
            .field-help
              | También puede utilizarse para vincular el portal del paciente.

          .col-md-6
            label.patient-form-label(for="calle")
              | Calle
            input.form-control.patient-control(type="text" id="calle" name="calle" placeholder="Ej: Av. Rivadavia" autocomplete="address-line1")

          .col-md-6
            label.patient-form-label(for="numero")
              | Número
            input.form-control.patient-control(type="text" id="numero" name="numero" placeholder="Ej: 1234" autocomplete="address-line2")

          .col-md-6
            label.patient-form-label(for="localidad")
              | Localidad
            input.form-control.patient-control(type="text" id="localidad" name="localidad" placeholder="Ej: Morón" autocomplete="address-level2")

          .col-md-6
            label.patient-form-label(for="provincia")
              | Provincia
            input.form-control.patient-control(type="text" id="provincia" name="provincia" placeholder="Ej: Buenos Aires" autocomplete="address-level1")

      //- --------------------------------------------------------
      //- PASO 3: TIPO DE ATENCIÓN Y COBERTURA MÉDICA
      //- --------------------------------------------------------
      .form-section
        .form-section-header
          .form-section-icon
            | 🏥
          div
            .form-section-label
              | Paso 3
            h4.form-section-title
              | Tipo de atención y cobertura

        //- Selector visual entre atención particular y obra social
        .care-option-container
          .care-option
            input.care-radio(type="radio" id="atencionParticular" name="tipoAtencion" value="particular" checked)
            label.care-label(for="atencionParticular")
              .care-icon
                | 💵
              .care-title
                | Paciente particular
              p.care-text
                | El paciente no utiliza una obra social o prepaga para la atención.

          .care-option
            input.care-radio(type="radio" id="atencionObraSocial" name="tipoAtencion" value="obra_social")
            label.care-label(for="atencionObraSocial")
              .care-icon
                | 🏥
              .care-title
                | Obra social / Prepaga
              p.care-text
                | Registrá empresa, número de afiliado y plan médico.

        //- Panel dinámico que muestro únicamente cuando se elige obra social
        #seccionObraSocial
          h5.coverage-title
            | Datos de cobertura médica
          p.coverage-description
            | Completá la información que figura en la credencial del paciente.

          .row.g-3
            .col-md-4
              label.patient-form-label(for="empresa")
                | Empresa / Prepaga
              input.form-control.patient-control(type="text" id="empresa" name="empresa" placeholder="Ej: OSDE")

            .col-md-4
              label.patient-form-label(for="numeroAfiliado")
                | Número de afiliado
              input.form-control.patient-control(type="text" id="numeroAfiliado" name="numeroAfiliado" placeholder="N.º de credencial")

            .col-md-4
              label.patient-form-label(for="plan")
                | Plan médico
              input.form-control.patient-control(type="text" id="plan" name="plan" placeholder="Ej: 210, 310, PMO")

        .patient-tip
          h6.patient-tip-title
            | ℹ️ Información de cobertura
          p.patient-tip-text
            | Si el paciente es particular, los datos de obra social
            | se guardarán vacíos. Si posee cobertura, verificá especialmente
            | el número de afiliado antes de confirmar el registro.

      //- Botones inferiores del formulario
      .form-actions
        a.cancel-patient-btn(href="/clientes")
          | Cancelar
        button.save-patient-btn(type="submit" id="btnGuardarPaciente")
          span#iconGuardarPaciente
            | ✓
          span#textoGuardarPaciente
            | Registrar paciente


  //- ============================================================
  //- 4. LÓGICA JAVASCRIPT DEL FORMULARIO
  //- ============================================================

  script.
    document.addEventListener('DOMContentLoaded', function () {
      // Capturo las referencias de los inputs, contenedores y botones del formulario
      const particular = document.getElementById('atencionParticular');
      const obraSocial = document.getElementById('atencionObraSocial');
      const seccion = document.getElementById('seccionObraSocial');
      const empresa = document.getElementById('empresa');
      const numeroAfiliado = document.getElementById('numeroAfiliado');
      const plan = document.getElementById('plan');
      const fechaNacimiento = document.getElementById('fechaNacimiento');
      const formulario = document.getElementById('formNuevoPaciente');
      const boton = document.getElementById('btnGuardarPaciente');
      const textoBoton = document.getElementById('textoGuardarPaciente');
      const iconoBoton = document.getElementById('iconGuardarPaciente');

      // Bloqueo fechas de nacimiento futuras estableciendo hoy como máximo
      if (fechaNacimiento) {
        const hoy = new Date();
        const anio = hoy.getFullYear();
        const mes = String(hoy.getMonth() + 1).padStart(2, '0');
        const dia = String(hoy.getDate()).padStart(2, '0');
        fechaNacimiento.max = anio + '-' + mes + '-' + dia;
      }

      // Muestro los campos de obra social si corresponde; si vuelve a particular, los limpio y oculto
      function actualizarCobertura() {
        if (obraSocial && obraSocial.checked) {
          seccion.style.display = 'block';
          if (empresa) {
            empresa.required = true;
          }
        } else {
          seccion.style.display = 'none';
          if (empresa) {
            empresa.required = false;
            empresa.value = '';
          }
          if (numeroAfiliado) {
            numeroAfiliado.value = '';
          }
          if (plan) {
            plan.value = '';
          }
        }
      }

      if (particular) {
        particular.addEventListener('change', actualizarCobertura);
      }

      if (obraSocial) {
        obraSocial.addEventListener('change', actualizarCobertura);
      }

      actualizarCobertura();

      // Evito envíos duplicados deshabilitando el botón y mostrando feedback de carga
      if (formulario) {
        formulario.addEventListener('submit', function () {
          if (!formulario.checkValidity()) {
            return;
          }
          if (boton) {
            boton.disabled = true;
          }
          if (iconoBoton) {
            iconoBoton.textContent = '◷';
          }
          if (textoBoton) {
            textoBoton.textContent = 'Registrando paciente...';
          }
        });
      }
    });