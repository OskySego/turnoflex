extends layout

block content

  style.
    .new-patient-page {
      --np-navy: #0d1b3e;
      --np-blue: #2563eb;
      --np-violet: #8b5cf6;
      --np-green: #10b981;
      --np-yellow: #f59e0b;
      --np-red: #ef4444;

      --np-surface: #ffffff;
      --np-soft: #f8fafc;
      --np-text: #0f172a;
      --np-muted: #64748b;
      --np-border: rgba(15, 23, 42, .08);

      color: var(--np-text);
    }

    [data-bs-theme="dark"] .new-patient-page {
      --np-surface: #171d27;
      --np-soft: #111827;
      --np-text: #f8fafc;
      --np-muted: #94a3b8;
      --np-border: rgba(255,255,255,.08);
    }


    /* ==========================================================
       HERO
       ========================================================== */

    .new-patient-hero {
      position: relative;
      overflow: hidden;

      padding: 32px;

      border-radius: 28px;

      color: #ffffff;

      background:
        radial-gradient(
          circle at 90% 0%,
          rgba(139,92,246,.50),
          transparent 33%
        ),
        radial-gradient(
          circle at 8% 100%,
          rgba(37,99,235,.28),
          transparent 36%
        ),
        linear-gradient(
          135deg,
          #08132e 0%,
          #10245d 52%,
          #312e81 100%
        );

      box-shadow:
        0 23px 54px rgba(15,23,42,.21);
    }

    .new-patient-hero::after {
      content: "";

      position: absolute;

      width: 330px;
      height: 330px;

      right: -165px;
      bottom: -205px;

      border-radius: 50%;

      background:
        rgba(255,255,255,.07);
    }

    .new-patient-hero-content {
      position: relative;
      z-index: 2;
    }

    .new-patient-icon {
      width: 68px;
      height: 68px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 20px;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #8b5cf6
        );

      border:
        1px solid rgba(255,255,255,.22);

      box-shadow:
        0 13px 30px rgba(0,0,0,.17);

      font-size: 1.55rem;
    }

    .new-patient-eyebrow {
      margin-bottom: 5px;

      color:
        rgba(255,255,255,.63);

      font-size: .68rem;

      font-weight: 850;

      text-transform: uppercase;

      letter-spacing: .14em;
    }

    .new-patient-title {
      margin-bottom: 6px;

      font-size:
        clamp(1.8rem,4vw,2.5rem);

      font-weight: 900;

      letter-spacing: -.04em;
    }

    .new-patient-description {
      max-width: 650px;

      margin-bottom: 0;

      color:
        rgba(255,255,255,.73);

      font-size: .83rem;

      line-height: 1.6;
    }

    .new-patient-status {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding: 9px 14px;

      border-radius: 999px;

      background:
        rgba(255,255,255,.10);

      border:
        1px solid rgba(255,255,255,.16);

      font-size: .75rem;

      font-weight: 800;
    }

    .new-patient-status-dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;

      background: #34d399;

      box-shadow:
        0 0 0 5px rgba(52,211,153,.12);
    }


    /* ==========================================================
       PASOS
       ========================================================== */

    .patient-steps {
      display: grid;

      grid-template-columns:
        repeat(3,minmax(0,1fr));

      gap: 10px;

      margin-top: 24px;
    }

    .patient-step {
      display: flex;

      align-items: center;

      gap: 10px;

      padding: 13px 14px;

      border-radius: 14px;

      background:
        var(--np-surface);

      border:
        1px solid var(--np-border);

      box-shadow:
        0 8px 24px rgba(15,23,42,.04);
    }

    .patient-step-number {
      width: 31px;
      height: 31px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 10px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          var(--np-blue),
          var(--np-violet)
        );

      font-size: .72rem;

      font-weight: 900;
    }

    .patient-step-title {
      color:
        var(--np-text);

      font-size: .72rem;

      font-weight: 850;
    }

    .patient-step-text {
      color:
        var(--np-muted);

      font-size: .62rem;
    }


    /* ==========================================================
       FORMULARIO
       ========================================================== */

    .new-patient-form {
      margin-top: 24px;

      padding: 27px;

      border-radius: 24px;

      background:
        var(--np-surface);

      border:
        1px solid var(--np-border);

      box-shadow:
        0 13px 35px rgba(15,23,42,.06);
    }

    .form-section {
      padding-bottom: 27px;

      margin-bottom: 27px;

      border-bottom:
        1px solid var(--np-border);
    }

    .form-section:last-of-type {
      margin-bottom: 0;

      border-bottom: 0;
    }

    .form-section-header {
      display: flex;

      align-items: center;

      gap: 12px;

      margin-bottom: 20px;
    }

    .form-section-icon {
      width: 43px;
      height: 43px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.11),
          rgba(139,92,246,.14)
        );

      font-size: 1.15rem;
    }

    .form-section-label {
      margin-bottom: 2px;

      color:
        var(--np-violet);

      font-size: .62rem;

      font-weight: 850;

      text-transform: uppercase;

      letter-spacing: .10em;
    }

    .form-section-title {
      margin-bottom: 0;

      color:
        var(--np-text);

      font-size: 1rem;

      font-weight: 900;
    }

    .patient-form-label {
      margin-bottom: 7px;

      color:
        var(--np-text);

      font-size: .72rem;

      font-weight: 800;
    }

    .required-mark {
      color:
        var(--np-red);
    }

    .patient-control {
      min-height: 47px;

      border-radius: 12px;

      color:
        var(--np-text);

      background:
        var(--np-soft);

      border:
        1px solid var(--np-border);

      font-size: .78rem;

      transition:
        border-color .2s ease,
        box-shadow .2s ease;
    }

    .patient-control:focus {
      color:
        var(--np-text);

      background:
        var(--np-surface);

      border-color:
        var(--np-violet);

      box-shadow:
        0 0 0 4px rgba(139,92,246,.10);
    }

    .patient-control::placeholder {
      color:
        var(--np-muted);

      opacity: .7;
    }

    .field-help {
      margin-top: 5px;

      color:
        var(--np-muted);

      font-size: .63rem;
    }


    /* ==========================================================
       TIPO DE ATENCIÓN
       ========================================================== */

    .care-option-container {
      display: grid;

      grid-template-columns:
        repeat(2,minmax(0,1fr));

      gap: 12px;
    }

    .care-option {
      position: relative;
    }

    .care-radio {
      position: absolute;

      opacity: 0;

      pointer-events: none;
    }

    .care-label {
      display: block;

      height: 100%;

      padding: 17px;

      border-radius: 16px;

      cursor: pointer;

      background:
        var(--np-soft);

      border:
        1px solid var(--np-border);

      transition:
        .2s ease;
    }

    .care-label:hover {
      transform:
        translateY(-2px);

      border-color:
        rgba(139,92,246,.30);
    }

    .care-radio:checked + .care-label {
      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.07),
          rgba(139,92,246,.12)
        );

      border-color:
        rgba(139,92,246,.38);

      box-shadow:
        0 0 0 3px rgba(139,92,246,.07);
    }

    .care-icon {
      width: 38px;
      height: 38px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 10px;

      border-radius: 11px;

      background:
        rgba(139,92,246,.10);
    }

    .care-title {
      margin-bottom: 3px;

      color:
        var(--np-text);

      font-size: .8rem;

      font-weight: 850;
    }

    .care-text {
      margin-bottom: 0;

      color:
        var(--np-muted);

      font-size: .65rem;

      line-height: 1.45;
    }


    /* ==========================================================
       COBERTURA
       ========================================================== */

    #seccionObraSocial {
      display: none;

      margin-top: 19px;

      padding: 20px;

      border-radius: 17px;

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.05),
          rgba(139,92,246,.08)
        );

      border:
        1px solid rgba(139,92,246,.12);
    }

    .coverage-title {
      margin-bottom: 4px;

      color:
        var(--np-text);

      font-size: .85rem;

      font-weight: 900;
    }

    .coverage-description {
      margin-bottom: 17px;

      color:
        var(--np-muted);

      font-size: .68rem;
    }


    /* ==========================================================
       RESUMEN LATERAL
       ========================================================== */

    .patient-tip {
      margin-top: 24px;

      padding: 19px;

      border-radius: 18px;

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.06),
          rgba(139,92,246,.09)
        );

      border:
        1px solid rgba(139,92,246,.12);
    }

    .patient-tip-title {
      margin-bottom: 6px;

      color:
        var(--np-text);

      font-size: .78rem;

      font-weight: 900;
    }

    .patient-tip-text {
      margin-bottom: 0;

      color:
        var(--np-muted);

      font-size: .67rem;

      line-height: 1.55;
    }


    /* ==========================================================
       BOTONES
       ========================================================== */

    .form-actions {
      display: flex;

      justify-content: flex-end;

      align-items: center;

      gap: 10px;

      flex-wrap: wrap;

      padding-top: 5px;
    }

    .cancel-patient-btn {
      min-height: 45px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      padding: 0 18px;

      border-radius: 12px;

      color:
        var(--np-muted);

      background:
        var(--np-soft);

      border:
        1px solid var(--np-border);

      text-decoration: none;

      font-size: .75rem;

      font-weight: 800;
    }

    .cancel-patient-btn:hover {
      color:
        var(--np-text);
    }

    .save-patient-btn {
      min-height: 45px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 7px;

      padding: 0 20px;

      border: 0;

      border-radius: 12px;

      color: #ffffff;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #8b5cf6
        );

      box-shadow:
        0 10px 24px rgba(139,92,246,.20);

      font-size: .75rem;

      font-weight: 850;

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .save-patient-btn:hover {
      transform:
        translateY(-2px);

      box-shadow:
        0 14px 30px rgba(139,92,246,.27);
    }

    .save-patient-btn:disabled {
      opacity: .65;

      transform: none;

      cursor: wait;
    }


    /* ==========================================================
       RESPONSIVE
       ========================================================== */

    @media (max-width: 767px) {

      .new-patient-hero {
        padding: 24px;
      }

      .new-patient-icon {
        width: 58px;
        height: 58px;
      }

      .new-patient-form {
        padding: 20px;
      }

      .patient-steps {
        grid-template-columns: 1fr;
      }

      .care-option-container {
        grid-template-columns: 1fr;
      }

      .form-actions {
        flex-direction: column-reverse;
      }

      .form-actions > * {
        width: 100%;
      }
    }


  //- ============================================================
  //- CONTENIDO
  //- ============================================================

  .new-patient-page.tfu-page


    //- ==========================================================
    //- HERO
    //- ==========================================================

    .new-patient-hero.tfu-hero

      .new-patient-hero-content

        .row.align-items-center.g-4

          .col-lg-8

            .d-flex.align-items-center.gap-3

              .new-patient-icon
                | 👤

              div

                .new-patient-eyebrow
                  | ◆ TurnoFlex · Gestión de pacientes

                h1.new-patient-title
                  | Registrar nuevo paciente

                p.new-patient-description
                  | Incorporá un nuevo paciente al sistema y centralizá
                  | sus datos personales, contacto, domicilio y cobertura médica.


          .col-lg-4

            .d-flex.justify-content-lg-end

              .new-patient-status

                span.new-patient-status-dot

                span
                  | Nuevo registro


    //- ==========================================================
    //- PASOS
    //- ==========================================================

    .patient-steps

      .patient-step

        .patient-step-number
          | 01

        div

          .patient-step-title
            | Identificación

          .patient-step-text
            | Datos personales


      .patient-step

        .patient-step-number
          | 02

        div

          .patient-step-title
            | Contacto

          .patient-step-text
            | Comunicación y domicilio


      .patient-step

        .patient-step-number
          | 03

        div

          .patient-step-title
            | Cobertura

          .patient-step-text
            | Particular u obra social


    //- ==========================================================
    //- FORMULARIO
    //- ==========================================================

    form.new-patient-form.tfu-card(
      action="/clientes"
      method="POST"
      id="formNuevoPaciente"
    )
      if typeof csrfToken !== "undefined" && csrfToken
        input(type="hidden" name="_csrf" value=csrfToken)


      //- ========================================================
      //- DATOS PERSONALES
      //- ========================================================

      .form-section

        .form-section-header

          .form-section-icon
            | 🪪

          div

            .form-section-label
              | Paso 1

            h4.form-section-title
              | Datos personales e identificatorios


        .row.g-4


          .col-md-6

            label.patient-form-label(
              for="nombre"
            )
              | Nombre y apellido
              span.required-mark
                |  *

            input.form-control.patient-control(
              type="text"
              id="nombre"
              name="nombre"
              placeholder="Tal como figura en el DNI"
              autocomplete="name"
              required
            )

            .field-help
              | Ingresá el nombre completo del paciente.


          .col-md-6

            label.patient-form-label(
              for="dni"
            )
              | DNI / Cédula / Pasaporte
              span.required-mark
                |  *

            input.form-control.patient-control(
              type="text"
              id="dni"
              name="dni"
              placeholder="Número de documento"
              autocomplete="off"
              required
            )

            .field-help
              | Documento utilizado para identificar al paciente.


          .col-md-6

            label.patient-form-label(
              for="fechaNacimiento"
            )
              | Fecha de nacimiento

            input.form-control.patient-control(
              type="date"
              id="fechaNacimiento"
              name="fechaNacimiento"
            )


          .col-md-6

            label.patient-form-label(
              for="genero"
            )
              | Género

            select.form-select.patient-control(
              id="genero"
              name="genero"
            )

              option(value="")
                | Seleccionar...

              option(value="Masculino")
                | Masculino

              option(value="Femenino")
                | Femenino

              option(value="Otro")
                | Otro


      //- ========================================================
      //- CONTACTO
      //- ========================================================

      .form-section

        .form-section-header

          .form-section-icon
            | 📱

          div

            .form-section-label
              | Paso 2

            h4.form-section-title
              | Contacto y domicilio


        .row.g-4


          .col-md-6

            label.patient-form-label(
              for="telefono"
            )
              | Teléfono / WhatsApp
              span.required-mark
                |  *

            input.form-control.patient-control(
              type="text"
              id="telefono"
              name="telefono"
              placeholder="Ej: 1155443322"
              autocomplete="tel"
              required
            )

            .field-help
              | Número principal para comunicaciones y recordatorios.


          .col-md-6

            label.patient-form-label(
              for="email"
            )
              | Correo electrónico
              span.required-mark
                |  *

            input.form-control.patient-control(
              type="email"
              id="email"
              name="email"
              placeholder="paciente@correo.com"
              autocomplete="email"
              required
            )

            .field-help
              | También puede utilizarse para vincular el portal del paciente.


          .col-md-6

            label.patient-form-label(
              for="calle"
            )
              | Calle

            input.form-control.patient-control(
              type="text"
              id="calle"
              name="calle"
              placeholder="Ej: Av. Rivadavia"
              autocomplete="address-line1"
            )


          .col-md-6

            label.patient-form-label(
              for="numero"
            )
              | Número

            input.form-control.patient-control(
              type="text"
              id="numero"
              name="numero"
              placeholder="Ej: 1234"
              autocomplete="address-line2"
            )


          .col-md-6

            label.patient-form-label(
              for="localidad"
            )
              | Localidad

            input.form-control.patient-control(
              type="text"
              id="localidad"
              name="localidad"
              placeholder="Ej: Morón"
              autocomplete="address-level2"
            )


          .col-md-6

            label.patient-form-label(
              for="provincia"
            )
              | Provincia

            input.form-control.patient-control(
              type="text"
              id="provincia"
              name="provincia"
              placeholder="Ej: Buenos Aires"
              autocomplete="address-level1"
            )


      //- ========================================================
      //- COBERTURA
      //- ========================================================

      .form-section

        .form-section-header

          .form-section-icon
            | 🏥

          div

            .form-section-label
              | Paso 3

            h4.form-section-title
              | Tipo de atención y cobertura


        .care-option-container


          //- PARTICULAR
          .care-option

            input.care-radio(
              type="radio"
              id="atencionParticular"
              name="tipoAtencion"
              value="particular"
              checked
            )

            label.care-label(
              for="atencionParticular"
            )

              .care-icon
                | 💵

              .care-title
                | Paciente particular

              p.care-text
                | El paciente no utiliza una obra social o prepaga para la atención.


          //- OBRA SOCIAL
          .care-option

            input.care-radio(
              type="radio"
              id="atencionObraSocial"
              name="tipoAtencion"
              value="obra_social"
            )

            label.care-label(
              for="atencionObraSocial"
            )

              .care-icon
                | 🏥

              .care-title
                | Obra social / Prepaga

              p.care-text
                | Registrá empresa, número de afiliado y plan médico.


        //- ======================================================
        //- DATOS DE COBERTURA
        //- ======================================================

        #seccionObraSocial

          h5.coverage-title
            | Datos de cobertura médica

          p.coverage-description
            | Completá la información que figura en la credencial del paciente.


          .row.g-3


            .col-md-4

              label.patient-form-label(
                for="empresa"
              )
                | Empresa / Prepaga

              input.form-control.patient-control(
                type="text"
                id="empresa"
                name="empresa"
                placeholder="Ej: OSDE"
              )


            .col-md-4

              label.patient-form-label(
                for="numeroAfiliado"
              )
                | Número de afiliado

              input.form-control.patient-control(
                type="text"
                id="numeroAfiliado"
                name="numeroAfiliado"
                placeholder="N.º de credencial"
              )


            .col-md-4

              label.patient-form-label(
                for="plan"
              )
                | Plan médico

              input.form-control.patient-control(
                type="text"
                id="plan"
                name="plan"
                placeholder="Ej: 210, 310, PMO"
              )


        .patient-tip

          h6.patient-tip-title
            | ℹ️ Información de cobertura

          p.patient-tip-text
            | Si el paciente es particular, los datos de obra social
            | se guardarán vacíos. Si posee cobertura, verificá especialmente
            | el número de afiliado antes de confirmar el registro.


      //- ========================================================
      //- ACCIONES
      //- ========================================================

      .form-actions

        a.cancel-patient-btn(
          href="/clientes"
        )
          | Cancelar

        button.save-patient-btn(
          type="submit"
          id="btnGuardarPaciente"
        )

          span#iconGuardarPaciente
            | ✓

          span#textoGuardarPaciente
            | Registrar paciente


  //- ============================================================
  //- JAVASCRIPT
  //- ============================================================

  script.
    document.addEventListener(
      'DOMContentLoaded',
      function () {

        const particular =
          document.getElementById(
            'atencionParticular'
          );

        const obraSocial =
          document.getElementById(
            'atencionObraSocial'
          );

        const seccion =
          document.getElementById(
            'seccionObraSocial'
          );

        const empresa =
          document.getElementById(
            'empresa'
          );

        const numeroAfiliado =
          document.getElementById(
            'numeroAfiliado'
          );

        const plan =
          document.getElementById(
            'plan'
          );

        const fechaNacimiento =
          document.getElementById(
            'fechaNacimiento'
          );

        const formulario =
          document.getElementById(
            'formNuevoPaciente'
          );

        const boton =
          document.getElementById(
            'btnGuardarPaciente'
          );

        const textoBoton =
          document.getElementById(
            'textoGuardarPaciente'
          );

        const iconoBoton =
          document.getElementById(
            'iconGuardarPaciente'
          );


        // ======================================================
        // FECHA MÁXIMA = HOY
        // ======================================================

        if (fechaNacimiento) {

          const hoy =
            new Date();

          const anio =
            hoy.getFullYear();

          const mes =
            String(
              hoy.getMonth() + 1
            ).padStart(
              2,
              '0'
            );

          const dia =
            String(
              hoy.getDate()
            ).padStart(
              2,
              '0'
            );

          fechaNacimiento.max =
            anio +
            '-' +
            mes +
            '-' +
            dia;

        }


        // ======================================================
        // MOSTRAR / OCULTAR OBRA SOCIAL
        // ======================================================

        function actualizarCobertura() {

          if (
            obraSocial &&
            obraSocial.checked
          ) {

            seccion.style.display =
              'block';


            if (empresa) {
              empresa.required = true;
            }

          } else {

            seccion.style.display =
              'none';


            if (empresa) {

              empresa.required = false;

              empresa.value = '';

            }


            if (numeroAfiliado) {
              numeroAfiliado.value = '';
            }


            if (plan) {
              plan.value = '';
            }

          }

        }


        if (particular) {

          particular.addEventListener(
            'change',
            actualizarCobertura
          );

        }


        if (obraSocial) {

          obraSocial.addEventListener(
            'change',
            actualizarCobertura
          );

        }


        actualizarCobertura();


        // ======================================================
        // ESTADO DE ENVÍO
        // ======================================================

        if (formulario) {

          formulario.addEventListener(
            'submit',
            function () {

              if (
                !formulario.checkValidity()
              ) {

                return;

              }


              if (boton) {

                boton.disabled =
                  true;

              }


              if (iconoBoton) {

                iconoBoton.textContent =
                  '◷';

              }


              if (textoBoton) {

                textoBoton.textContent =
                  'Registrando paciente...';

              }

            }
          );

        }

      }
    );