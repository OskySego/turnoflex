doctype html

html(lang="es" data-bs-theme="dark")

  head
    meta(charset="UTF-8")

    meta(
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    )

    meta(
      name="theme-color"
      content="#0D1B3E"
    )

    meta(
      name="description"
      content="TurnoFlex - Plataforma inteligente de gestión médica y turnos."
    )

    title= (typeof tituloPage !== 'undefined' && tituloPage) ? tituloPage + ' | TurnoFlex' : 'TurnoFlex - Gestión Médica'

    //- Token disponible únicamente si el servidor lo proporciona.
    if typeof csrfToken !== 'undefined' && csrfToken
      meta(name='csrf-token' content=csrfToken)

    //- UNICO CSS Y UNICO JS de TurnoFlex (el JS establece el tema antes de pintar).
    script(src='/js/turnoflex.js?v=1')


    //- ==========================================================
    //- BOOTSTRAP
    //- ==========================================================

    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    )
    //- Iconografia compartida con la bienvenida.
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    //- La hoja local siempre se carga DESPUES de Bootstrap.
    link(rel='stylesheet' href='/css/turnoflex.css?v=header1')


    //- ==========================================================
    //- PWA
    //- ==========================================================

    link(
      rel="manifest"
      href="/manifest.json"
    )


  body

    //- ==========================================================
    //- NOTIFICACIONES GLOBALES TURNOFLEX
    //- ==========================================================

    #tfToastStack.tf-toast-stack(
      aria-live="polite"
      aria-atomic="true"
    )

    //- ==========================================================
    //- NAVEGACIÓN
    //- ==========================================================

    nav.navbar.navbar-expand-lg.navbar-dark.tf-navbar

      .container


        //- ======================================================
        //- MARCA
        //- ======================================================

        - const tfBrandHref = '/'
        include partials/brand
        //- ======================================================
        //- BOTÓN MÓVIL
        //- ======================================================

        button.navbar-toggler(
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#tfMainNavigation"
          aria-controls="tfMainNavigation"
          aria-expanded="false"
          aria-label="Abrir navegación"
        )

          span.navbar-toggler-icon


        //- ======================================================
        //- CONTENIDO MENÚ
        //- ======================================================

        .collapse.navbar-collapse.tf-navbar-collapse#tfMainNavigation


          //- ====================================================
          //- ENLACES SEGÚN ROL
          //- ====================================================

          ul.navbar-nav.me-auto.mb-2.mb-lg-0.ms-lg-3.tf-nav-list


            if user


              //- =================================================
              //- ADMINISTRADOR
              //- =================================================

              if user.rol === 'admin'

                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/"
                    data-nav-path="/"
                  )
                    span
                      | ⌂

                    span
                      | Inicio


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/turnos"
                    data-nav-prefix="/turnos"
                  )
                    span
                      | 📅

                    span
                      | Turnos


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/profesionales"
                    data-nav-prefix="/profesionales"
                  )
                    span
                      | 🩺

                    span
                      | Profesionales


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/clientes"
                    data-nav-prefix="/clientes"
                  )
                    span
                      | 👥

                    span
                      | Pacientes


                li.nav-item

                  a.nav-link.tf-nav-link.tf-nav-link-admin(
                    href="/dashboard"
                    data-nav-prefix="/dashboard"
                  )
                    span
                      | ◈

                    span
                      | Intelligence


              //- =================================================
              //- RECEPCIÓN
              //- =================================================

              else if user.rol === 'personal'

                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/"
                    data-nav-path="/"
                  )
                    span
                      | ⌂

                    span
                      | Inicio


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/turnos"
                    data-nav-prefix="/turnos"
                  )
                    span
                      | 📅

                    span
                      | Turnos


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/turnos/nuevo"
                    data-nav-path="/turnos/nuevo"
                  )
                    span
                      | ＋

                    span
                      | Nuevo turno


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/clientes"
                    data-nav-prefix="/clientes"
                  )
                    span
                      | 👥

                    span
                      | Pacientes


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/profesionales"
                    data-nav-prefix="/profesionales"
                  )
                    span
                      | 🩺

                    span
                      | Profesionales


              //- =================================================
              //- PROFESIONAL
              //- =================================================

              else if user.rol === 'profesional'

                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/medico/agenda"
                    data-nav-prefix="/medico"
                  )
                    span
                      | 🩺

                    span
                      | Mi agenda


              //- =================================================
              //- PACIENTE
              //- =================================================

              else if user.rol === 'cliente'

                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/"
                    data-nav-path="/"
                  )
                    span
                      | ⌂

                    span
                      | Mi inicio


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/turnos/nuevo"
                    data-nav-path="/turnos/nuevo"
                  )
                    span
                      | ＋

                    span
                      | Solicitar turno


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/turnos"
                    data-nav-prefix="/turnos"
                  )
                    span
                      | 📅

                    span
                      | Mis turnos


                li.nav-item

                  a.nav-link.tf-nav-link(
                    href="/clientes/mi-perfil"
                    data-nav-path="/clientes/mi-perfil"
                  )
                    span
                      | 👤

                    span
                      | Mi perfil


          //- ====================================================
          //- USUARIO / TEMA / SALIDA
          //- ====================================================

          .tf-user-zone.ms-lg-auto


            if user

              .tf-user

                .tf-user-avatar#tfUserAvatar
                  | U

                div

                  span.tf-user-name
                    = user.nombre || 'Usuario'

                  span.tf-user-role

                    if user.rol === 'admin'
                      | Administrador

                    else if user.rol === 'personal'
                      | Recepción

                    else if user.rol === 'profesional'
                      | Profesional

                    else if user.rol === 'cliente'
                      | Paciente

                    else
                      = user.rol || 'Usuario'


              button.tf-theme-btn(data-theme-switch=true
                type="button"
                title="Cambiar tema"
                aria-label="Cambiar modo claro u oscuro"
              )

                span(data-theme-icon)
                  | ◐


              a.tf-logout-btn(
                href="/auth/logout"
                title="Cerrar sesión"
                aria-label="Cerrar sesión"
              )
                | ↗


            else

              a.tf-login-btn(
                href="/auth/login"
              )
                | Ingresar

              a.tf-register-btn(
                href="/auth/register"
              )
                | Crear cuenta

              button.tf-theme-btn(data-theme-switch=true
                type="button"
                title="Cambiar tema"
                aria-label="Cambiar modo claro u oscuro"
              )

                span(data-theme-icon)
                  | ◐


    //- ==========================================================
    //- CONTENIDO PRINCIPAL
    //- ==========================================================

    main.tf-main

      .container.tf-main-container

        block content


    //- ==========================================================
    //- FOOTER PREMIUM TURNOFLEX
    //- ==========================================================

    include partials/footer
    //- ==========================================================
    //- BOOTSTRAP JS
    //- ==========================================================

        //- BOOTSTRAP JAVASCRIPT LOCAL
    script(
      src="/vendor/bootstrap/js/bootstrap.bundle.min.js"
    )