doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{tituloPage || 'TurnoFlex - Gestión de Turnos'}
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
  body.bg-light
    header.bg-primary.text-white.py-3.mb-4.shadow-sm
      .container.d-flex.justify-content-between.align-items-center
        h1.h3.m-0 TurnoFlex
        span.badge.bg-light.text-primary Sistema de Gestión
    
    main.container
      block content

    footer.container.text-center.mt-5.py-3.border-top.text-muted
      p.small &copy; 2026 TurnoFlex - Los Claudestinos