extends layout

block content
  - const nombreRecepcion = user && user.nombre ? user.nombre : 'Recepción'

  .tf-reception.tfu-page
    section.rec-hero.tfu-hero(aria-label="Bienvenida de recepción")
      .rec-hero-inner
        .row.align-items-center.g-4
          .col-lg-8
            .rec-kicker ◈ TurnoFlex · Centro de recepción
            h1.rec-title Hola, #{nombreRecepcion}
            p.rec-desc
              | Tu jornada organizada. Gestioná pacientes, reservas y seguimientos
              |  desde un panel cómodo, claro y conectado con la agenda real.
            .d-flex.flex-wrap.gap-2.mt-4
              a.rec-hero-button(href="/turnos/nuevo")
                span(aria-hidden="true") ＋
                span Registrar nuevo turno
              a.rec-hero-subbtn(href="/clientes/nuevo") Nuevo paciente
          .col-lg-4
            .rec-date-card
              small Hoy en el consultorio
              .rec-hero-clock#recClock --:--
              .rec-hero-date#recDate Cargando fecha…
              .rec-online
                span.rec-dot#recSocketDot(aria-hidden="true")
                span#recSocketText Conectando eventos…
          //- Botón para abrir la sala de espera en pantalla completa
          .col-sm-6.col-xl-3
              a.rec-tool.tfu-card(href="/sala-espera" target="_blank" style="--tool:#0284c7;--tool-soft:rgba(2,132,199,.11)")
                span.rec-tool-icon(aria-hidden="true") 🖥️
                span
                  strong Sala de espera
                  small Abrir monitor de pantalla

    section(aria-labelledby="recActionsTitle")
      .rec-section-head
        .rec-eyebrow Accesos directos
        h2#recActionsTitle Todo lo que necesitás
        p Las herramientas habituales, a un clic.
      .row.g-3
        .col-sm-6.col-xl-3
          a.rec-tool.tfu-card(href="/turnos/nuevo" style="--tool:#5e60eb;--tool-soft:rgba(94,96,235,.11)")
            span.rec-tool-icon(aria-hidden="true") ＋
            span
              strong Nuevo turno
              small Agendar una consulta médica
        .col-sm-6.col-xl-3
          a.rec-tool.tfu-card(href="/turnos" style="--tool:#8b5cf6;--tool-soft:rgba(139,92,246,.11)")
            span.rec-tool-icon(aria-hidden="true") 📅
            span
              strong Agenda completa
              small Consultar todas las reservas
        .col-sm-6.col-xl-3
          a.rec-tool.tfu-card(href="/clientes" style="--tool:#0891b2;--tool-soft:rgba(6,182,212,.11)")
            span.rec-tool-icon(aria-hidden="true") 👥
            span
              strong Pacientes
              small Buscar y administrar pacientes
        .col-sm-6.col-xl-3
          a.rec-tool.tfu-card(href="/profesionales" style="--tool:#0d9e71;--tool-soft:rgba(16,185,129,.11)")
            span.rec-tool-icon(aria-hidden="true") 🩺
            span
              strong Profesionales
              small Consultar equipo y disponibilidad

    section(aria-labelledby="recStatsTitle")
      .rec-section-head
        .rec-eyebrow Resumen diario · Datos reales
        h2#recStatsTitle La jornada en números
        p Actualizado según la fecha seleccionada en la agenda.
      .row.g-3
        .col-6.col-lg
          .rec-stat.tfu-card(style="--stat-color:#8b5cf6")
            span.rec-stat-label Turnos del día
            .rec-stat-value#recStatTotal —
            span.rec-stat-small Total de reservas
            .rec-stat-rule
        .col-6.col-lg
          .rec-stat.tfu-card(style="--stat-color:#4d73ec")
            span.rec-stat-label Reservados
            .rec-stat-value#recStatReservado —
            span.rec-stat-small Citas confirmadas
            .rec-stat-rule
        .col-6.col-lg
          .rec-stat.tfu-card(style="--stat-color:#f59e0b")
            span.rec-stat-label Pago no completo
            .rec-stat-value#recStatPagos —
            span.rec-stat-small Excluye cancelados
            .rec-stat-rule
        .col-6.col-lg
          .rec-stat.tfu-card(style="--stat-color:#10b981")
            span.rec-stat-label Atendidos
            .rec-stat-value#recStatAtendidos —
            span.rec-stat-small Consultas realizadas
            .rec-stat-rule
        .col-6.col-lg
          .rec-stat.tfu-card(style="--stat-color:#ef4444")
            span.rec-stat-label Cancelados
            .rec-stat-value#recStatCancelados —
            span.rec-stat-small Turnos anulados
            .rec-stat-rule

    section(aria-labelledby="recAgendaTitle")
      .rec-section-head
        .rec-eyebrow Agenda inteligente
        h2#recAgendaTitle El día, de un vistazo
        p Cambiá de fecha, buscá por paciente o profesional y abrí cada detalle.
      .row.g-4
        .col-xl-8
          .rec-panel.tfu-card
            .rec-panel-head.d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
              div
                h3.rec-panel-title Agenda de la jornada
                p.rec-panel-description#recAgendaDate Seleccioná una fecha para ver los turnos.
              button.rec-icon-btn#recRefresh(type="button" aria-label="Actualizar agenda") ↻ Actualizar
            .rec-filter-bar
              button.rec-icon-btn#recPrev(type="button" aria-label="Día anterior") ←
              label.visually-hidden(for="recPickDate") Fecha de la agenda
              input.rec-input.rec-date-input#recPickDate(type="date")
              button.rec-icon-btn#recNext(type="button" aria-label="Día siguiente") →
              button.rec-icon-btn#recToday(type="button") Hoy
            .rec-filter-bar
              label.visually-hidden(for="recSearch") Buscar en los turnos de la fecha
              input.rec-input.rec-search#recSearch(type="search" placeholder="Buscar paciente, profesional o especialidad" autocomplete="off")
              label.visually-hidden(for="recFilterStatus") Estado del turno
              select.rec-select#recFilterStatus
                option(value="todos") Todos los estados
                option(value="reservado") Reservados
                option(value="pendiente_pago") Pendientes de pago
                option(value="En Espera") En espera
                option(value="atendido") Atendidos
                option(value="cancelado") Cancelados
            .rec-list-meta
              span#recListCount(role="status" aria-live="polite") Cargando agenda…
              span Horario de Buenos Aires
            #recAppointments.rec-appointments(aria-live="polite" aria-busy="true")
              .rec-empty
                .rec-empty-symbol(aria-hidden="true") ◷
                strong Preparando la agenda
                p Consultando los turnos registrados.
            .rec-list-meta
              span#recLimitInfo
              a(href="/turnos") Abrir agenda completa →
        .col-xl-4
          .rec-panel.tfu-card
            .rec-panel-head
              h3.rec-panel-title Organización de recepción
              p.rec-panel-description Un flujo sencillo para cada jornada.
            .rec-side-body
              .rec-flow-step
                span.rec-step-num 01
                div
                  strong Revisar los turnos
                  p Consultá horarios, profesionales y pacientes programados.
              .rec-flow-step
                span.rec-step-num 02
                div
                  strong Registrar las llegadas
                  p Abrí el detalle del turno para actualizarlo cuando corresponda.
              .rec-flow-step
                span.rec-step-num 03
                div
                  strong Controlar pagos
                  p Revisá el estado del cobro antes de cerrar cada atención.
              .rec-flow-step
                span.rec-step-num 04
                div
                  strong Mantener la agenda al día
                  p Actualizá la información ante nuevas reservas o cancelaciones.
          .rec-realtime
            h3 ⚡ Actividad en tiempo real
            p Las novedades de agenda llegan desde TurnoFlex mientras la sesión esté conectada.
            .rec-realtime-state
              span.rec-dot#recSocketDotSide(aria-hidden="true")
              span#recSocketTextSide Esperando conexión…
            .rec-live-message#recLiveAlert(role="status" aria-live="polite")

    //- Se conserva el acceso al QR institucional por eventos Socket.IO del proyecto.
    section.rec-wa#whatsappBox(aria-label="Conexión institucional de WhatsApp")
      h3.rec-panel-title.mb-2 📱 Conectar WhatsApp
      p.rec-panel-description Escaneá el código desde el celular institucional.
      img#qrImage(src="" alt="Código QR para vincular WhatsApp" style="display:none")
      #whatsappSuccess.alert.alert-success.mt-3.mb-0 WhatsApp vinculado correctamente.

    footer.rec-footer.d-flex.justify-content-between.flex-wrap.gap-2
      span TurnoFlex · Centro de recepción
      span Agenda conectada · Gestión médica inteligente

  script(src="/socket.io/socket.io.js")
  script.
    (function () {
      'use strict';
      const $ = id => document.getElementById(id);
      const timeZone = 'America/Argentina/Buenos_Aires';
      let fechaActual = '';
      let lista = [];
      let cantidadTotal = 0;
      let fetchVersion = 0;
      let timerAviso;

      function fechaBA() {
        const p = new Intl.DateTimeFormat('en-US', {
          timeZone, year: 'numeric', month: '2-digit', day: '2-digit'
        }).formatToParts(new Date());
        const get = type => p.find(i => i.type === type).value;
        return get('year') + '-' + get('month') + '-' + get('day');
      }
      function moverFecha(fecha, dias) {
        const d = new Date(fecha + 'T12:00:00Z');
        d.setUTCDate(d.getUTCDate() + dias);
        return d.toISOString().slice(0, 10);
      }
      function actualizarReloj() {
        const ahora = new Date();
        $('recClock').textContent = ahora.toLocaleTimeString('es-AR', {
          timeZone, hour: '2-digit', minute: '2-digit'
        });
        $('recDate').textContent = ahora.toLocaleDateString('es-AR', {
          timeZone, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
        });
      }
      function fechaLarga(fecha) {
        return new Date(fecha + 'T12:00:00Z').toLocaleDateString('es-AR', {
          timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
        });
      }
      function crearElemento(tag, cls, texto) {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (texto !== undefined) node.textContent = String(texto);
        return node;
      }
      function mostrarVacio(titulo, mensaje) {
        const cont = $('recAppointments');
        cont.replaceChildren();
        const empty = crearElemento('div', 'rec-empty');
        const symbol = crearElemento('div', 'rec-empty-symbol', '◷');
        symbol.setAttribute('aria-hidden', 'true');
        empty.append(symbol, crearElemento('strong', '', titulo), crearElemento('p', '', mensaje));
        cont.append(empty);
        cont.setAttribute('aria-busy', 'false');
      }
      function estadoTexto(estado) {
        return ({ reservado: 'Reservado', pendiente_pago: 'Pendiente de pago',
          atendido: 'Atendido', cancelado: 'Cancelado', 'En Espera': 'En espera'
        })[estado] || estado;
      }
      function renderAgenda() {
        const buscar = $('recSearch').value.trim().toLocaleLowerCase('es-AR');
        const estado = $('recFilterStatus').value;
        const resultado = lista.filter(t => {
          if (estado !== 'todos' && t.estado !== estado) return false;
          const texto = [t.paciente, t.profesional, t.especialidad].join(' ').toLocaleLowerCase('es-AR');
          return texto.includes(buscar);
        });
        const cont = $('recAppointments');
        cont.replaceChildren();
        if (!resultado.length) {
          mostrarVacio('No hay turnos para mostrar',
            lista.length ? 'Probá con otra búsqueda o un filtro distinto.' : 'No hay turnos registrados en esta fecha.');
        } else {
          const fragment = document.createDocumentFragment();
          resultado.forEach(t => {
            const item = crearElemento('div', 'rec-item');
            const hora = crearElemento('span', 'rec-item-time', t.hora);
            const paciente = crearElemento('div', 'rec-item-primary');
            paciente.append(crearElemento('strong', '', t.paciente),
              crearElemento('small', '', t.estadoPago === 'total_pagado' ? 'Pago completo' : 'Pago sin completar'));
            const profesional = crearElemento('div', 'rec-item-primary rec-professional');
            profesional.append(crearElemento('strong', '', t.profesional),
              crearElemento('small', '', t.especialidad || t.modalidad));
            const pill = crearElemento('span', 'rec-pill', estadoTexto(t.estado));
            pill.dataset.status = t.estado;
            const link = crearElemento('a', 'rec-detail', 'Ver detalle →');
            link.href = '/turnos/' + encodeURIComponent(t.id);
            link.setAttribute('aria-label', 'Abrir detalle del turno de ' + t.paciente);
            item.append(hora, paciente, profesional, pill, link);
            fragment.append(item);
          });
          cont.append(fragment);
          cont.setAttribute('aria-busy', 'false');
        }
        $('recListCount').textContent = 'Mostrando ' + resultado.length + ' de ' + cantidadTotal + ' turnos';
      }
      function ponerNumero(id, n) { $(id).textContent = Number(n || 0).toLocaleString('es-AR'); }
      async function cargarAgenda() {
        const version = ++fetchVersion;
        $('recAppointments').setAttribute('aria-busy', 'true');
        $('recListCount').textContent = 'Consultando agenda…';
        $('recAgendaDate').textContent = fechaLarga(fechaActual);
        try {
          const response = await fetch('/api/recepcion/resumen?fecha=' + encodeURIComponent(fechaActual), {
            credentials: 'same-origin', cache: 'no-store', headers: { Accept: 'application/json' }
          });
          if (!response.ok) throw new Error(response.status === 401 || response.status === 403
            ? 'La sesión no permite consultar la agenda.' : 'No se pudo obtener la agenda.');
          const data = await response.json();
          if (version !== fetchVersion) return;
          lista = Array.isArray(data.turnos) ? data.turnos : [];
          cantidadTotal = Number(data.total || 0);
          ponerNumero('recStatTotal', data.total);
          ponerNumero('recStatReservado', data.resumen?.reservado);
          ponerNumero('recStatPagos', data.resumen?.pagosSinCompletar);
          ponerNumero('recStatAtendidos', data.resumen?.atendido);
          ponerNumero('recStatCancelados', data.resumen?.cancelado);
          $('recLimitInfo').textContent = cantidadTotal > lista.length
            ? 'Se muestran los primeros ' + lista.length + ' turnos. Para consultar el resto, abrí la agenda completa.' : '';
          renderAgenda();
        } catch (error) {
          if (version !== fetchVersion) return;
          lista = [];
          cantidadTotal = 0;
          ['recStatTotal','recStatReservado','recStatPagos','recStatAtendidos','recStatCancelados']
            .forEach(id => { $(id).textContent = '—'; });
          $('recListCount').textContent = 'Agenda no disponible';
          $('recLimitInfo').textContent = 'Podés utilizar la agenda completa mientras se restablece esta vista.';
          mostrarVacio('No se pudo cargar la agenda', error.message + ' Usá Actualizar para volver a intentar.');
        }
      }
      function cambiarDia(dias) {
        fechaActual = moverFecha(fechaActual, dias);
        $('recPickDate').value = fechaActual;
        cargarAgenda();
      }
      function conectarSocket() {
        if (typeof io !== 'function') {
          $('recSocketText').textContent = 'Eventos no disponibles';
          $('recSocketTextSide').textContent = 'Eventos no disponibles';
          return;
        }
        const socket = io();
        const estado = conectado => {
          $('recSocketText').textContent = conectado ? 'Actualizaciones conectadas' : 'Sin conexión de eventos';
          $('recSocketTextSide').textContent = conectado ? 'Recibiendo novedades de la agenda' : 'Esperando conexión…';
          ['recSocketDot', 'recSocketDotSide'].forEach(id => {
            $(id).classList.toggle('is-online', conectado);
            $(id).classList.toggle('is-offline', !conectado);
          });
        };
        socket.on('connect', () => { estado(true); cargarAgenda(); });
        socket.on('disconnect', () => estado(false));
        socket.on('actualizacion_agenda', data => {
          const alerta = $('recLiveAlert');
          const message = typeof data?.mensaje === 'string' ? data.mensaje : 'Se modificó la agenda.';
          alerta.textContent = message;
          alerta.classList.add('is-visible');
          clearTimeout(timerAviso);
          timerAviso = setTimeout(() => alerta.classList.remove('is-visible'), 8000);
          cargarAgenda();
        });
        socket.on('whatsapp_qr', qrDataUrl => {
          if (typeof qrDataUrl !== 'string' || !qrDataUrl.startsWith('data:image/')) return;
          $('whatsappBox').style.display = 'block';
          $('qrImage').src = qrDataUrl;
          $('qrImage').style.display = 'block';
          $('whatsappSuccess').style.display = 'none';
        });
        socket.on('whatsapp_ready', () => {
          $('whatsappBox').style.display = 'block';
          $('qrImage').style.display = 'none';
          $('whatsappSuccess').style.display = 'block';
          setTimeout(() => { $('whatsappBox').style.display = 'none'; }, 6000);
        });
      }
      document.addEventListener('DOMContentLoaded', () => {
        fechaActual = fechaBA();
        $('recPickDate').value = fechaActual;
        actualizarReloj();
        setInterval(actualizarReloj, 30000);
        $('recPrev').addEventListener('click', () => cambiarDia(-1));
        $('recNext').addEventListener('click', () => cambiarDia(1));
        $('recToday').addEventListener('click', () => { fechaActual = fechaBA(); $('recPickDate').value = fechaActual; cargarAgenda(); });
        $('recPickDate').addEventListener('change', e => {
          if (/^\d{4}-\d{2}-\d{2}$/.test(e.target.value)) { fechaActual = e.target.value; cargarAgenda(); }
        });
        $('recSearch').addEventListener('input', renderAgenda);
        $('recFilterStatus').addEventListener('change', renderAgenda);
        $('recRefresh').addEventListener('click', cargarAgenda);
        cargarAgenda();
        conectarSocket();
      });
    })();
