        small.text-muted
          | Centro de Inteligencia Gerencial


  //- ============================================================
  //- JAVASCRIPT
  //- ============================================================

  script.
    document.addEventListener('DOMContentLoaded', function () {

      const metricasDashboard = !{metricasJSON};
      const profesionalesDashboard = !{profesionalesJSON};
      const especialidadesDashboard = !{especialidadesJSON};
      const evolucionDashboard = !{evolucionJSON};


      // =========================================================
      // HORA
      // =========================================================

      const horaPanel =
        document.getElementById('horaPanel');

      if (horaPanel) {
        horaPanel.textContent =
          new Date().toLocaleTimeString(
            'es-AR',
            {
              hour: '2-digit',
              minute: '2-digit'
            }
          );
      }


      // =========================================================
      // ACTUALIZAR
      // =========================================================

      const btnActualizar =
        document.getElementById('btnActualizar');

      if (btnActualizar) {

        btnActualizar.addEventListener(
          'click',
          function () {
            window.location.reload();
          }
        );
      }


      // =========================================================
      // CONTADORES
      // =========================================================

      const counters =
        document.querySelectorAll('.js-counter');

      counters.forEach(function (elemento) {

        const objetivo =
          Number(elemento.dataset.target || 0);

        const decimales =
          Number(elemento.dataset.decimals || 0);

        const inicio =
          performance.now();

        const duracion =
          850;

        function animar(tiempo) {

          const progreso =
            Math.min(
              (tiempo - inicio) / duracion,
              1
            );

          const suavizado =
            1 - Math.pow(1 - progreso, 3);

          const valor =
            objetivo * suavizado;

          elemento.textContent =
            valor.toLocaleString(
              'es-AR',
              {
                minimumFractionDigits: decimales,
                maximumFractionDigits: decimales
              }
            );

          if (progreso < 1) {
            requestAnimationFrame(animar);
          }
        }

        requestAnimationFrame(animar);
      });


      // =========================================================
      // CHART.JS
      // =========================================================

      if (typeof Chart === 'undefined') {
        console.warn('Chart.js no pudo cargarse.');
        return;
      }


      function obtenerTema() {

        const oscuro =
          document.documentElement
            .getAttribute('data-bs-theme') === 'dark';

        return {
          texto:
            oscuro ? '#cbd5e1' : '#475569',

          grilla:
            oscuro
              ? 'rgba(148,163,184,.10)'
              : 'rgba(15,23,42,.07)'
        };
      }


      let paleta =
        obtenerTema();

      let chartProfesionales = null;
      let chartEstados = null;
      let chartEvolucion = null;
      let chartEspecialidades = null;


      // =========================================================
      // PROFESIONALES
      // =========================================================

      const canvasProfesionales =
        document.getElementById(
          'chartProfesionales'
        );


      if (
        canvasProfesionales &&
        profesionalesDashboard.length > 0
      ) {

        const nombres =
          profesionalesDashboard.map(
            function (prof) {
              return prof._id;
            }
          );


        const cantidades =
          profesionalesDashboard.map(
            function (prof) {
              return Number(
                prof.cantidadTurnos || 0
              );
            }
          );


        chartProfesionales =
          new Chart(
            canvasProfesionales,
            {

              type: 'bar',

              data: {
                labels: nombres,

                datasets: [
                  {
                    label:
                      'Turnos asignados',

                    data:
                      cantidades,

                    backgroundColor:
                      'rgba(139,92,246,.78)',

                    borderColor:
                      '#8b5cf6',

                    borderWidth: 1,

                    borderRadius: 10,

                    borderSkipped: false
                  }
                ]
              },

              options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                  legend: {
                    display: false
                  },

                  tooltip: {

                    displayColors: false,

                    callbacks: {

                      label: function (context) {
                        return `${context.raw} turno(s)`;
                      }

                    }
                  }
                },

                scales: {

                  x: {

                    grid: {
                      display: false
                    },

                    ticks: {
                      color: paleta.texto
                    },

                    border: {
                      display: false
                    }
                  },

                  y: {

                    beginAtZero: true,

                    ticks: {
                      precision: 0,
                      color: paleta.texto
                    },

                    grid: {
                      color: paleta.grilla
                    },

                    border: {
                      display: false
                    }
                  }
                }
              }
            }
          );
      }


      // =========================================================
      // ESTADOS
      // =========================================================

      const canvasEstados =
        document.getElementById(
          'chartEstados'
        );


      if (canvasEstados) {

        const atendidos =
          Number(
            metricasDashboard.atendidos || 0
          );

        const reservados =
          Number(
            metricasDashboard.reservados || 0
          );

        const cancelados =
          Number(
            metricasDashboard.cancelados || 0
          );

        const pendientes =
          Number(
            metricasDashboard.pendientesPago || 0
          );


        chartEstados =
          new Chart(
            canvasEstados,
            {

              type: 'doughnut',

              data: {

                labels: [
                  'Atendidos',
                  'Reservados',
                  'Cancelados',
                  'Pendientes pago'
                ],

                datasets: [
                  {
                    data: [
                      atendidos,
                      reservados,
                      cancelados,
                      pendientes
                    ],

                    backgroundColor: [
                      '#10b981',
                      '#f59e0b',
                      '#ef4444',
                      '#8b5cf6'
                    ],

                    borderWidth: 0,

                    hoverOffset: 7
                  }
                ]
              },

              options: {

                responsive: true,

                maintainAspectRatio: false,

                cutout: '70%',

                plugins: {

                  legend: {

                    position: 'bottom',

                    labels: {

                      color:
                        paleta.texto,

                      usePointStyle: true,

                      pointStyle:
                        'circle',

                      padding: 18
                    }
                  }
                }
              }
            }
          );
      }


      // =========================================================
      // EVOLUCIÓN
      // =========================================================

      const canvasEvolucion =
        document.getElementById(
          'chartEvolucion'
        );


      if (
        canvasEvolucion &&
        evolucionDashboard.length > 0
      ) {

        const etiquetas =
          evolucionDashboard.map(
            function (registro) {

              const partes =
                String(
                  registro.fecha
                ).split('-');

              if (partes.length === 3) {
                return `${partes[2]}/${partes[1]}`;
              }

              return registro.fecha;
            }
          );


        const cantidades =
          evolucionDashboard.map(
            function (registro) {

              return Number(
                registro.cantidad || 0
              );
            }
          );


        chartEvolucion =
          new Chart(
            canvasEvolucion,
            {

              type: 'line',

              data: {

                labels:
                  etiquetas,

                datasets: [
                  {

                    label:
                      'Turnos',

                    data:
                      cantidades,

                    borderColor:
                      '#8b5cf6',

                    backgroundColor:
                      'rgba(139,92,246,.12)',

                    fill: true,

                    tension: .4,

                    pointRadius: 4,

                    pointHoverRadius: 7,

                    pointBackgroundColor:
                      '#8b5cf6'
                  }
                ]
              },

              options: {

                responsive: true,

                maintainAspectRatio: false,

                interaction: {
                  intersect: false,
                  mode: 'index'
                },

                plugins: {

                  legend: {
                    display: false
                  },

                  tooltip: {

                    displayColors: false,

                    callbacks: {

                      label: function (context) {
                        return `${context.raw} turno(s)`;
                      }

                    }
                  }
                },

                scales: {

                  x: {

                    grid: {
                      display: false
                    },

                    ticks: {
                      color: paleta.texto
                    },

                    border: {
                      display: false
                    }
                  },

                  y: {

                    beginAtZero: true,

                    ticks: {
                      precision: 0,
                      color: paleta.texto
                    },

                    grid: {
                      color: paleta.grilla
                    },

                    border: {
                      display: false
                    }
                  }
                }
              }
            }
          );
      }


      // =========================================================
      // ESPECIALIDADES
      // =========================================================

      const canvasEspecialidades =
        document.getElementById(
          'chartEspecialidades'
        );


      if (
        canvasEspecialidades &&
        especialidadesDashboard.length > 0
      ) {

        const nombres =
          especialidadesDashboard.map(
            function (registro) {
              return registro._id || 'General';
            }
          );


        const cantidades =
          especialidadesDashboard.map(
            function (registro) {
              return Number(
                registro.cantidad || 0
              );
            }
          );


        chartEspecialidades =
          new Chart(
            canvasEspecialidades,
            {

              type: 'bar',

              data: {

                labels:
                  nombres,

                datasets: [
                  {

                    data:
                      cantidades,

                    backgroundColor: [
                      'rgba(37,99,235,.82)',
                      'rgba(139,92,246,.82)',
                      'rgba(6,182,212,.82)',
                      'rgba(16,185,129,.82)',
                      'rgba(245,158,11,.82)'
                    ],

                    borderRadius: 9,

                    borderSkipped: false
                  }
                ]
              },

              options: {

                indexAxis: 'y',

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                  legend: {
                    display: false
                  },

                  tooltip: {

                    displayColors: false,

                    callbacks: {

                      label: function (context) {
                        return `${context.raw} turno(s)`;
                      }

                    }
                  }
                },

                scales: {

                  x: {

                    beginAtZero: true,

                    ticks: {
                      precision: 0,
                      color: paleta.texto
                    },

                    grid: {
                      color: paleta.grilla
                    },

                    border: {
                      display: false
                    }
                  },

                  y: {

                    grid: {
                      display: false
                    },

                    ticks: {
                      color: paleta.texto
                    },

                    border: {
                      display: false
                    }
                  }
                }
              }
            }
          );
      }


      // =========================================================
      // CAMBIO DE TEMA
      // =========================================================

      const observador =
        new MutationObserver(
          function () {

            paleta =
              obtenerTema();


            if (chartProfesionales) {

              chartProfesionales
                .options
                .scales
                .x
                .ticks
                .color =
                  paleta.texto;

              chartProfesionales
                .options
                .scales
                .y
                .ticks
                .color =
                  paleta.texto;

              chartProfesionales
                .options
                .scales
                .y
                .grid
                .color =
                  paleta.grilla;

              chartProfesionales.update();
            }


            if (chartEstados) {

              chartEstados
                .options
                .plugins
                .legend
                .labels
                .color =
                  paleta.texto;

              chartEstados.update();
            }


            if (chartEvolucion) {

              chartEvolucion
                .options
                .scales
                .x
                .ticks
                .color =
                  paleta.texto;

              chartEvolucion
                .options
                .scales
                .y
                .ticks
                .color =
                  paleta.texto;

              chartEvolucion
                .options
                .scales
                .y
                .grid
                .color =
                  paleta.grilla;

              chartEvolucion.update();
            }


            if (chartEspecialidades) {

              chartEspecialidades
                .options
                .scales
                .x
                .ticks
                .color =
                  paleta.texto;

              chartEspecialidades
                .options
                .scales
                .x
                .grid
                .color =
                  paleta.grilla;

              chartEspecialidades
                .options
                .scales
                .y
                .ticks
                .color =
                  paleta.texto;

              chartEspecialidades.update();
            }
          }
        );


      observador.observe(
        document.documentElement,
        {
          attributes: true,
          attributeFilter: [
            'data-bs-theme'
          ]
        }
      );

    });