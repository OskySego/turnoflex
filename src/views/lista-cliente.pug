extends layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4.flex-wrap.gap-3
    div
      h2.mb-1.fw-bold Clientes
      p.text-muted.mb-0 Clientes registrados en TurnoFlex

    .d-flex.align-items-center.gap-2
      span.badge.bg-primary.fs-6.px-3.py-2
        | #{clientes ? clientes.length : 0} clientes

      a.btn.btn-outline-secondary.rounded-3(href="/")
        | Volver al inicio

      a.btn.btn-primary.rounded-3(href="/clientes/nuevo")
        | + Nuevo cliente

  if !clientes || clientes.length === 0
    .alert.alert-info.shadow-sm.rounded-3
      | No hay clientes registrados actualmente.

  else
    .row.g-4
      each cliente in clientes
        - const clienteId = cliente._id || cliente.id
        .col-md-4
          .card.border-0.rounded-4.shadow-sm.h-100
            .card-body.p-4.d-flex.flex-column.justify-content-between
              div
                .d-flex.align-items-center.mb-3
                  .bg-primary.bg-opacity-10.text-primary.rounded-circle.d-flex.align-items-center.justify-content-center.me-3.fw-bold.fs-5(style="width:48px; height:48px; flex-shrink:0;")
                    | #{cliente.nombre ? cliente.nombre.substring(0, 2).toUpperCase() : 'CN'}
                  div
                    h3.h5.card-title.fw-bold.mb-0= cliente.nombre
                    p.text-muted.small.mb-0= cliente.email || 'Sin email registrado'

                .bg-light.p-3.rounded-3.mb-3
                  p.text-muted.small.mb-1.text-uppercase.fw-bold TELÉFONO / CONTACTO
                  p.small.text-dark.fw-medium.mb-0= cliente.telefono || 'N/D'

              div.pt-2
                a.btn.btn-outline-primary.w-100.rounded-3(href=`/clientes/${clienteId}`) Ver detalle