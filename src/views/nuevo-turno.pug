//- ============================================================
//- VISTA DE RESERVA / ALTA DE NUEVO TURNO - TURNOFLEX
//- ============================================================
//- Plantilla Pug para gestionar la solicitud y el registro de turnos.
//- Adapto la interfaz según el rol (paciente o recepción/admin), filtro
//- profesionales compatibles con la cobertura, habilito días válidos en
//- Flatpickr, genero los horarios disponibles y muestro la cotización.

extends layout

block content

  //- ============================================================
  //- 1. DEPENDENCIAS EXTERNAS (FLATPICKR)
  //- ============================================================

  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css")
  script(src="https://cdn.jsdelivr.net/npm/flatpickr")
  script(src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js")
  

  //- ============================================================
  //- 3. ESTRUCTURA PRINCIPAL DE LA VISTA
  //- ============================================================

  .turn-booking-page.tfu-page

    //- Cabecera visual con título adaptado al rol del usuario logueado
    .turn-booking-hero.tfu-hero
      .turn-booking-hero-content
        .row.align-items-center.g-4
          .col-lg-8
            .d-flex.align-items-center.gap-3
              .turn-booking-icon
                | 📅
              div
                .turn-booking-eyebrow
                  | ◆ TurnoFlex · Agenda inteligente
                if user && user.rol === 'cliente'
                  h1.turn-booking-title
                    | Solicitar turno
                  p.turn-booking-description
                    | Elegí profesional, modalidad, fecha y horario.
                    | TurnoFlex utilizará la disponibilidad configurada
                    | para mostrarte únicamente las opciones correspondientes.
                else
                  h1.turn-booking-title
                    | Registrar nuevo turno
                  p.turn-booking-description
                    | Gestioná la reserva del paciente seleccionando profesional,
                    | modalidad y disponibilidad desde la agenda médica.
          .col-lg-4
            .d-flex.justify-content-lg-end
              .turn-booking-status
                span.turn-booking-dot
                span
                  | Agenda disponible

    //- Guía visual de los 5 pasos de la reserva
    .turn-steps
      .turn-step
        .turn-step-number
          | 01
        div
          .turn-step-title
            | Paciente
          .turn-step-text
            | Identificación

      .turn-step
        .turn-step-number
          | 02
        div
          .turn-step-title
            | Profesional
          .turn-step-text
            | Especialidad

      .turn-step
        .turn-step-number
          | 03
        div
          .turn-step-title
            | Modalidad
          .turn-step-text
            | Tipo de consulta

      .turn-step
        .turn-step-number
          | 04
        div
          .turn-step-title
            | Fecha y hora
          .turn-step-text
            | Disponibilidad

      .turn-step
        .turn-step-number
          | 05
        div
          .turn-step-title
            | Confirmación
          .turn-step-text
            | Reserva y pago


    //- ==========================================================
    //- 4. FORMULARIO DE RESERVA DE TURNO
    //- ==========================================================

    form.turn-form-card.tfu-card(action="/turnos" method="POST" id="formTurno")

      //- --------------------------------------------------------
      //- PASO 1: SELECCIÓN O IDENTIFICACIÓN DEL PACIENTE
      //- --------------------------------------------------------
      .turn-section
        .turn-section-header
          .turn-section-icon
            | 👤
          div
            .turn-section-label
              | Paso 1
            h4.turn-section-title
              | Paciente

        //- Si el usuario es cliente, fijo automáticamente su ficha y oculto el select
        if user && user.rol === 'cliente'
          if clientes && clientes.length > 0
            - var cli = clientes[0]
            - var cliId = cli._id || cli.id
            - var tieneObraSocial = cli.obraSocial && cli.obraSocial.empresa
            - var tipoCli = tieneObraSocial ? 'obra_social' : 'particular'

            .patient-fixed
              .patient-fixed-icon
                | 👤
              div
                h6.patient-fixed-name
                  = cli.nombre
                p.patient-fixed-text
                  | #{cli.email || 'Sin correo'} · #{tieneObraSocial ? cli.obraSocial.empresa : 'Paciente particular'}

            select.d-none(name="cliente_id" id="selectCliente" required)
              option(value=cliId data-tipocobertura=tipoCli selected)
                = cli.nombre
          else
            .alert.alert-warning.mb-0
              | No se encontró un perfil de paciente asociado a tu usuario.

        //- Si es recepción o administrador, permito elegir cualquier paciente registrado
        else
          label.turn-field-label(for="selectCliente")
            | Seleccionar paciente
            span.required-mark
              |  *
          select.form-select.turn-control(name="cliente_id" id="selectCliente" required)
            option(value="" disabled selected)
              | Seleccioná un paciente...
            if clientes && clientes.length > 0
              each cli in clientes
                - var cliId = cli._id || cli.id
                - var tieneObraSocial = cli.obraSocial && cli.obraSocial.empresa
                - var tipoCli = tieneObraSocial ? 'obra_social' : 'particular'
                option(value=cliId data-tipocobertura=tipoCli)
                  | #{cli.nombre} — #{cli.email || 'Sin correo'}
          .turn-help
            | El tipo de cobertura del paciente se utilizará para filtrar profesionales compatibles.

      //- --------------------------------------------------------
      //- PASO 2: PROFESIONAL Y DISPONIBILIDAD
      //- --------------------------------------------------------
      .turn-section
        .turn-section-header
          .turn-section-icon
            | 🩺
          div
            .turn-section-label
              | Paso 2
            h4.turn-section-title
              | Profesional y disponibilidad

        label.turn-field-label(for="selectProfesional")
          | Profesional
          span.required-mark
            |  *
        select.form-select.turn-control(name="profesional_id" id="selectProfesional" required disabled)
          option(value="" disabled selected)
            | Primero seleccioná un paciente...
          if profesionales && profesionales.length > 0
            each prof in profesionales
              //- Preparo los metadatos de agenda, modalidades y aranceles en atributos data-*
              - var profId = prof._id || prof.id
              - var rawDias = prof.diasAtencion || []
              - var cob = prof.tipoCobertura || 'ambas'
              - var sobDias = prof.diasSobreturnos || []
              - var telDias = prof.diasTelemedicina || []
              - var precioSena = 5000
              - var precioParticular = 0
              - var copago = 0

              if especialidades && especialidades.length > 0
                each esp in especialidades
                  if esp && esp.nombre === prof.especialidad
                    - precioSena = esp.montoSena || 5000
                    - precioParticular = Number(esp.precioParticular)
                    - copago = Number(esp.copagoObraSocial)

              option(
                value=profId
                data-dias=rawDias.join(',')
                data-inicio=prof.horaInicio || '08:00'
                data-fin=prof.horaFin || '18:00'
                data-duracion=prof.duracionTurnoMinutos || 30
                data-cobertura=cob
                data-sob-activo=prof.permiteSobreturnos ? 'true' : 'false'
                data-sob-dias=sobDias.join(',')
                data-sob-inicio=prof.horaInicioSobreturnos || ''
                data-sob-fin=prof.horaFinSobreturnos || ''
                data-tel-activo=prof.ofreceTelemedicina ? 'true' : 'false'
                data-tel-dias=telDias.join(',')
                data-tel-inicio=prof.horaInicioTelemedicina || ''
                data-tel-fin=prof.horaFinTelemedicina || ''
                data-sena=precioSena
                data-particular=precioParticular
                data-copago=copago
                data-nombre=prof.nombre || 'Profesional'
                data-especialidad=prof.especialidad || 'General'
              )
                | #{prof.nombre} — #{prof.especialidad || 'General'}

        .turn-help
          | Se mostrarán profesionales compatibles con la cobertura del paciente.

        //- Panel dinámico con el detalle de días y horarios del profesional elegido
        #infoAgenda
        if user && user.rol === 'cliente'
          #precioTurno.turn-help(data-descuento=transferenciaDescuentoPct)
            | Elegí un profesional para ver el importe del copago o la consulta particular.

      //- --------------------------------------------------------
      //- PASO 3: MODALIDAD DE ATENCIÓN
      //- --------------------------------------------------------
      .turn-section
        .turn-section-header
          .turn-section-icon
            | 🏥
          div
            .turn-section-label
              | Paso 3
            h4.turn-section-title
              | Modalidad de atención

        label.turn-field-label(for="selectModalidad")
          | Tipo de atención
          span.required-mark
            |  *
        select.form-select.turn-control(name="modalidadTurno" id="selectModalidad" required disabled)
          option(value="" disabled selected)
            | Primero seleccioná un profesional...
        .turn-help
          | Las opciones disponibles dependen de la configuración de agenda del profesional.

      //- --------------------------------------------------------
      //- PASO 4: FECHA Y HORARIO DISPONIBLE
      //- --------------------------------------------------------
      .turn-section
        .turn-section-header
          .turn-section-icon
            | 🕐
          div
            .turn-section-label
              | Paso 4
            h4.turn-section-title
              | Fecha y horario

        .row.g-4
          .col-md-6
            label.turn-field-label(for="inputFecha")
              | Fecha
              span.required-mark
                |  *
            input.form-control.turn-control(type="text" name="fecha" id="inputFecha" required disabled placeholder="Elegí una fecha..." autocomplete="off")
            .turn-help
              | Solo podrás seleccionar días en los que el profesional atiende.

          .col-md-6
            label.turn-field-label(for="inputHora")
              | Horario disponible
              span.required-mark
                |  *
            select.form-select.turn-control(name="hora" id="inputHora" required disabled)
              option(value="" disabled selected)
                | Primero elegí una fecha...

      //- --------------------------------------------------------
      //- PASO 5: MEDIO DE PAGO O CONFIRMACIÓN ADMINISTRATIVA
      //- --------------------------------------------------------
      .turn-section
        .turn-section-header
          .turn-section-icon
            | 💳
          div
            .turn-section-label
              | Paso 5
            if user && user.rol === 'cliente'
              h4.turn-section-title
                | Medio de pago
            else
              h4.turn-section-title
                | Confirmación administrativa

        //- Opciones de pago disponibles cuando reserva el propio paciente
        if user && user.rol === 'cliente'
          .payment-grid
            .payment-option
              input.payment-radio(type="radio" name="metodo_pago" id="pagoMercadoPago" value="mercadopago" checked required)
              label.payment-label(for="pagoMercadoPago")
                .payment-icon
                  | 💳
                h6.payment-title
                  | Mercado Pago
                p.payment-text
                  | Pagá el importe de tu consulta o copago mediante el checkout de Mercado Pago.

            .payment-option
              input.payment-radio(type="radio" name="metodo_pago" id="pagoTransferencia" value="transferencia" required)
              label.payment-label(for="pagoTransferencia")
                .payment-icon
                  | 🏦
                h6.payment-title
                  | PagoFlex · Transferencia
                p.payment-text
                  | Transferí a la cuenta de la clínica. Descuento solo en consultas particulares, si está habilitado. Requiere validación de recepción.

            .payment-option
              input.payment-radio(type="radio" name="metodo_pago" id="pagoEfectivo" value="efectivo" required)
              label.payment-label(for="pagoEfectivo")
                .payment-icon
                  | 💵
                h6.payment-title
                  | Efectivo en recepción
                p.payment-text
                  | Reservá el turno ahora y aboná presencialmente en recepción.

        //- Controles de arancel, verificación de cobertura y cotización para recepción/admin
        else
          //- Los importes solo se eligen entre aranceles configurados en el sistema
          .row.g-3
            .col-md-6
              label.turn-field-label(for='recepcionTipoCobro') Tipo de atención *
              select#recepcionTipoCobro.form-select.turn-control(name='tipoCobro' required)
                option(value='' selected disabled) Elegí un tipo de atención...
                option(value='particular') Consulta particular
                option(value='copago') Consulta con copago
                option(value='sin_cargo') Cobertura total ($0)
            .col-md-6
              label.turn-field-label(for='recepcionMetodoPago') Medio de pago *
              select#recepcionMetodoPago.form-select.turn-control(name='metodo_pago' required)
                option(value='efectivo' selected) Efectivo en recepción
                option(value='mercadopago') Mercado Pago (desde detalle)
                option(value='transferencia') PagoFlex · Transferencia bancaria

          .form-check.mt-3#recepcionVerificacion
            input#coberturaVerificada.form-check-input(type='checkbox' name='coberturaVerificada' value='si')
            label.form-check-label(for='coberturaVerificada')
              | Confirmé que la cobertura, el plan y el convenio permiten este copago o cobertura total.

          .patient-fixed.mt-3#recepcionImporte(role='status' aria-live='polite')
            .patient-fixed-icon
              | 🧾
            div.flex-grow-1
              h6.patient-fixed-name.mb-2 Cotización para este turno
              p.patient-fixed-text.mb-2#recepcionEstadoCotizacion Elegí paciente, profesional y tipo de atención.
              dl.row.mb-0
                dt.col-7 Importe base
                dd.col-5.text-end#recepcionBase —
                dt.col-7 Descuento autorizado
                dd.col-5.text-end#recepcionDescuento —
                dt.col-7 Total a abonar
                dd.col-5.text-end.fw-bold#recepcionTotal —
              small#recepcionNotaCotizacion.text-muted
                | El importe final se calcula nuevamente en el servidor al reservar.

      //- --------------------------------------------------------
      //- RESUMEN DINÁMICO Y ACCIONES DEL FORMULARIO
      //- --------------------------------------------------------
      p.turn-help El copago y el precio particular se calculan con los importes de la especialidad en el servidor. El descuento por transferencia, si corresponde, se muestra en el detalle del turno.

      #resumenTurno.turn-summary
        h6.turn-summary-title
          | ✓ Resumen de la reserva
        .turn-summary-grid
          .turn-summary-item
            span.turn-summary-label
              | Profesional
            span.turn-summary-value#resumenProfesional
              | —

          .turn-summary-item
            span.turn-summary-label
              | Modalidad
            span.turn-summary-value#resumenModalidad
              | —

          .turn-summary-item
            span.turn-summary-label
              | Fecha
            span.turn-summary-value#resumenFecha
              | —

          .turn-summary-item
            span.turn-summary-label
              | Horario
            span.turn-summary-value#resumenHorario
              | —

      .turn-actions
        if user && user.rol === 'cliente'
          a.turn-cancel-btn(href="/")
            | Cancelar
        else
          a.turn-cancel-btn(href="/turnos")
            | Cancelar

        button.turn-submit-btn(type="submit" id="btnSubmit" disabled)
          span#submitIcon
            | ✓
          span#submitText
            | Confirmar turno


  //- ============================================================
  //- 5. LÓGICA JAVASCRIPT DEL CLIENTE
  //- ============================================================

  script.
    document.addEventListener('DOMContentLoaded', function () {
      // Capturo las referencias de los controles, contenedores y elementos del resumen
      const selectCliente = document.getElementById('selectCliente');
      const selectProf = document.getElementById('selectProfesional');
      const selectModalidad = document.getElementById('selectModalidad');
      const inputFecha = document.getElementById('inputFecha');
      const inputHora = document.getElementById('inputHora');
      const infoAgenda = document.getElementById('infoAgenda');
      const btnSubmit = document.getElementById('btnSubmit');
      const formulario = document.getElementById('formTurno');
      const resumenTurno = document.getElementById('resumenTurno');
      const resumenProfesional = document.getElementById('resumenProfesional');
      const resumenModalidad = document.getElementById('resumenModalidad');
      const resumenFecha = document.getElementById('resumenFecha');
      const resumenHorario = document.getElementById('resumenHorario');
      const submitText = document.getElementById('submitText');
      const submitIcon = document.getElementById('submitIcon');

      if (!selectCliente || !selectProf || !selectModalidad || !inputFecha || !inputHora || !btnSubmit) {
        return;
      }

      // Guardo una copia de las opciones originales para poder filtrarlas según el paciente
      const opcionesProfesionalesOriginales = Array.from(selectProf.querySelectorAll('option:not([disabled])'));

      const nombresDias = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

      const mapaDiasANumeros = {
        'Domingo': 0,
        'Lunes': 1,
        'Martes': 2,
        'Miércoles': 3,
        'Jueves': 4,
        'Viernes': 5,
        'Sábado': 6
      };

      let configActual = {};
      let calendario = null;

      // ========================================================
      // INICIALIZACIÓN DEL CALENDARIO (FLATPICKR)
      // ========================================================

      if (typeof flatpickr !== 'undefined') {
        calendario = flatpickr(inputFecha, {
          locale: 'es',
          dateFormat: 'Y-m-d',
          minDate: 'today',
          disable: [],
          onChange: function (selectedDates, dateStr) {
            if (dateStr) {
              actualizarHorarios();
              actualizarResumen();
            }
          }
        });
      }

      // ========================================================
      // FUNCIONES AUXILIARES DE FORMATO Y PARSEO
      // ========================================================

      // Convierto la lista de días (nombres o índices) a números de día de la semana (0-6)
      function parsearDias(texto) {
        if (!texto || texto.trim() === '') {
          return [];
        }

        return texto
          .split(',')
          .map(function (dia) {
            const valor = dia.trim();
            if (!isNaN(valor)) {
              return parseInt(valor, 10);
            }
            return mapaDiasANumeros[valor];
          })
          .filter(function (numero) {
            return numero !== undefined && !isNaN(numero);
          });
      }

      // Devuelvo los días habilitados en texto legible separado por comas
      function formatearDias(texto) {
        const numeros = parsearDias(texto);
        if (numeros.length === 0) {
          return 'Ninguno';
        }
        return numeros
          .map(function (numero) {
            return nombresDias[numero];
          })
          .join(', ');
      }

      function formatoPrecio(valor) {
        const numero = Number(valor || 0);
        return numero.toLocaleString('es-AR', {
          style: 'currency',
          currency: 'ARS',
          maximumFractionDigits: 0
        });
      }

      // ========================================================
      // REINICIO EN CASCADA DE PASOS POSTERIORES
      // ========================================================

      function limpiarDesdeProfesional() {
        selectModalidad.innerHTML = '<option value="" disabled selected>Primero seleccioná un profesional...</option>';
        selectModalidad.disabled = true;
        inputFecha.disabled = true;
        inputHora.disabled = true;
        inputHora.innerHTML = '<option value="" disabled selected>Primero elegí una fecha...</option>';
        btnSubmit.disabled = true;
        infoAgenda.style.display = 'none';

        if (calendario) {
          calendario.clear();
        }
        actualizarResumen();
      }

      function limpiarDesdeModalidad() {
        inputFecha.disabled = true;
        inputHora.disabled = true;
        inputHora.innerHTML = '<option value="" disabled selected>Primero elegí una fecha...</option>';
        btnSubmit.disabled = true;

        if (calendario) {
          calendario.clear();
        }
        actualizarResumen();
      }

      // ========================================================
      // PASO 1: FILTRADO DE PROFESIONALES SEGÚN PACIENTE
      // ========================================================

      selectCliente.addEventListener('change', function () {
        const opcionCliente = this.options[this.selectedIndex];
        const tipoCliente = opcionCliente ? opcionCliente.getAttribute('data-tipocobertura') : 'particular';

        selectProf.innerHTML = '<option value="" disabled selected>Seleccioná un profesional...</option>';
        let cantidadCompatibles = 0;

        opcionesProfesionalesOriginales.forEach(function (opcion) {
          const cobertura = opcion.getAttribute('data-cobertura') || 'ambas';
          const compatibleParticular = tipoCliente === 'particular' && (cobertura === 'particular' || cobertura === 'ambas');
          const compatibleObraSocial = tipoCliente === 'obra_social' && (cobertura === 'obra_social' || cobertura === 'ambas');

          if (compatibleParticular || compatibleObraSocial) {
            selectProf.appendChild(opcion.cloneNode(true));
            cantidadCompatibles++;
          }
        });

        if (cantidadCompatibles === 0) {
          const opcionVacia = document.createElement('option');
          opcionVacia.disabled = true;
          opcionVacia.textContent = 'No hay profesionales compatibles';
          selectProf.appendChild(opcionVacia);
        }

        selectProf.disabled = cantidadCompatibles === 0;
        limpiarDesdeProfesional();
      });

      // ========================================================
      // PASO 2: CARGA DE AGENDA Y MODALIDADES DEL PROFESIONAL
      // ========================================================

      selectProf.addEventListener('change', function () {
        const opcion = selectProf.options[selectProf.selectedIndex];
        if (!opcion || !opcion.value) {
          return;
        }

        // Levanto toda la configuración de agenda cargada en los data-* del option
        configActual = {
          diasRegulares: parsearDias(opcion.getAttribute('data-dias')),
          inicioReg: opcion.getAttribute('data-inicio') || '08:00',
          finReg: opcion.getAttribute('data-fin') || '18:00',
          duracionReg: parseInt(opcion.getAttribute('data-duracion'), 10) || 30,
          sobActivo: opcion.getAttribute('data-sob-activo') === 'true',
          diasSob: parsearDias(opcion.getAttribute('data-sob-dias')),
          inicioSob: opcion.getAttribute('data-sob-inicio') || '',
          finSob: opcion.getAttribute('data-sob-fin') || '',
          telActivo: opcion.getAttribute('data-tel-activo') === 'true',
          diasTel: parsearDias(opcion.getAttribute('data-tel-dias')),
          inicioTel: opcion.getAttribute('data-tel-inicio') || '',
          finTel: opcion.getAttribute('data-tel-fin') || '',
          sena: Number(opcion.getAttribute('data-sena')) || 5000,
          nombre: opcion.getAttribute('data-nombre') || 'Profesional',
          especialidad: opcion.getAttribute('data-especialidad') || 'General'
        };

        const diasPresencial = formatearDias(opcion.getAttribute('data-dias'));
        const diasSob = formatearDias(opcion.getAttribute('data-sob-dias'));
        const diasTel = formatearDias(opcion.getAttribute('data-tel-dias'));

        // Armo y muestro el bloque informativo con la disponibilidad del profesional
        let textoInfo = '<div class="agenda-info-title">Disponibilidad del profesional</div>';
        textoInfo += '🏥 <strong>Presencial:</strong> ' + diasPresencial + ' · ' + configActual.inicioReg + ' a ' + configActual.finReg + '<br>';
        textoInfo += '⚡ <strong>Sobreturnos:</strong> ' + (configActual.sobActivo ? diasSob : 'No habilitados') + '<br>';
        textoInfo += '💻 <strong>Telemedicina:</strong> ' + (configActual.telActivo ? diasTel : 'No habilitada');
        textoInfo += '<br>💳 <strong>Precio:</strong> consultá debajo el importe particular o copago de referencia.';

        infoAgenda.innerHTML = textoInfo;
        infoAgenda.style.display = 'block';

        // Cargo las modalidades habilitadas para este profesional
        selectModalidad.innerHTML = '<option value="" disabled selected>Seleccioná una modalidad...</option>';

        const opcionPresencial = document.createElement('option');
        opcionPresencial.value = 'regular';
        if (configActual.diasRegulares.length > 0) {
          opcionPresencial.textContent = 'Presencial · ' + diasPresencial;
        } else {
          opcionPresencial.textContent = 'Presencial · No disponible';
          opcionPresencial.disabled = true;
        }
        selectModalidad.appendChild(opcionPresencial);

        const opcionSob = document.createElement('option');
        opcionSob.value = 'sobreturno';
        if (configActual.sobActivo && configActual.diasSob.length > 0) {
          opcionSob.textContent = 'Sobreturno · ' + diasSob;
        } else {
          opcionSob.textContent = 'Sobreturno · No disponible';
          opcionSob.disabled = true;
        }
        selectModalidad.appendChild(opcionSob);

        const opcionTele = document.createElement('option');
        opcionTele.value = 'telemedicina';
        if (configActual.telActivo && configActual.diasTel.length > 0) {
          opcionTele.textContent = 'Telemedicina · ' + diasTel;
        } else {
          opcionTele.textContent = 'Telemedicina · No disponible';
          opcionTele.disabled = true;
        }
        selectModalidad.appendChild(opcionTele);

        selectModalidad.disabled = false;
        limpiarDesdeModalidad();
      });

      // ========================================================
      // PASO 3: BLOQUEO DE DÍAS EN CALENDARIO SEGÚN MODALIDAD
      // ========================================================

      selectModalidad.addEventListener('change', function () {
        const modalidad = selectModalidad.value;
        let diasPermitidos = configActual.diasRegulares;

        if (modalidad === 'sobreturno') {
          diasPermitidos = configActual.diasSob;
        }

        if (modalidad === 'telemedicina') {
          diasPermitidos = configActual.diasTel;
        }

        if (calendario) {
          calendario.set('disable', [
            function (fecha) {
              return !diasPermitidos.includes(fecha.getDay());
            }
          ]);
          calendario.clear();
        }

        inputFecha.disabled = false;
        inputHora.disabled = true;
        inputHora.innerHTML = '<option value="" disabled selected>Primero elegí una fecha...</option>';
        btnSubmit.disabled = true;
        actualizarResumen();
      });

      // ========================================================
      // PASO 4: GENERACIÓN DE FRANJAS HORARIAS DISPONIBLES
      // ========================================================

      function actualizarHorarios() {
        inputHora.innerHTML = '<option value="" disabled selected>Elegí un horario...</option>';
        const modalidad = selectModalidad.value;

        let inicio = configActual.inicioReg;
        let fin = configActual.finReg;
        let duracion = configActual.duracionReg;

        if (modalidad === 'sobreturno') {
          inicio = configActual.inicioSob || configActual.inicioReg;
          fin = configActual.finSob || configActual.finReg;
          duracion = 20;
        }

        if (modalidad === 'telemedicina') {
          inicio = configActual.inicioTel || configActual.inicioReg;
          fin = configActual.finTel || configActual.finReg;
          duracion = 20;
        }

        if (!inicio || !fin) {
          return;
        }

        const inicioPartes = inicio.split(':');
        const finPartes = fin.split(':');
        let minutosActuales = Number(inicioPartes[0]) * 60 + Number(inicioPartes[1]);
        const minutosFinales = Number(finPartes[0]) * 60 + Number(finPartes[1]);

        const fechaSeleccionada = inputFecha.value;
        const ahora = new Date();
        const anio = ahora.getFullYear();
        const mes = String(ahora.getMonth() + 1).padStart(2, '0');
        const dia = String(ahora.getDate()).padStart(2, '0');
        const hoyTexto = anio + '-' + mes + '-' + dia;
        const minutosAhora = ahora.getHours() * 60 + ahora.getMinutes();

        let cantidad = 0;

        // Recorro la franja horaria generando turnos y descartando los ya pasados si es hoy
        while (minutosActuales + duracion <= minutosFinales) {
          const hora = Math.floor(minutosActuales / 60);
          const minuto = minutosActuales % 60;
          const valor = String(hora).padStart(2, '0') + ':' + String(minuto).padStart(2, '0');
          const horarioPasadoHoy = fechaSeleccionada === hoyTexto && minutosActuales <= minutosAhora;

          if (!horarioPasadoHoy) {
            const opcion = document.createElement('option');
            opcion.value = valor;
            opcion.textContent = valor + ' hs · ' + duracion + ' min';
            inputHora.appendChild(opcion);
            cantidad++;
          }

          minutosActuales += duracion;
        }

        if (cantidad === 0) {
          const opcionSinTurnos = document.createElement('option');
          opcionSinTurnos.disabled = true;
          opcionSinTurnos.textContent = 'No hay horarios disponibles para esta fecha';
          inputHora.appendChild(opcionSinTurnos);
          inputHora.disabled = true;
          btnSubmit.disabled = true;
        } else {
          inputHora.disabled = false;
        }
      }

      inputHora.addEventListener('change', function () {
        btnSubmit.disabled = !inputHora.value;
        actualizarResumen();
      });

      // ========================================================
      // ACTUALIZACIÓN DEL RESUMEN VISUAL DE LA RESERVA
      // ========================================================

      function actualizarResumen() {
        if (!resumenTurno) {
          return;
        }

        const profesionalSeleccionado = selectProf.options[selectProf.selectedIndex];
        const modalidadSeleccionada = selectModalidad.options[selectModalidad.selectedIndex];
        const hayDatos = profesionalSeleccionado && profesionalSeleccionado.value && selectModalidad.value && inputFecha.value && inputHora.value;

        if (!hayDatos) {
          resumenTurno.style.display = 'none';
          return;
        }

        resumenProfesional.textContent = configActual.nombre || profesionalSeleccionado.textContent;
        resumenModalidad.textContent = modalidadSeleccionada ? modalidadSeleccionada.textContent : '—';
        resumenFecha.textContent = inputFecha.value || '—';
        resumenHorario.textContent = inputHora.value ? inputHora.value + ' hs' : '—';
        resumenTurno.style.display = 'block';
      }

      // ========================================================
      // PASO 5: CÁLCULO ORIENTATIVO DE PRECIO Y MEDIO DE PAGO
      // ========================================================

      const radiosPago = document.querySelectorAll('input[name="metodo_pago"]');
      const cajaPrecio = document.getElementById('precioTurno');

      // Muestro una vista previa del arancel al paciente; el importe final lo valida el servidor
      function mostrarPrecioOrientativo() {
        if (!cajaPrecio) return;
        const opcProf = selectProf.options[selectProf.selectedIndex];
        const opcCliente = selectCliente.options[selectCliente.selectedIndex];
        if (!opcProf || !opcProf.value || !opcCliente || !opcCliente.value) {
          cajaPrecio.textContent = 'Elegí un paciente y un profesional para ver el precio.';
          return;
        }
        const conObra = opcCliente.getAttribute('data-tipocobertura') === 'obra_social';
        const compatible = opcProf.getAttribute('data-cobertura') !== 'particular';
        const esCopago = conObra && compatible;
        const base = Number(opcProf.getAttribute(esCopago ? 'data-copago' : 'data-particular'));
        if (!Number.isFinite(base) || base < 0 || (!esCopago && base === 0)) {
          cajaPrecio.textContent = 'Este profesional no tiene un precio configurado.';
          return;
        }
        const elegido = document.querySelector('input[name="metodo_pago"]:checked');
        const pct = !esCopago && elegido?.value === 'transferencia'
          ? Number(cajaPrecio.getAttribute('data-descuento') || 0) : 0;
        const importe = (Math.round(base*100) - Math.round(Math.round(base*100)*pct/100))/100;
        const dinero = valor => valor.toLocaleString('es-AR',{style:'currency',currency:'ARS'});
        cajaPrecio.textContent = esCopago && base === 0
          ? 'Cobertura total: no requiere pago.'
          : `${esCopago ? 'Copago' : 'Consulta particular'}: ${dinero(base)}${pct>0 ? ` · Descuento ${pct}% por transferencia` : ''} · Total: ${dinero(importe)}`;
      }

      selectCliente.addEventListener('change', () => setTimeout(mostrarPrecioOrientativo, 0));
      selectProf.addEventListener('change', mostrarPrecioOrientativo);
      radiosPago.forEach(radio => radio.addEventListener('change', mostrarPrecioOrientativo));
      mostrarPrecioOrientativo();

      // Adapto el texto del botón principal según si va a checkout de Mercado Pago o reserva directa
      function actualizarTextoPago() {
        const elegido = document.querySelector('input[name="metodo_pago"]:checked');
        if (!elegido || !submitText) {
          return;
        }

        if (elegido.value === 'mercadopago') {
          submitText.textContent = 'Continuar a Mercado Pago';
        } else {
          submitText.textContent = 'Reservar turno';
        }
      }

      radiosPago.forEach(function (radio) {
        radio.addEventListener('change', actualizarTextoPago);
      });

      actualizarTextoPago();

      // ========================================================
      // ENVÍO DEL FORMULARIO Y PRESELECCIÓN DESDE URL
      // ========================================================

      // Bloqueo el botón al enviar para evitar reservas duplicadas
      if (formulario) {
        formulario.addEventListener('submit', function () {
          if (!formulario.checkValidity()) {
            return;
          }
          btnSubmit.disabled = true;
          if (submitIcon) {
            submitIcon.textContent = '◷';
          }
          if (submitText) {
            submitText.textContent = 'Procesando turno...';
          }
        });
      }

      // Si vengo desde la ficha de un paciente (?cliente=ID), lo preselecciono automáticamente
      const parametrosURL = new URLSearchParams(window.location.search);
      const pacienteDesdeURL = parametrosURL.get('cliente');

      if (pacienteDesdeURL) {
        const opcionEncontrada = Array.from(selectCliente.options).find(function (opcion) {
          return opcion.value === pacienteDesdeURL;
        });

        if (opcionEncontrada) {
          selectCliente.value = pacienteDesdeURL;
        }
      }

      // Disparo el evento change para filtrar profesionales compatibles si ya hay paciente elegido
      if (selectCliente.value) {
        selectCliente.dispatchEvent(new Event('change'));
      }
    });


  //- ============================================================
  //- 6. SCRIPT DE COTIZACIÓN EN TIEMPO REAL (EXCLUSIVO RECEPCIÓN)
  //- ============================================================

  if user && (user.rol === 'admin' || user.rol === 'personal')
    script(src='/js/recepcion-cotizacion.js?v=1' defer)