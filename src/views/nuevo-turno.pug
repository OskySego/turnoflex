extends layout

block content

  //- ============================================================
  //- DEPENDENCIAS FLATPICKR
  //- ============================================================

  link(
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css"
  )

  script(
    src="https://cdn.jsdelivr.net/npm/flatpickr"
  )

  script(
    src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"
  )


  //- ============================================================
  //- ESTILOS
  //- ============================================================

  style.
    .turn-booking-page {
      --tb-navy: #0d1b3e;
      --tb-blue: #2563eb;
      --tb-violet: #8b5cf6;
      --tb-green: #10b981;
      --tb-yellow: #f59e0b;
      --tb-cyan: #06b6d4;
      --tb-red: #ef4444;

      --tb-surface: #ffffff;
      --tb-soft: #f8fafc;
      --tb-text: #0f172a;
      --tb-muted: #64748b;
      --tb-border: rgba(15,23,42,.08);

      color: var(--tb-text);
    }

    [data-bs-theme="dark"] .turn-booking-page {
      --tb-surface: #171d27;
      --tb-soft: #111827;
      --tb-text: #f8fafc;
      --tb-muted: #94a3b8;
      --tb-border: rgba(255,255,255,.08);
    }


    /* ==========================================================
       HERO
       ========================================================== */

    .turn-booking-hero {
      position: relative;
      overflow: hidden;

      padding: 32px;

      border-radius: 28px;

      color: white;

      background:
        radial-gradient(
          circle at 90% 0%,
          rgba(139,92,246,.50),
          transparent 33%
        ),
        radial-gradient(
          circle at 6% 100%,
          rgba(6,182,212,.28),
          transparent 36%
        ),
        linear-gradient(
          135deg,
          #08132e 0%,
          #10245d 52%,
          #312e81 100%
        );

      box-shadow:
        0 23px 54px rgba(15,23,42,.21);
    }

    .turn-booking-hero::after {
      content: "";

      position: absolute;

      width: 340px;
      height: 340px;

      right: -170px;
      bottom: -210px;

      border-radius: 50%;

      background:
        rgba(255,255,255,.07);
    }

    .turn-booking-hero-content {
      position: relative;
      z-index: 2;
    }

    .turn-booking-icon {
      width: 70px;
      height: 70px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 21px;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #8b5cf6
        );

      border:
        1px solid rgba(255,255,255,.22);

      box-shadow:
        0 13px 30px rgba(0,0,0,.17);

      font-size: 1.6rem;
    }

    .turn-booking-eyebrow {
      margin-bottom: 5px;

      color:
        rgba(255,255,255,.63);

      font-size: .68rem;

      font-weight: 850;

      text-transform: uppercase;

      letter-spacing: .14em;
    }

    .turn-booking-title {
      margin-bottom: 6px;

      font-size:
        clamp(1.8rem,4vw,2.5rem);

      font-weight: 900;

      letter-spacing: -.04em;
    }

    .turn-booking-description {
      max-width: 700px;

      margin-bottom: 0;

      color:
        rgba(255,255,255,.73);

      font-size: .83rem;

      line-height: 1.6;
    }

    .turn-booking-status {
      display: inline-flex;

      align-items: center;

      gap: 8px;

      padding: 9px 14px;

      border-radius: 999px;

      background:
        rgba(255,255,255,.10);

      border:
        1px solid rgba(255,255,255,.16);

      font-size: .75rem;

      font-weight: 800;
    }

    .turn-booking-dot {
      width: 8px;
      height: 8px;

      border-radius: 50%;

      background: #34d399;

      box-shadow:
        0 0 0 5px rgba(52,211,153,.12);
    }


    /* ==========================================================
       PASOS
       ========================================================== */

    .turn-steps {
      display: grid;

      grid-template-columns:
        repeat(5,minmax(0,1fr));

      gap: 9px;

      margin-top: 24px;
    }

    .turn-step {
      display: flex;

      align-items: center;

      gap: 9px;

      padding: 12px;

      border-radius: 14px;

      background:
        var(--tb-surface);

      border:
        1px solid var(--tb-border);

      box-shadow:
        0 8px 24px rgba(15,23,42,.04);
    }

    .turn-step-number {
      width: 30px;
      height: 30px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 9px;

      color: white;

      background:
        linear-gradient(
          135deg,
          var(--tb-blue),
          var(--tb-violet)
        );

      font-size: .68rem;

      font-weight: 900;
    }

    .turn-step-title {
      color:
        var(--tb-text);

      font-size: .67rem;

      font-weight: 850;
    }

    .turn-step-text {
      color:
        var(--tb-muted);

      font-size: .57rem;
    }


    /* ==========================================================
       FORMULARIO
       ========================================================== */

    .turn-form-card {
      margin-top: 24px;

      padding: 28px;

      border-radius: 24px;

      background:
        var(--tb-surface);

      border:
        1px solid var(--tb-border);

      box-shadow:
        0 13px 35px rgba(15,23,42,.06);
    }

    .turn-section {
      padding-bottom: 27px;

      margin-bottom: 27px;

      border-bottom:
        1px solid var(--tb-border);
    }

    .turn-section:last-of-type {
      margin-bottom: 0;

      border-bottom: 0;
    }

    .turn-section-header {
      display: flex;

      align-items: center;

      gap: 12px;

      margin-bottom: 20px;
    }

    .turn-section-icon {
      width: 44px;
      height: 44px;

      flex-shrink: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 13px;

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.11),
          rgba(139,92,246,.14)
        );

      font-size: 1.15rem;
    }

    .turn-section-label {
      margin-bottom: 2px;

      color:
        var(--tb-violet);

      font-size: .62rem;

      font-weight: 850;

      text-transform: uppercase;

      letter-spacing: .10em;
    }

    .turn-section-title {
      margin-bottom: 0;

      color:
        var(--tb-text);

      font-size: 1rem;

      font-weight: 900;
    }

    .turn-field-label {
      margin-bottom: 7px;

      color:
        var(--tb-text);

      font-size: .72rem;

      font-weight: 800;
    }

    .required-mark {
      color:
        var(--tb-red);
    }

    .turn-control {
      min-height: 48px;

      border-radius: 12px;

      color:
        var(--tb-text);

      background:
        var(--tb-soft);

      border:
        1px solid var(--tb-border);

      font-size: .78rem;
    }

    .turn-control:focus {
      color:
        var(--tb-text);

      background:
        var(--tb-surface);

      border-color:
        var(--tb-violet);

      box-shadow:
        0 0 0 4px rgba(139,92,246,.10);
    }

    .turn-control:disabled {
      opacity: .62;

      cursor: not-allowed;
    }

    .turn-help {
      margin-top: 5px;

      color:
        var(--tb-muted);

      font-size: .63rem;

      line-height: 1.45;
    }


    /* ==========================================================
       PACIENTE FIJO
       ========================================================== */

    .patient-fixed {
      display: flex;

      align-items: center;

      gap: 13px;

      padding: 15px;

      border-radius: 15px;

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.06),
          rgba(139,92,246,.09)
        );

      border:
        1px solid rgba(139,92,246,.13);
    }

    .patient-fixed-icon {
      width: 42px;
      height: 42px;

      display: flex;
      align-items: center;
      justify-content: center;

      flex-shrink: 0;

      border-radius: 12px;

      background:
        rgba(139,92,246,.12);
    }

    .patient-fixed-name {
      margin-bottom: 2px;

      color:
        var(--tb-text);

      font-size: .82rem;

      font-weight: 900;
    }

    .patient-fixed-text {
      margin-bottom: 0;

      color:
        var(--tb-muted);

      font-size: .65rem;
    }


    /* ==========================================================
       INFORMACIÓN DE AGENDA
       ========================================================== */

    #infoAgenda {
      display: none;

      margin-top: 15px;

      padding: 16px;

      border-radius: 15px;

      color:
        var(--tb-text);

      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.06),
          rgba(139,92,246,.09)
        );

      border:
        1px solid rgba(139,92,246,.13);

      font-size: .7rem;

      line-height: 1.7;
    }

    .agenda-info-title {
      margin-bottom: 7px;

      font-size: .74rem;

      font-weight: 900;
    }


    /* ==========================================================
       PAGO
       ========================================================== */

    .payment-grid {
      display: grid;

      grid-template-columns:
        repeat(2,minmax(0,1fr));

      gap: 12px;
    }

    .payment-option {
      position: relative;
    }

    .payment-radio {
      position: absolute;

      opacity: 0;

      pointer-events: none;
    }

    .payment-label {
      display: block;

      height: 100%;

      padding: 18px;

      cursor: pointer;

      border-radius: 17px;

      background:
        var(--tb-soft);

      border:
        1px solid var(--tb-border);

      transition:
        transform .2s ease,
        border-color .2s ease,
        background .2s ease;
    }

    .payment-label:hover {
      transform:
        translateY(-2px);

      border-color:
        rgba(139,92,246,.28);
    }

    .payment-radio:checked + .payment-label {
      background:
        linear-gradient(
          135deg,
          rgba(37,99,235,.07),
          rgba(139,92,246,.12)
        );

      border-color:
        rgba(139,92,246,.40);

      box-shadow:
        0 0 0 3px rgba(139,92,246,.06);
    }

    .payment-icon {
      width: 41px;
      height: 41px;

      display: flex;
      align-items: center;
      justify-content: center;

      margin-bottom: 11px;

      border-radius: 12px;

      background:
        rgba(139,92,246,.10);

      font-size: 1.1rem;
    }

    .payment-title {
      margin-bottom: 4px;

      color:
        var(--tb-text);

      font-size: .8rem;

      font-weight: 900;
    }

    .payment-text {
      margin-bottom: 0;

      color:
        var(--tb-muted);

      font-size: .65rem;

      line-height: 1.5;
    }


    /* ==========================================================
       RESUMEN
       ========================================================== */

    .turn-summary {
      display: none;

      margin-bottom: 25px;

      padding: 18px;

      border-radius: 18px;

      background:
        linear-gradient(
          135deg,
          rgba(16,185,129,.06),
          rgba(139,92,246,.08)
        );

      border:
        1px solid rgba(16,185,129,.14);
    }

    .turn-summary-title {
      margin-bottom: 11px;

      color:
        var(--tb-text);

      font-size: .78rem;

      font-weight: 900;
    }

    .turn-summary-grid {
      display: grid;

      grid-template-columns:
        repeat(4,minmax(0,1fr));

      gap: 9px;
    }

    .turn-summary-item {
      padding: 10px;

      border-radius: 11px;

      background:
        var(--tb-surface);

      border:
        1px solid var(--tb-border);
    }

    .turn-summary-label {
      display: block;

      margin-bottom: 2px;

      color:
        var(--tb-muted);

      font-size: .55rem;

      font-weight: 850;

      text-transform: uppercase;

      letter-spacing: .05em;
    }

    .turn-summary-value {
      color:
        var(--tb-text);

      font-size: .68rem;

      font-weight: 800;
    }


    /* ==========================================================
       BOTONES
       ========================================================== */

    .turn-actions {
      display: flex;

      justify-content: flex-end;

      align-items: center;

      gap: 10px;

      flex-wrap: wrap;

      padding-top: 5px;
    }

    .turn-cancel-btn {
      min-height: 46px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      padding: 0 19px;

      border-radius: 12px;

      color:
        var(--tb-muted);

      background:
        var(--tb-soft);

      border:
        1px solid var(--tb-border);

      text-decoration: none;

      font-size: .75rem;

      font-weight: 800;
    }

    .turn-submit-btn {
      min-height: 46px;

      display: inline-flex;

      align-items: center;
      justify-content: center;

      gap: 7px;

      padding: 0 21px;

      border: 0;

      border-radius: 12px;

      color: white;

      background:
        linear-gradient(
          135deg,
          #2563eb,
          #8b5cf6
        );

      box-shadow:
        0 10px 24px rgba(139,92,246,.20);

      font-size: .75rem;

      font-weight: 850;

      transition:
        transform .2s ease,
        box-shadow .2s ease;
    }

    .turn-submit-btn:hover:not(:disabled) {
      transform:
        translateY(-2px);

      box-shadow:
        0 14px 30px rgba(139,92,246,.27);
    }

    .turn-submit-btn:disabled {
      opacity: .48;

      cursor: not-allowed;

      box-shadow: none;
    }


    /* ==========================================================
       FLATPICKR
       ========================================================== */

    .flatpickr-calendar {
      border: 0 !important;

      border-radius: 16px !important;

      box-shadow:
        0 18px 50px rgba(15,23,42,.18) !important;
    }

    .flatpickr-day.selected {
      background:
        #8b5cf6 !important;

      border-color:
        #8b5cf6 !important;
    }


    /* ==========================================================
       RESPONSIVE
       ========================================================== */

    @media (max-width: 991px) {

      .turn-steps {
        grid-template-columns:
          repeat(2,minmax(0,1fr));
      }

      .turn-summary-grid {
        grid-template-columns:
          repeat(2,minmax(0,1fr));
      }
    }

    @media (max-width: 767px) {

      .turn-booking-hero {
        padding: 24px;
      }

      .turn-booking-icon {
        width: 58px;
        height: 58px;
      }

      .turn-form-card {
        padding: 20px;
      }

      .turn-steps {
        grid-template-columns: 1fr;
      }

      .payment-grid {
        grid-template-columns: 1fr;
      }

      .turn-summary-grid {
        grid-template-columns: 1fr;
      }

      .turn-actions {
        flex-direction: column-reverse;
      }

      .turn-actions > * {
        width: 100%;
      }
    }


  //- ============================================================
  //- CONTENIDO
  //- ============================================================

  .turn-booking-page.tfu-page


    //- ==========================================================
    //- HERO
    //- ==========================================================

    .turn-booking-hero.tfu-hero

      .turn-booking-hero-content

        .row.align-items-center.g-4

          .col-lg-8

            .d-flex.align-items-center.gap-3

              .turn-booking-icon
                | 📅

              div

                .turn-booking-eyebrow
                  | ◆ TurnoFlex · Agenda inteligente

                if user && user.rol === 'cliente'

                  h1.turn-booking-title
                    | Solicitar turno

                  p.turn-booking-description
                    | Elegí profesional, modalidad, fecha y horario.
                    | TurnoFlex utilizará la disponibilidad configurada
                    | para mostrarte únicamente las opciones correspondientes.

                else

                  h1.turn-booking-title
                    | Registrar nuevo turno

                  p.turn-booking-description
                    | Gestioná la reserva del paciente seleccionando profesional,
                    | modalidad y disponibilidad desde la agenda médica.


          .col-lg-4

            .d-flex.justify-content-lg-end

              .turn-booking-status

                span.turn-booking-dot

                span
                  | Agenda disponible


    //- ==========================================================
    //- PASOS
    //- ==========================================================

    .turn-steps


      .turn-step

        .turn-step-number
          | 01

        div

          .turn-step-title
            | Paciente

          .turn-step-text
            | Identificación


      .turn-step

        .turn-step-number
          | 02

        div

          .turn-step-title
            | Profesional

          .turn-step-text
            | Especialidad


      .turn-step

        .turn-step-number
          | 03

        div

          .turn-step-title
            | Modalidad

          .turn-step-text
            | Tipo de consulta


      .turn-step

        .turn-step-number
          | 04

        div

          .turn-step-title
            | Fecha y hora

          .turn-step-text
            | Disponibilidad


      .turn-step

        .turn-step-number
          | 05

        div

          .turn-step-title
            | Confirmación

          .turn-step-text
            | Reserva y pago


    //- ==========================================================
    //- FORMULARIO
    //- ==========================================================

    form.turn-form-card.tfu-card(
      action="/turnos"
      method="POST"
      id="formTurno"
    )


      //- ========================================================
      //- 1. PACIENTE
      //- ========================================================

      .turn-section

        .turn-section-header

          .turn-section-icon
            | 👤

          div

            .turn-section-label
              | Paso 1

            h4.turn-section-title
              | Paciente


        if user && user.rol === 'cliente'

          if clientes && clientes.length > 0

            - var cli = clientes[0]
            - var cliId = cli._id || cli.id
            - var tieneObraSocial = cli.obraSocial && cli.obraSocial.empresa
            - var tipoCli = tieneObraSocial ? 'obra_social' : 'particular'

            .patient-fixed

              .patient-fixed-icon
                | 👤

              div

                h6.patient-fixed-name
                  = cli.nombre

                p.patient-fixed-text
                  | #{cli.email || 'Sin correo'} · #{tieneObraSocial ? cli.obraSocial.empresa : 'Paciente particular'}


            select.d-none(
              name="cliente_id"
              id="selectCliente"
              required
            )

              option(
                value=cliId
                data-tipocobertura=tipoCli
                selected
              )
                = cli.nombre

          else

            .alert.alert-warning.mb-0
              | No se encontró un perfil de paciente asociado a tu usuario.


        else

          label.turn-field-label(
            for="selectCliente"
          )
            | Seleccionar paciente
            span.required-mark
              |  *

          select.form-select.turn-control(
            name="cliente_id"
            id="selectCliente"
            required
          )

            option(
              value=""
              disabled
              selected
            )
              | Seleccioná un paciente...

            if clientes && clientes.length > 0

              each cli in clientes

                - var cliId = cli._id || cli.id
                - var tieneObraSocial = cli.obraSocial && cli.obraSocial.empresa
                - var tipoCli = tieneObraSocial ? 'obra_social' : 'particular'

                option(
                  value=cliId
                  data-tipocobertura=tipoCli
                )
                  | #{cli.nombre} — #{cli.email || 'Sin correo'}

          .turn-help
            | El tipo de cobertura del paciente se utilizará para filtrar profesionales compatibles.


      //- ========================================================
      //- 2. PROFESIONAL
      //- ========================================================

      .turn-section

        .turn-section-header

          .turn-section-icon
            | 🩺

          div

            .turn-section-label
              | Paso 2

            h4.turn-section-title
              | Profesional y disponibilidad


        label.turn-field-label(
          for="selectProfesional"
        )
          | Profesional
          span.required-mark
            |  *

        select.form-select.turn-control(
          name="profesional_id"
          id="selectProfesional"
          required
          disabled
        )

          option(
            value=""
            disabled
            selected
          )
            | Primero seleccioná un paciente...

          if profesionales && profesionales.length > 0

            each prof in profesionales

              - var profId = prof._id || prof.id
              - var rawDias = prof.diasAtencion || []
              - var cob = prof.tipoCobertura || 'ambas'
              - var sobDias = prof.diasSobreturnos || []
              - var telDias = prof.diasTelemedicina || []
              - var precioSena = 5000
              - var precioParticular = 0
              - var copago = 0

              if especialidades && especialidades.length > 0

                each esp in especialidades

                  if esp && esp.nombre === prof.especialidad

                    - precioSena = esp.montoSena || 5000
                    - precioParticular = Number(esp.precioParticular)
                    - copago = Number(esp.copagoObraSocial)

              option(
                value=profId
                data-dias=rawDias.join(',')
                data-inicio=prof.horaInicio || '08:00'
                data-fin=prof.horaFin || '18:00'
                data-duracion=prof.duracionTurnoMinutos || 30
                data-cobertura=cob
                data-sob-activo=prof.permiteSobreturnos ? 'true' : 'false'
                data-sob-dias=sobDias.join(',')
                data-sob-inicio=prof.horaInicioSobreturnos || ''
                data-sob-fin=prof.horaFinSobreturnos || ''
                data-tel-activo=prof.ofreceTelemedicina ? 'true' : 'false'
                data-tel-dias=telDias.join(',')
                data-tel-inicio=prof.horaInicioTelemedicina || ''
                data-tel-fin=prof.horaFinTelemedicina || ''
                data-sena=precioSena
                data-particular=precioParticular
                data-copago=copago
                data-nombre=prof.nombre || 'Profesional'
                data-especialidad=prof.especialidad || 'General'
              )
                | #{prof.nombre} — #{prof.especialidad || 'General'}

        .turn-help
          | Se mostrarán profesionales compatibles con la cobertura del paciente.


        #infoAgenda
        if user && user.rol === 'cliente'
          #precioTurno.turn-help(data-descuento=transferenciaDescuentoPct)
            | Elegí un profesional para ver el importe del copago o la consulta particular.


      //- ========================================================
      //- 3. MODALIDAD
      //- ========================================================

      .turn-section

        .turn-section-header

          .turn-section-icon
            | 🏥

          div

            .turn-section-label
              | Paso 3

            h4.turn-section-title
              | Modalidad de atención


        label.turn-field-label(
          for="selectModalidad"
        )
          | Tipo de atención
          span.required-mark
            |  *

        select.form-select.turn-control(
          name="modalidadTurno"
          id="selectModalidad"
          required
          disabled
        )

          option(
            value=""
            disabled
            selected
          )
            | Primero seleccioná un profesional...

        .turn-help
          | Las opciones disponibles dependen de la configuración de agenda del profesional.


      //- ========================================================
      //- 4. FECHA Y HORARIO
      //- ========================================================

      .turn-section

        .turn-section-header

          .turn-section-icon
            | 🕐

          div

            .turn-section-label
              | Paso 4

            h4.turn-section-title
              | Fecha y horario


        .row.g-4


          .col-md-6

            label.turn-field-label(
              for="inputFecha"
            )
              | Fecha
              span.required-mark
                |  *

            input.form-control.turn-control(
              type="text"
              name="fecha"
              id="inputFecha"
              required
              disabled
              placeholder="Elegí una fecha..."
              autocomplete="off"
            )

            .turn-help
              | Solo podrás seleccionar días en los que el profesional atiende.


          .col-md-6

            label.turn-field-label(
              for="inputHora"
            )
              | Horario disponible
              span.required-mark
                |  *

            select.form-select.turn-control(
              name="hora"
              id="inputHora"
              required
              disabled
            )

              option(
                value=""
                disabled
                selected
              )
                | Primero elegí una fecha...


      //- ========================================================
      //- 5. PAGO
      //- ========================================================

      .turn-section

        .turn-section-header

          .turn-section-icon
            | 💳

          div

            .turn-section-label
              | Paso 5

            if user && user.rol === 'cliente'

              h4.turn-section-title
                | Medio de pago

            else

              h4.turn-section-title
                | Confirmación administrativa


        if user && user.rol === 'cliente'

          .payment-grid


            .payment-option

              input.payment-radio(
                type="radio"
                name="metodo_pago"
                id="pagoMercadoPago"
                value="mercadopago"
                checked
                required
              )

              label.payment-label(
                for="pagoMercadoPago"
              )

                .payment-icon
                  | 💳

                h6.payment-title
                  | Mercado Pago

                p.payment-text
                  | Pagá el importe de tu consulta o copago mediante el checkout de Mercado Pago.


            .payment-option
              input.payment-radio(
                type="radio"
                name="metodo_pago"
                id="pagoTransferencia"
                value="transferencia"
                required
              )
              label.payment-label(for="pagoTransferencia")
                .payment-icon
                  | 🏦
                h6.payment-title
                  | PagoFlex · Transferencia
                p.payment-text
                  | Transferí a la cuenta de la clínica. Descuento solo en consultas particulares, si está habilitado. Requiere validación de recepción.


            .payment-option

              input.payment-radio(
                type="radio"
                name="metodo_pago"
                id="pagoEfectivo"
                value="efectivo"
                required
              )

              label.payment-label(
                for="pagoEfectivo"
              )

                .payment-icon
                  | 💵

                h6.payment-title
                  | Efectivo en recepción

                p.payment-text
                  | Reservá el turno ahora y aboná presencialmente en recepción.


        else

          //- Los importes solo se eligen entre aranceles configurados.
          .row.g-3
            .col-md-6
              label.turn-field-label(for='recepcionTipoCobro') Tipo de atención *
              select#recepcionTipoCobro.form-select.turn-control(name='tipoCobro' required)
                option(value='' selected disabled) Elegí un tipo de atención...
                option(value='particular') Consulta particular
                option(value='copago') Consulta con copago
                option(value='sin_cargo') Cobertura total ($0)
            .col-md-6
              label.turn-field-label(for='recepcionMetodoPago') Medio de pago *
              select#recepcionMetodoPago.form-select.turn-control(name='metodo_pago' required)
                option(value='efectivo' selected) Efectivo en recepción
                option(value='mercadopago') Mercado Pago (desde detalle)
                option(value='transferencia') PagoFlex · Transferencia bancaria

          .form-check.mt-3#recepcionVerificacion
            input#coberturaVerificada.form-check-input(type='checkbox' name='coberturaVerificada' value='si')
            label.form-check-label(for='coberturaVerificada')
              | Confirmé que la cobertura, el plan y el convenio permiten este copago o cobertura total.

          .patient-fixed.mt-3#recepcionImporte(role='status' aria-live='polite')
            .patient-fixed-icon
              | 🧾
            div.flex-grow-1
              h6.patient-fixed-name.mb-2 Cotización para este turno
              p.patient-fixed-text.mb-2#recepcionEstadoCotizacion Elegí paciente, profesional y tipo de atención.
              dl.row.mb-0
                dt.col-7 Importe base
                dd.col-5.text-end#recepcionBase —
                dt.col-7 Descuento autorizado
                dd.col-5.text-end#recepcionDescuento —
                dt.col-7 Total a abonar
                dd.col-5.text-end.fw-bold#recepcionTotal —
              small#recepcionNotaCotizacion.text-muted
                | El importe final se calcula nuevamente en el servidor al reservar.



      //- ========================================================
      //- RESUMEN
      //- ========================================================

      p.turn-help El copago y el precio particular se calculan con los importes de la especialidad en el servidor. El descuento por transferencia, si corresponde, se muestra en el detalle del turno.

      #resumenTurno.turn-summary

        h6.turn-summary-title
          | ✓ Resumen de la reserva

        .turn-summary-grid


          .turn-summary-item

            span.turn-summary-label
              | Profesional

            span.turn-summary-value#resumenProfesional
              | —


          .turn-summary-item

            span.turn-summary-label
              | Modalidad

            span.turn-summary-value#resumenModalidad
              | —


          .turn-summary-item

            span.turn-summary-label
              | Fecha

            span.turn-summary-value#resumenFecha
              | —


          .turn-summary-item

            span.turn-summary-label
              | Horario

            span.turn-summary-value#resumenHorario
              | —


      //- ========================================================
      //- ACCIONES
      //- ========================================================

      .turn-actions


        if user && user.rol === 'cliente'

          a.turn-cancel-btn(
            href="/"
          )
            | Cancelar

        else

          a.turn-cancel-btn(
            href="/turnos"
          )
            | Cancelar


        button.turn-submit-btn(
          type="submit"
          id="btnSubmit"
          disabled
        )

          span#submitIcon
            | ✓

          span#submitText
            | Confirmar turno


  //- ============================================================
  //- JAVASCRIPT
  //- ============================================================

  script.
    document.addEventListener(
      'DOMContentLoaded',
      function () {

        const selectCliente =
          document.getElementById(
            'selectCliente'
          );

        const selectProf =
          document.getElementById(
            'selectProfesional'
          );

        const selectModalidad =
          document.getElementById(
            'selectModalidad'
          );

        const inputFecha =
          document.getElementById(
            'inputFecha'
          );

        const inputHora =
          document.getElementById(
            'inputHora'
          );

        const infoAgenda =
          document.getElementById(
            'infoAgenda'
          );

        const btnSubmit =
          document.getElementById(
            'btnSubmit'
          );

        const formulario =
          document.getElementById(
            'formTurno'
          );

        const resumenTurno =
          document.getElementById(
            'resumenTurno'
          );

        const resumenProfesional =
          document.getElementById(
            'resumenProfesional'
          );

        const resumenModalidad =
          document.getElementById(
            'resumenModalidad'
          );

        const resumenFecha =
          document.getElementById(
            'resumenFecha'
          );

        const resumenHorario =
          document.getElementById(
            'resumenHorario'
          );

        const submitText =
          document.getElementById(
            'submitText'
          );

        const submitIcon =
          document.getElementById(
            'submitIcon'
          );


        if (
          !selectCliente ||
          !selectProf ||
          !selectModalidad ||
          !inputFecha ||
          !inputHora ||
          !btnSubmit
        ) {

          return;

        }


        const opcionesProfesionalesOriginales =
          Array.from(
            selectProf.querySelectorAll(
              'option:not([disabled])'
            )
          );


        const nombresDias = [
          'Domingo',
          'Lunes',
          'Martes',
          'Miércoles',
          'Jueves',
          'Viernes',
          'Sábado'
        ];


        const mapaDiasANumeros = {
          'Domingo': 0,
          'Lunes': 1,
          'Martes': 2,
          'Miércoles': 3,
          'Jueves': 4,
          'Viernes': 5,
          'Sábado': 6
        };


        let configActual = {};

        let calendario = null;


        // ======================================================
        // CALENDARIO
        // ======================================================

        if (
          typeof flatpickr !==
          'undefined'
        ) {

          calendario =
            flatpickr(
              inputFecha,
              {

                locale:
                  'es',

                dateFormat:
                  'Y-m-d',

                minDate:
                  'today',

                disable:
                  [],

                onChange:
                  function (
                    selectedDates,
                    dateStr
                  ) {

                    if (dateStr) {

                      actualizarHorarios();

                      actualizarResumen();

                    }

                  }

              }
            );

        }


        // ======================================================
        // UTILIDADES
        // ======================================================

        function parsearDias(
          texto
        ) {

          if (
            !texto ||
            texto.trim() === ''
          ) {

            return [];

          }


          return texto
            .split(',')
            .map(
              function (dia) {

                const valor =
                  dia.trim();


                if (
                  !isNaN(valor)
                ) {

                  return parseInt(
                    valor,
                    10
                  );

                }


                return mapaDiasANumeros[
                  valor
                ];

              }
            )
            .filter(
              function (numero) {

                return (
                  numero !== undefined &&
                  !isNaN(numero)
                );

              }
            );

        }


        function formatearDias(
          texto
        ) {

          const numeros =
            parsearDias(
              texto
            );


          if (
            numeros.length === 0
          ) {

            return 'Ninguno';

          }


          return numeros
            .map(
              function (numero) {

                return nombresDias[
                  numero
                ];

              }
            )
            .join(', ');

        }


        function formatoPrecio(
          valor
        ) {

          const numero =
            Number(
              valor || 0
            );


          return numero
            .toLocaleString(
              'es-AR',
              {
                style:
                  'currency',

                currency:
                  'ARS',

                maximumFractionDigits:
                  0
              }
            );

        }


        // ======================================================
        // REINICIAR CAMPOS POSTERIORES
        // ======================================================

        function limpiarDesdeProfesional() {

          selectModalidad.innerHTML =
            '<option value="" disabled selected>Primero seleccioná un profesional...</option>';

          selectModalidad.disabled =
            true;


          inputFecha.disabled =
            true;


          inputHora.disabled =
            true;

          inputHora.innerHTML =
            '<option value="" disabled selected>Primero elegí una fecha...</option>';


          btnSubmit.disabled =
            true;


          infoAgenda.style.display =
            'none';


          if (calendario) {

            calendario.clear();

          }


          actualizarResumen();

        }


        function limpiarDesdeModalidad() {

          inputFecha.disabled =
            true;


          inputHora.disabled =
            true;

          inputHora.innerHTML =
            '<option value="" disabled selected>Primero elegí una fecha...</option>';


          btnSubmit.disabled =
            true;


          if (calendario) {

            calendario.clear();

          }


          actualizarResumen();

        }


        // ======================================================
        // PACIENTE
        // ======================================================

        selectCliente.addEventListener(
          'change',
          function () {

            const opcionCliente =
              this.options[
                this.selectedIndex
              ];


            const tipoCliente =
              opcionCliente
                ? opcionCliente.getAttribute(
                    'data-tipocobertura'
                  )
                : 'particular';


            selectProf.innerHTML =
              '<option value="" disabled selected>Seleccioná un profesional...</option>';


            let cantidadCompatibles =
              0;


            opcionesProfesionalesOriginales
              .forEach(
                function (opcion) {

                  const cobertura =
                    opcion.getAttribute(
                      'data-cobertura'
                    ) || 'ambas';


                  const compatibleParticular =
                    tipoCliente === 'particular' &&
                    (
                      cobertura === 'particular' ||
                      cobertura === 'ambas'
                    );


                  const compatibleObraSocial =
                    tipoCliente === 'obra_social' &&
                    (
                      cobertura === 'obra_social' ||
                      cobertura === 'ambas'
                    );


                  if (
                    compatibleParticular ||
                    compatibleObraSocial
                  ) {

                    selectProf.appendChild(
                      opcion.cloneNode(true)
                    );

                    cantidadCompatibles++;

                  }

                }
              );


            if (
              cantidadCompatibles === 0
            ) {

              const opcionVacia =
                document.createElement(
                  'option'
                );


              opcionVacia.disabled =
                true;

              opcionVacia.textContent =
                'No hay profesionales compatibles';


              selectProf.appendChild(
                opcionVacia
              );

            }


            selectProf.disabled =
              cantidadCompatibles === 0;


            limpiarDesdeProfesional();

          }
        );


        // ======================================================
        // PROFESIONAL
        // ======================================================

        selectProf.addEventListener(
          'change',
          function () {

            const opcion =
              selectProf.options[
                selectProf.selectedIndex
              ];


            if (
              !opcion ||
              !opcion.value
            ) {

              return;

            }


            configActual = {

              diasRegulares:
                parsearDias(
                  opcion.getAttribute(
                    'data-dias'
                  )
                ),

              inicioReg:
                opcion.getAttribute(
                  'data-inicio'
                ) || '08:00',

              finReg:
                opcion.getAttribute(
                  'data-fin'
                ) || '18:00',

              duracionReg:
                parseInt(
                  opcion.getAttribute(
                    'data-duracion'
                  ),
                  10
                ) || 30,

              sobActivo:
                opcion.getAttribute(
                  'data-sob-activo'
                ) === 'true',

              diasSob:
                parsearDias(
                  opcion.getAttribute(
                    'data-sob-dias'
                  )
                ),

              inicioSob:
                opcion.getAttribute(
                  'data-sob-inicio'
                ) || '',

              finSob:
                opcion.getAttribute(
                  'data-sob-fin'
                ) || '',

              telActivo:
                opcion.getAttribute(
                  'data-tel-activo'
                ) === 'true',

              diasTel:
                parsearDias(
                  opcion.getAttribute(
                    'data-tel-dias'
                  )
                ),

              inicioTel:
                opcion.getAttribute(
                  'data-tel-inicio'
                ) || '',

              finTel:
                opcion.getAttribute(
                  'data-tel-fin'
                ) || '',

              sena:
                Number(
                  opcion.getAttribute(
                    'data-sena'
                  )
                ) || 5000,

              nombre:
                opcion.getAttribute(
                  'data-nombre'
                ) || 'Profesional',

              especialidad:
                opcion.getAttribute(
                  'data-especialidad'
                ) || 'General'

            };


            const diasPresencial =
              formatearDias(
                opcion.getAttribute(
                  'data-dias'
                )
              );


            const diasSob =
              formatearDias(
                opcion.getAttribute(
                  'data-sob-dias'
                )
              );


            const diasTel =
              formatearDias(
                opcion.getAttribute(
                  'data-tel-dias'
                )
              );


            let textoInfo =
              '<div class="agenda-info-title">Disponibilidad del profesional</div>';


            textoInfo +=
              '🏥 <strong>Presencial:</strong> ' +
              diasPresencial +
              ' · ' +
              configActual.inicioReg +
              ' a ' +
              configActual.finReg +
              '<br>';


            textoInfo +=
              '⚡ <strong>Sobreturnos:</strong> ' +
              (
                configActual.sobActivo
                  ? diasSob
                  : 'No habilitados'
              ) +
              '<br>';


            textoInfo +=
              '💻 <strong>Telemedicina:</strong> ' +
              (
                configActual.telActivo
                  ? diasTel
                  : 'No habilitada'
              );


            textoInfo +=
              '<br>💳 <strong>Precio:</strong> consultá debajo el importe particular o copago de referencia.';


            infoAgenda.innerHTML =
              textoInfo;

            infoAgenda.style.display =
              'block';


            // ================================================
            // MODALIDADES
            // ================================================

            selectModalidad.innerHTML =
              '<option value="" disabled selected>Seleccioná una modalidad...</option>';


            const opcionPresencial =
              document.createElement(
                'option'
              );


            opcionPresencial.value =
              'regular';


            if (
              configActual.diasRegulares.length >
              0
            ) {

              opcionPresencial.textContent =
                'Presencial · ' +
                diasPresencial;

            } else {

              opcionPresencial.textContent =
                'Presencial · No disponible';

              opcionPresencial.disabled =
                true;

            }


            selectModalidad.appendChild(
              opcionPresencial
            );


            const opcionSob =
              document.createElement(
                'option'
              );


            opcionSob.value =
              'sobreturno';


            if (
              configActual.sobActivo &&
              configActual.diasSob.length >
              0
            ) {

              opcionSob.textContent =
                'Sobreturno · ' +
                diasSob;

            } else {

              opcionSob.textContent =
                'Sobreturno · No disponible';

              opcionSob.disabled =
                true;

            }


            selectModalidad.appendChild(
              opcionSob
            );


            const opcionTele =
              document.createElement(
                'option'
              );


            opcionTele.value =
              'telemedicina';


            if (
              configActual.telActivo &&
              configActual.diasTel.length >
              0
            ) {

              opcionTele.textContent =
                'Telemedicina · ' +
                diasTel;

            } else {

              opcionTele.textContent =
                'Telemedicina · No disponible';

              opcionTele.disabled =
                true;

            }


            selectModalidad.appendChild(
              opcionTele
            );


            selectModalidad.disabled =
              false;


            limpiarDesdeModalidad();

          }
        );


        // ======================================================
        // MODALIDAD
        // ======================================================

        selectModalidad.addEventListener(
          'change',
          function () {

            const modalidad =
              selectModalidad.value;


            let diasPermitidos =
              configActual.diasRegulares;


            if (
              modalidad ===
              'sobreturno'
            ) {

              diasPermitidos =
                configActual.diasSob;

            }


            if (
              modalidad ===
              'telemedicina'
            ) {

              diasPermitidos =
                configActual.diasTel;

            }


            if (calendario) {

              calendario.set(
                'disable',
                [
                  function (fecha) {

                    return !diasPermitidos
                      .includes(
                        fecha.getDay()
                      );

                  }
                ]
              );


              calendario.clear();

            }


            inputFecha.disabled =
              false;


            inputHora.disabled =
              true;

            inputHora.innerHTML =
              '<option value="" disabled selected>Primero elegí una fecha...</option>';


            btnSubmit.disabled =
              true;


            actualizarResumen();

          }
        );


        // ======================================================
        // GENERAR HORARIOS
        // ======================================================

        function actualizarHorarios() {

          inputHora.innerHTML =
            '<option value="" disabled selected>Elegí un horario...</option>';


          const modalidad =
            selectModalidad.value;


          let inicio =
            configActual.inicioReg;

          let fin =
            configActual.finReg;

          let duracion =
            configActual.duracionReg;


          if (
            modalidad ===
            'sobreturno'
          ) {

            inicio =
              configActual.inicioSob ||
              configActual.inicioReg;

            fin =
              configActual.finSob ||
              configActual.finReg;

            duracion =
              20;

          }


          if (
            modalidad ===
            'telemedicina'
          ) {

            inicio =
              configActual.inicioTel ||
              configActual.inicioReg;

            fin =
              configActual.finTel ||
              configActual.finReg;

            duracion =
              20;

          }


          if (
            !inicio ||
            !fin
          ) {

            return;

          }


          const inicioPartes =
            inicio.split(':');

          const finPartes =
            fin.split(':');


          let minutosActuales =
            Number(
              inicioPartes[0]
            ) * 60 +
            Number(
              inicioPartes[1]
            );


          const minutosFinales =
            Number(
              finPartes[0]
            ) * 60 +
            Number(
              finPartes[1]
            );


          const fechaSeleccionada =
            inputFecha.value;


          const ahora =
            new Date();


          const anio =
            ahora.getFullYear();

          const mes =
            String(
              ahora.getMonth() + 1
            ).padStart(
              2,
              '0'
            );

          const dia =
            String(
              ahora.getDate()
            ).padStart(
              2,
              '0'
            );


          const hoyTexto =
            anio +
            '-' +
            mes +
            '-' +
            dia;


          const minutosAhora =
            ahora.getHours() * 60 +
            ahora.getMinutes();


          let cantidad =
            0;


          while (
            minutosActuales +
            duracion <=
            minutosFinales
          ) {

            const hora =
              Math.floor(
                minutosActuales / 60
              );


            const minuto =
              minutosActuales % 60;


            const valor =
              String(hora)
                .padStart(
                  2,
                  '0'
                ) +
              ':' +
              String(minuto)
                .padStart(
                  2,
                  '0'
                );


            const horarioPasadoHoy =
              fechaSeleccionada ===
              hoyTexto &&
              minutosActuales <=
              minutosAhora;


            if (
              !horarioPasadoHoy
            ) {

              const opcion =
                document.createElement(
                  'option'
                );


              opcion.value =
                valor;


              opcion.textContent =
                valor +
                ' hs · ' +
                duracion +
                ' min';


              inputHora.appendChild(
                opcion
              );


              cantidad++;

            }


            minutosActuales +=
              duracion;

          }


          if (
            cantidad === 0
          ) {

            const opcionSinTurnos =
              document.createElement(
                'option'
              );


            opcionSinTurnos.disabled =
              true;

            opcionSinTurnos.textContent =
              'No hay horarios disponibles para esta fecha';


            inputHora.appendChild(
              opcionSinTurnos
            );


            inputHora.disabled =
              true;

            btnSubmit.disabled =
              true;

          } else {

            inputHora.disabled =
              false;

          }

        }


        // ======================================================
        // HORARIO
        // ======================================================

        inputHora.addEventListener(
          'change',
          function () {

            btnSubmit.disabled =
              !inputHora.value;


            actualizarResumen();

          }
        );


        // ======================================================
        // RESUMEN
        // ======================================================

        function actualizarResumen() {

          if (
            !resumenTurno
          ) {

            return;

          }


          const profesionalSeleccionado =
            selectProf.options[
              selectProf.selectedIndex
            ];


          const modalidadSeleccionada =
            selectModalidad.options[
              selectModalidad.selectedIndex
            ];


          const hayDatos =
            profesionalSeleccionado &&
            profesionalSeleccionado.value &&
            selectModalidad.value &&
            inputFecha.value &&
            inputHora.value;


          if (
            !hayDatos
          ) {

            resumenTurno.style.display =
              'none';

            return;

          }


          resumenProfesional.textContent =
            configActual.nombre ||
            profesionalSeleccionado.textContent;


          resumenModalidad.textContent =
            modalidadSeleccionada
              ? modalidadSeleccionada.textContent
              : '—';


          resumenFecha.textContent =
            inputFecha.value ||
            '—';


          resumenHorario.textContent =
            inputHora.value
              ? inputHora.value +
                ' hs'
              : '—';


          resumenTurno.style.display =
            'block';

        }


        // ======================================================
        // MEDIO DE PAGO
        // ======================================================

        const radiosPago =
          document.querySelectorAll(
            'input[name="metodo_pago"]'
          );

        // Vista previa orientativa. El servidor calcula el importe definitivo.
        const cajaPrecio = document.getElementById('precioTurno');
        function mostrarPrecioOrientativo() {
          if (!cajaPrecio) return;
          const opcProf = selectProf.options[selectProf.selectedIndex];
          const opcCliente = selectCliente.options[selectCliente.selectedIndex];
          if (!opcProf || !opcProf.value || !opcCliente || !opcCliente.value) {
            cajaPrecio.textContent = 'Elegí un paciente y un profesional para ver el precio.';
            return;
          }
          const conObra = opcCliente.getAttribute('data-tipocobertura') === 'obra_social';
          const compatible = opcProf.getAttribute('data-cobertura') !== 'particular';
          const esCopago = conObra && compatible;
          const base = Number(opcProf.getAttribute(esCopago ? 'data-copago' : 'data-particular'));
          if (!Number.isFinite(base) || base < 0 || (!esCopago && base === 0)) {
            cajaPrecio.textContent = 'Este profesional no tiene un precio configurado.';
            return;
          }
          const elegido = document.querySelector('input[name="metodo_pago"]:checked');
          const pct = !esCopago && elegido?.value === 'transferencia'
            ? Number(cajaPrecio.getAttribute('data-descuento') || 0) : 0;
          const importe = (Math.round(base*100) - Math.round(Math.round(base*100)*pct/100))/100;
          const dinero = valor => valor.toLocaleString('es-AR',{style:'currency',currency:'ARS'});
          cajaPrecio.textContent = esCopago && base === 0
            ? 'Cobertura total: no requiere pago.'
            : `${esCopago ? 'Copago' : 'Consulta particular'}: ${dinero(base)}${pct>0 ? ` · Descuento ${pct}% por transferencia` : ''} · Total: ${dinero(importe)}`;
        }
        selectCliente.addEventListener('change', () => setTimeout(mostrarPrecioOrientativo, 0));
        selectProf.addEventListener('change', mostrarPrecioOrientativo);
        radiosPago.forEach(radio => radio.addEventListener('change', mostrarPrecioOrientativo));
        mostrarPrecioOrientativo();



        function actualizarTextoPago() {

          const elegido =
            document.querySelector(
              'input[name="metodo_pago"]:checked'
            );


          if (
            !elegido ||
            !submitText
          ) {

            return;

          }


          if (
            elegido.value ===
            'mercadopago'
          ) {

            submitText.textContent =
              'Continuar a Mercado Pago';

          } else {

            submitText.textContent =
              'Reservar turno';

          }

        }


        radiosPago.forEach(
          function (radio) {

            radio.addEventListener(
              'change',
              actualizarTextoPago
            );

          }
        );


        actualizarTextoPago();


        // ======================================================
        // ENVÍO
        // ======================================================

        if (formulario) {

          formulario.addEventListener(
            'submit',
            function () {

              if (
                !formulario.checkValidity()
              ) {

                return;

              }


              btnSubmit.disabled =
                true;


              if (submitIcon) {

                submitIcon.textContent =
                  '◷';

              }


              if (submitText) {

                submitText.textContent =
                  'Procesando turno...';

              }

            }
          );

        }


        // ======================================================
        // PACIENTE PRESELECCIONADO DESDE FICHA O GRUPO FAMILIAR
        // ======================================================

        const parametrosURL = new URLSearchParams(window.location.search);
        const pacienteDesdeURL = parametrosURL.get('cliente');

        // Solo se preselecciona si el paciente está entre
        // las opciones proporcionadas por el servidor.
        if (pacienteDesdeURL) {
          const opcionEncontrada = Array.from(selectCliente.options).find(
            function (opcion) {
              return opcion.value === pacienteDesdeURL;
            }
          );

          if (opcionEncontrada) {
            selectCliente.value = pacienteDesdeURL;
          }
        }

        // Reutilizamos el controlador de cambios que ya existe.
        // Habilita y filtra profesionales compatibles.
        if (selectCliente.value) {
          selectCliente.dispatchEvent(new Event('change'));
        }

      }
    );

  //- Vista previa de cotización obtenida del servidor, exclusiva de recepción.
  if user && (user.rol === 'admin' || user.rol === 'personal')
    script(src='/js/recepcion-cotizacion.js?v=1' defer)
