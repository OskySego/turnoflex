//- ============================================================
//- VISTA DE ALTA DE NUEVO PROFESIONAL - TURNOFLEX
//- ============================================================
//- Plantilla Pug para dar de alta a un profesional del equipo médico.
//- Organizo el formulario en cinco pasos (identificación, datos regulatorios,
//- agenda regular, sobreturnos y telemedicina) con paneles desplegables
//- y validaciones previas al envío.

extends layout

block content

  //- ============================================================
  //- 1. DATOS AUXILIARES DE LA VISTA
  //- ============================================================

  //- Defino los días de la semana para reutilizarlos en las grillas de agenda
  - const diasSemana = [{ id: 'lunes', nombre: 'Lunes' }, { id: 'martes', nombre: 'Martes' }, { id: 'miercoles', nombre: 'Miércoles' }, { id: 'jueves', nombre: 'Jueves' }, { id: 'viernes', nombre: 'Viernes' }, { id: 'sabado', nombre: 'Sábado' }, { id: 'domingo', nombre: 'Domingo' }]

  //- ============================================================
  //- 3. ESTRUCTURA PRINCIPAL DE LA PÁGINA
  //- ============================================================

  .new-prof-page.tfu-page

    //- Cabecera visual de presentación
    .new-prof-hero.tfu-hero
      .new-prof-hero-content
        .row.align-items-center.g-4
          .col-lg-8
            .d-flex.align-items-center.gap-3
              .new-prof-icon
                | 🩺
              div
                .new-prof-eyebrow
                  | ◆ TurnoFlex · Equipo Médico
                h1.new-prof-title
                  | Registrar profesional
                p.new-prof-description
                  | Configurá el perfil profesional, cobertura aceptada,
                  | agenda regular, sobreturnos y telemedicina desde un único formulario.
          .col-lg-4
            .d-flex.justify-content-lg-end
              .new-prof-status
                span.new-prof-status-dot
                span
                  | Nuevo profesional

    //- Barra visual con los 5 pasos del formulario
    .prof-steps
      .prof-step
        .prof-step-number
          | 01
        div
          .prof-step-title
            | Identificación
          .prof-step-text
            | Datos y contacto

      .prof-step
        .prof-step-number
          | 02
        div
          .prof-step-title
            | Profesional
          .prof-step-text
            | Matrícula y especialidad

      .prof-step
        .prof-step-number
          | 03
        div
          .prof-step-title
            | Agenda
          .prof-step-text
            | Días y horarios

      .prof-step
        .prof-step-number
          | 04
        div
          .prof-step-title
            | Sobreturnos
          .prof-step-text
            | Configuración opcional

      .prof-step
        .prof-step-number
          | 05
        div
          .prof-step-title
            | Telemedicina
          .prof-step-text
            | Videoconsultas


    //- ==========================================================
    //- 4. FORMULARIO DE ALTA DE PROFESIONAL
    //- ==========================================================

    form.new-prof-form.tfu-card(action="/profesionales" method="POST" id="formNuevoProfesional")
      //- Inyecto el token CSRF si el servidor lo proporciona
      if typeof csrfToken !== "undefined" && csrfToken
        input(type="hidden" name="_csrf" value=csrfToken)

      //- --------------------------------------------------------
      //- PASO 1: IDENTIFICACIÓN Y CONTACTO
      //- --------------------------------------------------------
      .prof-form-section
        .prof-section-header
          .prof-section-icon
            | 👤
          div
            .prof-section-label
              | Paso 1
            h4.prof-section-title
              | Identificación y contacto

        .row.g-4
          .col-md-6
            label.prof-field-label(for="nombre")
              | Nombre completo
              span.required-mark
                |  *
            input.form-control.prof-control(type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Ej: Dra. Laura Fernández")

          .col-md-6
            label.prof-field-label(for="dni")
              | DNI / Pasaporte
              span.required-mark
                |  *
            input.form-control.prof-control(type="text" id="dni" name="dni" required placeholder="Número de documento")
            .prof-help
              | Debe ser único para cada profesional.

          .col-md-4
            label.prof-field-label(for="genero")
              | Género
              span.required-mark
                |  *
            select.form-select.prof-control(id="genero" name="genero" required)
              option(value="" selected disabled)
                | Seleccionar...
              option(value="Masculino")
                | Masculino
              option(value="Femenino")
                | Femenino
              option(value="Otro")
                | Otro

          .col-md-4
            label.prof-field-label(for="email")
              | Correo electrónico
              span.required-mark
                |  *
            input.form-control.prof-control(type="email" id="email" name="email" required autocomplete="email" placeholder="profesional@correo.com")
            .prof-help
              | Este correo puede asociarse al acceso profesional.

          .col-md-4
            label.prof-field-label(for="telefono")
              | Teléfono
              span.required-mark
                |  *
            input.form-control.prof-control(type="text" id="telefono" name="telefono" required autocomplete="tel" placeholder="Ej: 1155443322")

      //- --------------------------------------------------------
      //- PASO 2: INFORMACIÓN PROFESIONAL Y COBERTURA
      //- --------------------------------------------------------
      .prof-form-section
        .prof-section-header
          .prof-section-icon
            | 🪪
          div
            .prof-section-label
              | Paso 2
            h4.prof-section-title
              | Información profesional y cobertura

        .row.g-4
          .col-md-6.col-lg-4
            label.prof-field-label(for="matricula")
              | Matrícula profesional
              span.required-mark
                |  *
            input.form-control.prof-control(type="text" id="matricula" name="matricula" required placeholder="Ej: MN 123456")
            .prof-help
              | La matrícula debe ser única dentro del sistema.

          .col-md-6.col-lg-4
            label.prof-field-label(for="especialidad")
              | Especialidad principal
              span.required-mark
                |  *
            input.form-control.prof-control(type="text" id="especialidad" name="especialidad" required placeholder="Ej: Clínica Médica")

          .col-md-6.col-lg-4
            label.prof-field-label(for="subespecialidad")
              | Subespecialidad
              span.required-mark
                |  *
            input.form-control.prof-control(type="text" id="subespecialidad" name="subespecialidad" required placeholder="Ej: Diabetes y metabolismo")
            .prof-help
              | Si no posee, podés ingresar “General”.

          .col-md-6
            label.prof-field-label(for="tipoCobertura")
              | Cobertura aceptada
              span.required-mark
                |  *
            select.form-select.prof-control(id="tipoCobertura" name="tipoCobertura" required)
              option(value="ambas")
                | Particular y Obra Social
              option(value="particular")
                | Solo Particular
              option(value="obra_social")
                | Solo Obra Social / Prepaga

          .col-md-6
            label.prof-field-label(for="sede")
              | Sede / Consultorio
            input.form-control.prof-control(type="text" id="sede" name="sede" placeholder="Ej: Sede Central - Consultorio 3")

      //- --------------------------------------------------------
      //- PASO 3: CONFIGURACIÓN DE AGENDA REGULAR
      //- --------------------------------------------------------
      .prof-form-section
        .prof-section-header
          .prof-section-icon
            | 📅
          div
            .prof-section-label
              | Paso 3
            h4.prof-section-title
              | Configuración de agenda regular

        .mb-4
          label.prof-field-label
            | Días de atención
            span.required-mark
              |  *
          .days-panel
            .days-grid
              each dia in diasSemana
                .day-option
                  input.day-checkbox.dia-regular(type="checkbox" id=`regular-${dia.id}` name="diasAtencion" value=dia.nombre)
                  label.day-label(for=`regular-${dia.id}`)
                    = dia.nombre
          .prof-help
            | Seleccioná al menos un día de atención regular.

        .row.g-4
          .col-md-6
            label.prof-field-label(for="modalidad")
              | Modalidad principal
            select.form-select.prof-control(id="modalidad" name="modalidad")
              option(value="presencial")
                | Presencial
              option(value="telemedicina")
                | Telemedicina
              option(value="ambas")
                | Presencial y Telemedicina

          .col-md-6
            label.prof-field-label(for="duracionTurnoMinutos")
              | Duración de cada turno
            select.form-select.prof-control(id="duracionTurnoMinutos" name="duracionTurnoMinutos")
              option(value="15")
                | 15 minutos
              option(value="20")
                | 20 minutos
              option(value="30" selected)
                | 30 minutos
              option(value="40")
                | 40 minutos
              option(value="45")
                | 45 minutos
              option(value="60")
                | 60 minutos

          .col-md-6
            label.prof-field-label(for="horaInicio")
              | Hora de inicio
              span.required-mark
                |  *
            input.form-control.prof-control(type="time" id="horaInicio" name="horaInicio" value="08:00" required)

          .col-md-6
            label.prof-field-label(for="horaFin")
              | Hora de finalización
              span.required-mark
                |  *
            input.form-control.prof-control(type="time" id="horaFin" name="horaFin" value="16:00" required)

        .configuration-info
          | 💡 Esta configuración determina los horarios regulares que
          | TurnoFlex utilizará al momento de ofrecer turnos disponibles.

      //- --------------------------------------------------------
      //- PASO 4: CONFIGURACIÓN DE SOBRETURNOS (OPCIONAL)
      //- --------------------------------------------------------
      .prof-form-section
        .prof-section-header
          .prof-section-icon
            | ⚡
          div
            .prof-section-label
              | Paso 4
            h4.prof-section-title
              | Configuración de sobreturnos

        .feature-toggle
          .feature-toggle-header
            div
              h5.feature-toggle-title
                | Habilitar sobreturnos
              p.feature-toggle-text
                | Permite reservar espacios adicionales fuera de la agenda regular.
            .form-check.form-switch.m-0
              input.form-check-input.big-switch(type="checkbox" id="permiteSobreturnos" name="permiteSobreturnos")

          //- Panel desplegable de días, rango horario y cupo máximo de sobreturnos
          #configSobreturnos.feature-settings
            .mb-4
              label.prof-field-label
                | Días habilitados para sobreturnos
              .days-panel
                .days-grid
                  each dia in diasSemana
                    .day-option
                      input.day-checkbox(type="checkbox" id=`sob-${dia.id}` name="diasSobreturnos" value=dia.nombre)
                      label.day-label(for=`sob-${dia.id}`)
                        = dia.nombre

            .row.g-4
              .col-md-4
                label.prof-field-label(for="horaInicioSobreturnos")
                  | Hora de inicio
                input.form-control.prof-control(type="time" id="horaInicioSobreturnos" name="horaInicioSobreturnos" value="12:00")

              .col-md-4
                label.prof-field-label(for="horaFinSobreturnos")
                  | Hora de finalización
                input.form-control.prof-control(type="time" id="horaFinSobreturnos" name="horaFinSobreturnos" value="13:00")

              .col-md-4
                label.prof-field-label(for="cantidadMaximaSobreturnos")
                  | Cantidad máxima
                input.form-control.prof-control(type="number" id="cantidadMaximaSobreturnos" name="cantidadMaximaSobreturnos" min="1" max="8" value="4")
                .prof-help
                  | El sistema admite hasta 8.

      //- --------------------------------------------------------
      //- PASO 5: CONFIGURACIÓN DE TELEMEDICINA (OPCIONAL)
      //- --------------------------------------------------------
      .prof-form-section
        .prof-section-header
          .prof-section-icon
            | 💻
          div
            .prof-section-label
              | Paso 5
            h4.prof-section-title
              | Configuración de telemedicina

        .feature-toggle
          .feature-toggle-header
            div
              h5.feature-toggle-title
                | Ofrece videoconsultas
              p.feature-toggle-text
                | Habilita una agenda específica para atención remota.
            .form-check.form-switch.m-0
              input.form-check-input.big-switch(type="checkbox" id="ofreceTelemedicina" name="ofreceTelemedicina")

          //- Panel desplegable de días y franja horaria para videoconsultas
          #configTelemedicina.feature-settings
            .mb-4
              label.prof-field-label
                | Días habilitados para telemedicina
              .days-panel
                .days-grid
                  each dia in diasSemana
                    .day-option
                      input.day-checkbox(type="checkbox" id=`tele-${dia.id}` name="diasTelemedicina" value=dia.nombre)
                      label.day-label(for=`tele-${dia.id}`)
                        = dia.nombre

            .row.g-4
              .col-md-6
                label.prof-field-label(for="horaInicioTelemedicina")
                  | Hora de inicio
                input.form-control.prof-control(type="time" id="horaInicioTelemedicina" name="horaInicioTelemedicina" value="16:00")

              .col-md-6
                label.prof-field-label(for="horaFinTelemedicina")
                  | Hora de finalización
                input.form-control.prof-control(type="time" id="horaFinTelemedicina" name="horaFinTelemedicina" value="18:00")

            .configuration-info
              | 💻 Los días y horarios de telemedicina se almacenan
              | independientemente de la agenda presencial regular.

      //- Botones inferiores de acción
      .prof-form-actions
        a.prof-cancel-btn(href="/profesionales")
          | Cancelar
        button.prof-save-btn(type="submit" id="btnGuardarProfesional")
          span#iconGuardarProfesional
            | ✓
          span#textoGuardarProfesional
            | Registrar profesional


  //- ============================================================
  //- 5. SCRIPT CLIENT-SIDE: PANELES DINÁMICOS Y VALIDACIÓN
  //- ============================================================

  script.
    document.addEventListener('DOMContentLoaded', function () {
      // Capturo las referencias del formulario, los switches y los campos horarios
      const formulario = document.getElementById('formNuevoProfesional');
      const permiteSobreturnos = document.getElementById('permiteSobreturnos');
      const configSobreturnos = document.getElementById('configSobreturnos');
      const ofreceTelemedicina = document.getElementById('ofreceTelemedicina');
      const configTelemedicina = document.getElementById('configTelemedicina');
      const horaInicio = document.getElementById('horaInicio');
      const horaFin = document.getElementById('horaFin');
      const botonGuardar = document.getElementById('btnGuardarProfesional');
      const textoGuardar = document.getElementById('textoGuardarProfesional');
      const iconoGuardar = document.getElementById('iconGuardarProfesional');

      // Muestro u oculto la configuración de sobreturnos según el switch
      function actualizarSobreturnos() {
        if (!permiteSobreturnos || !configSobreturnos) {
          return;
        }
        if (permiteSobreturnos.checked) {
          configSobreturnos.classList.add('active');
        } else {
          configSobreturnos.classList.remove('active');
        }
      }

      // Muestro u oculto la configuración de telemedicina según el switch
      function actualizarTelemedicina() {
        if (!ofreceTelemedicina || !configTelemedicina) {
          return;
        }
        if (ofreceTelemedicina.checked) {
          configTelemedicina.classList.add('active');
        } else {
          configTelemedicina.classList.remove('active');
        }
      }

      if (permiteSobreturnos) {
        permiteSobreturnos.addEventListener('change', actualizarSobreturnos);
      }

      if (ofreceTelemedicina) {
        ofreceTelemedicina.addEventListener('change', actualizarTelemedicina);
      }

      // Sincronizo el estado inicial de ambos paneles al cargar la página
      actualizarSobreturnos();
      actualizarTelemedicina();

      // Valido días, rangos horarios y bloqueo el botón al enviar
      if (formulario) {
        formulario.addEventListener('submit', function (event) {
          const diasRegulares = document.querySelectorAll('.dia-regular:checked');
          if (diasRegulares.length === 0) {
            event.preventDefault();
            window.alert('Seleccioná al menos un día de atención regular.');
            return;
          }

          if (horaInicio && horaFin && horaInicio.value && horaFin.value && horaInicio.value >= horaFin.value) {
            event.preventDefault();
            window.alert('La hora de finalización debe ser posterior a la hora de inicio.');
            return;
          }

          if (permiteSobreturnos && permiteSobreturnos.checked) {
            const diasSob = document.querySelectorAll('input[name="diasSobreturnos"]:checked');
            if (diasSob.length === 0) {
              event.preventDefault();
              window.alert('Seleccioná al menos un día para los sobreturnos.');
              return;
            }
          }

          if (ofreceTelemedicina && ofreceTelemedicina.checked) {
            const diasTele = document.querySelectorAll('input[name="diasTelemedicina"]:checked');
            if (diasTele.length === 0) {
              event.preventDefault();
              window.alert('Seleccioná al menos un día para telemedicina.');
              return;
            }
          }

          if (!formulario.checkValidity()) {
            return;
          }

          // Evito envíos duplicados mostrando estado de carga en el botón
          if (botonGuardar) {
            botonGuardar.disabled = true;
          }
          if (iconoGuardar) {
            iconoGuardar.textContent = '◷';
          }
          if (textoGuardar) {
            textoGuardar.textContent = 'Registrando profesional...';
          }
        });
      }
    });